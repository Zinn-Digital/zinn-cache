msgstr ""
"Project-Id-Version: zinn-cache\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: hi_IN\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: zinn-cache\n"

msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) फुल-पेज कैश के लिए सर्वर-साइड कैश नियंत्रण — कंटेंट बदलने पर स्मार्ट स्वतः-पर्ज, Redis ऑब्जेक्ट-कैश टॉगल, और सुरक्षित WordPress/WooCommerce कैश अपवादों के साथ। Zinn Digital होस्टिंग-प्लेटफ़ॉर्म डिप्लॉय फ़ुटप्रिंट का हिस्सा।"

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "आपको कैश पर्ज करने की अनुमति नहीं है।"

msgid "Cache purge requested."
msgstr "कैश पर्ज का अनुरोध किया गया।"

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: एक अन्य ऑब्जेक्ट-कैश ड्रॉप-इन इंस्टॉल है, इसलिए Redis ऑब्जेक्ट कैश इस प्लगइन द्वारा प्रबंधित नहीं किया जाता।"

msgid "Full-page cache (LiteSpeed)"
msgstr "फुल-पेज कैश (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache नियंत्रण सक्षम करें"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "कैश-योग्य पेजों पर LiteSpeed कैश-कंट्रोल और टैग हेडर भेजें।"

msgid "Public cache lifetime (seconds)"
msgstr "सार्वजनिक कैश अवधि (सेकंड)"

msgid "Object cache (Redis)"
msgstr "ऑब्जेक्ट कैश (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis ऑब्जेक्ट कैश सक्षम करें"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis ऑब्जेक्ट-कैश ड्रॉप-इन इंस्टॉल करें (phpredis एक्सटेंशन आवश्यक है)।"

msgid "Redis host"
msgstr "Redis होस्ट"

msgid "Redis port"
msgstr "Redis पोर्ट"

msgid "Redis database"
msgstr "Redis डेटाबेस"

msgid "Redis key prefix"
msgstr "Redis की उपसर्ग"

msgid "Automatic purging"
msgstr "स्वचालित पर्जिंग"

msgid "Smart auto-purge"
msgstr "स्मार्ट स्वतः-पर्ज"

msgid "Purge affected pages automatically when content changes."
msgstr "कंटेंट बदलने पर प्रभावित पेजों को स्वचालित रूप से पर्ज करें।"

msgid "Purge on updates"
msgstr "अपडेट पर पर्ज करें"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "कोर, प्लगइन या थीम अपडेट के बाद सब कुछ पर्ज करें।"

msgid "Cache exclusions"
msgstr "कैश अपवाद"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "समझदारीपूर्ण WordPress और WooCommerce डिफ़ॉल्ट हमेशा लागू होते हैं (कार्ट, चेकआउट, my-account, लॉग-इन और सेशन पेज कभी कैश नहीं होते)। नीचे अतिरिक्त नियम जोड़ें, प्रति पंक्ति एक।"

msgid "Exclude URL paths (prefix match)"
msgstr "URL पथ बाहर रखें (उपसर्ग मिलान)"

msgid "Exclude query keys"
msgstr "क्वेरी की बाहर रखें"

msgid "Exclude cookie name prefixes"
msgstr "कुकी नाम उपसर्ग बाहर रखें"

msgid "Maintenance"
msgstr "रखरखाव"

msgid "Purge everything now"
msgstr "अभी सब कुछ पर्ज करें"

msgid "detected"
msgstr "पता चला"

msgid "not detected"
msgstr "पता नहीं चला"

msgid "phpredis extension missing"
msgstr "phpredis एक्सटेंशन अनुपलब्ध"

msgid "active"
msgstr "सक्रिय"

msgid "inactive"
msgstr "निष्क्रिय"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed कैश:"

msgid "Redis object cache:"
msgstr "Redis ऑब्जेक्ट कैश:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "इस सर्वर पर Redis PHP एक्सटेंशन (phpredis) उपलब्ध नहीं है, इसलिए ऑब्जेक्ट कैश सक्षम नहीं किया जा सकता।"

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "एक अन्य ऑब्जेक्ट-कैश ड्रॉप-इन पहले से इंस्टॉल है। Zinn ऑब्जेक्ट कैश सक्षम करने से पहले उसे हटाएँ।"

msgid "Could not write the Redis connection configuration file."
msgstr "Redis कनेक्शन कॉन्फ़िगरेशन फ़ाइल नहीं लिखी जा सकी।"

msgid "The bundled object-cache drop-in could not be read."
msgstr "बंडल किया गया ऑब्जेक्ट-कैश ड्रॉप-इन पढ़ा नहीं जा सका।"

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ऑब्जेक्ट-कैश ड्रॉप-इन को wp-content में इंस्टॉल नहीं किया जा सका।"

msgid "Could not remove the object-cache drop-in."
msgstr "ऑब्जेक्ट-कैश ड्रॉप-इन को हटाया नहीं जा सका।"

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress फ़ाइल-सिस्टम लिखने योग्य नहीं है, इसलिए ऑब्जेक्ट-कैश ड्रॉप-इन प्रबंधित नहीं किया जा सका।"

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital रिलीज़ नोट्स देखें।"

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "डाउनलोड किया गया अपडेट अपनी अखंडता जाँच में विफल रहा और इंस्टॉल नहीं किया गया।"
