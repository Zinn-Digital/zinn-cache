msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "בקרת מטמון בצד השרת עבור מטמון העמוד המלא של LiteSpeed (LSCache) — עם ניקוי אוטומטי חכם בעת שינוי תוכן, מתג להפעלת מטמון אובייקטים של Redis, וחריגות מטמון בטוחות ל-WordPress/WooCommerce. חלק מטביעת הרגל של פלטפורמת האחסון של Zinn Digital."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — מנכ\"ל, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "אינך רשאי לנקות את המטמון."

msgid "Cache purge requested."
msgstr "התקבלה בקשה לניקוי המטמון."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: מותקן תוסף drop-in אחר של מטמון אובייקטים, לכן מטמון האובייקטים של Redis אינו מנוהל על ידי תוסף זה."

msgid "Full-page cache (LiteSpeed)"
msgstr "מטמון עמוד מלא (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "הפעל בקרת LSCache"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "שלח כותרות בקרת מטמון ותגיות של LiteSpeed בעמודים ניתנים למטמון."

msgid "Public cache lifetime (seconds)"
msgstr "משך חיי מטמון ציבורי (שניות)"

msgid "Object cache (Redis)"
msgstr "מטמון אובייקטים (Redis)"

msgid "Enable Redis object cache"
msgstr "הפעל מטמון אובייקטים של Redis"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "התקן את תוסף ה-drop-in של מטמון אובייקטים של Redis (דורש את הרחבת phpredis)."

msgid "Redis host"
msgstr "מארח Redis"

msgid "Redis port"
msgstr "פורט Redis"

msgid "Redis database"
msgstr "מסד נתונים של Redis"

msgid "Redis key prefix"
msgstr "קידומת מפתח של Redis"

msgid "Automatic purging"
msgstr "ניקוי אוטומטי"

msgid "Smart auto-purge"
msgstr "ניקוי אוטומטי חכם"

msgid "Purge affected pages automatically when content changes."
msgstr "נקה עמודים מושפעים באופן אוטומטי בעת שינוי תוכן."

msgid "Purge on updates"
msgstr "ניקוי בעת עדכונים"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "נקה את הכל לאחר עדכוני ליבה, תוספים או תבניות."

msgid "Cache exclusions"
msgstr "חריגות מטמון"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "ברירות מחדל הגיוניות של WordPress ו-WooCommerce מוחלות תמיד (עגלת קניות, קופה, החשבון שלי, עמודי משתמשים מחוברים ועמודי הפעלה לעולם אינם נשמרים במטמון). הוסף כללים נוספים למטה, כלל אחד בכל שורה."

msgid "Exclude URL paths (prefix match)"
msgstr "החרג נתיבי כתובת URL (התאמת קידומת)"

msgid "Exclude query keys"
msgstr "החרג מפתחות שאילתה"

msgid "Exclude cookie name prefixes"
msgstr "החרג קידומות של שמות עוגיות"

msgid "Maintenance"
msgstr "תחזוקה"

msgid "Purge everything now"
msgstr "נקה את הכל עכשיו"

msgid "detected"
msgstr "זוהה"

msgid "not detected"
msgstr "לא זוהה"

msgid "phpredis extension missing"
msgstr "הרחבת phpredis חסרה"

msgid "active"
msgstr "פעיל"

msgid "inactive"
msgstr "לא פעיל"

msgid "LiteSpeed cache:"
msgstr "מטמון LiteSpeed:"

msgid "Redis object cache:"
msgstr "מטמון אובייקטים של Redis:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "הרחבת ה-PHP של Redis (phpredis) אינה זמינה בשרת זה, ולכן לא ניתן להפעיל את מטמון האובייקטים."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "כבר מותקן תוסף drop-in אחר של מטמון אובייקטים. הסר אותו לפני הפעלת מטמון האובייקטים של Zinn."

msgid "Could not write the Redis connection configuration file."
msgstr "לא ניתן היה לכתוב את קובץ תצורת החיבור של Redis."

msgid "The bundled object-cache drop-in could not be read."
msgstr "לא ניתן היה לקרוא את תוסף ה-drop-in המצורף של מטמון האובייקטים."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "לא ניתן היה להתקין את תוסף ה-drop-in של מטמון האובייקטים לתוך wp-content."

msgid "Could not remove the object-cache drop-in."
msgstr "לא ניתן היה להסיר את תוסף ה-drop-in של מטמון האובייקטים."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "מערכת הקבצים של WordPress אינה ניתנת לכתיבה, ולכן לא ניתן היה לנהל את תוסף ה-drop-in של מטמון האובייקטים."

msgid "See the Zinn Digital release notes."
msgstr "עיין בהערות השחרור של Zinn Digital."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "העדכון שהורד נכשל בבדיקת התקינות ולא הותקן."
