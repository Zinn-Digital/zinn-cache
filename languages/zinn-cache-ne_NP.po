msgstr ""
"Project-Id-Version: zinn-cache\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ne_NP\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: zinn-cache\n"

msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) फुल-पेज क्यासका लागि सर्भर-साइड क्यास नियन्त्रण — सामग्री परिवर्तन हुँदा स्मार्ट स्वतः-पर्ज, Redis अब्जेक्ट-क्यास टगल, र सुरक्षित WordPress/WooCommerce क्यास बहिष्करणसहित। Zinn Digital होस्टिङ-प्लेटफर्म डिप्लोय फुटप्रिन्टको अंश।"

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "तपाईंलाई क्यास पर्ज गर्ने अनुमति छैन।"

msgid "Cache purge requested."
msgstr "क्यास पर्ज अनुरोध गरियो।"

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: अर्को अब्जेक्ट-क्यास ड्रप-इन स्थापना गरिएको छ, त्यसैले Redis अब्जेक्ट क्यास यस प्लगिनद्वारा व्यवस्थापन गरिँदैन।"

msgid "Full-page cache (LiteSpeed)"
msgstr "फुल-पेज क्यास (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache नियन्त्रण सक्षम गर्नुहोस्"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "क्यास गर्न मिल्ने पृष्ठहरूमा LiteSpeed क्यास-नियन्त्रण र ट्याग हेडरहरू पठाउनुहोस्।"

msgid "Public cache lifetime (seconds)"
msgstr "सार्वजनिक क्यास अवधि (सेकेन्ड)"

msgid "Object cache (Redis)"
msgstr "अब्जेक्ट क्यास (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis अब्जेक्ट क्यास सक्षम गर्नुहोस्"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis अब्जेक्ट-क्यास ड्रप-इन स्थापना गर्नुहोस् (phpredis एक्सटेन्सन आवश्यक पर्छ)।"

msgid "Redis host"
msgstr "Redis होस्ट"

msgid "Redis port"
msgstr "Redis पोर्ट"

msgid "Redis database"
msgstr "Redis डाटाबेस"

msgid "Redis key prefix"
msgstr "Redis की उपसर्ग"

msgid "Automatic purging"
msgstr "स्वचालित पर्जिङ"

msgid "Smart auto-purge"
msgstr "स्मार्ट स्वतः-पर्ज"

msgid "Purge affected pages automatically when content changes."
msgstr "सामग्री परिवर्तन हुँदा प्रभावित पृष्ठहरू स्वचालित रूपमा पर्ज गर्नुहोस्।"

msgid "Purge on updates"
msgstr "अपडेटमा पर्ज गर्नुहोस्"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "कोर, प्लगिन, वा थिम अपडेटपछि सबै कुरा पर्ज गर्नुहोस्।"

msgid "Cache exclusions"
msgstr "क्यास बहिष्करणहरू"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "उपयुक्त WordPress र WooCommerce पूर्वनिर्धारितहरू सधैं लागू हुन्छन् (कार्ट, चेकआउट, माइ-अकाउन्ट, लग-इन र सेसन पृष्ठहरू कहिल्यै क्यास हुँदैनन्)। तल थप नियमहरू थप्नुहोस्, प्रति लाइन एउटा।"

msgid "Exclude URL paths (prefix match)"
msgstr "URL पथहरू बहिष्कृत गर्नुहोस् (उपसर्ग मिलान)"

msgid "Exclude query keys"
msgstr "क्वेरी कीहरू बहिष्कृत गर्नुहोस्"

msgid "Exclude cookie name prefixes"
msgstr "कुकी नाम उपसर्गहरू बहिष्कृत गर्नुहोस्"

msgid "Maintenance"
msgstr "मर्मतसम्भार"

msgid "Purge everything now"
msgstr "अहिले नै सबै कुरा पर्ज गर्नुहोस्"

msgid "detected"
msgstr "पत्ता लाग्यो"

msgid "not detected"
msgstr "पत्ता लागेन"

msgid "phpredis extension missing"
msgstr "phpredis एक्सटेन्सन छैन"

msgid "active"
msgstr "सक्रिय"

msgid "inactive"
msgstr "निष्क्रिय"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed क्यास:"

msgid "Redis object cache:"
msgstr "Redis अब्जेक्ट क्यास:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis PHP एक्सटेन्सन (phpredis) यस सर्भरमा उपलब्ध छैन, त्यसैले अब्जेक्ट क्यास सक्षम गर्न सकिँदैन।"

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "अर्को अब्जेक्ट-क्यास ड्रप-इन पहिले नै स्थापना गरिएको छ। Zinn अब्जेक्ट क्यास सक्षम गर्नुअघि यसलाई हटाउनुहोस्।"

msgid "Could not write the Redis connection configuration file."
msgstr "Redis जडान कन्फिगरेसन फाइल लेख्न सकिएन।"

msgid "The bundled object-cache drop-in could not be read."
msgstr "बन्डल गरिएको अब्जेक्ट-क्यास ड्रप-इन पढ्न सकिएन।"

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "अब्जेक्ट-क्यास ड्रप-इन wp-content मा स्थापना गर्न सकिएन।"

msgid "Could not remove the object-cache drop-in."
msgstr "अब्जेक्ट-क्यास ड्रप-इन हटाउन सकिएन।"

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress फाइलसिस्टम लेख्नयोग्य छैन, त्यसैले अब्जेक्ट-क्यास ड्रप-इन व्यवस्थापन गर्न सकिएन।"

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital रिलिज नोटहरू हेर्नुहोस्।"

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "डाउनलोड गरिएको अपडेट यसको अखण्डता जाँचमा असफल भयो र स्थापना गरिएन।"
