msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "ການຄວບຄຸມແຄສຝັ່ງເຊີບເວີສຳລັບແຄສໜ້າເຕັມ LiteSpeed (LSCache) — ພ້ອມການລ້າງແຄສອັດຕະໂນມັດແບບສະຫຼາດເມື່ອເນື້ອຫາປ່ຽນແປງ, ປຸ່ມເປີດ/ປິດແຄສອັອບເຈັກ Redis, ແລະ ການຍົກເວັ້ນແຄສທີ່ປອດໄພສຳລັບ WordPress/WooCommerce. ເປັນສ່ວນໜຶ່ງຂອງ deploy footprint ຂອງແພລດຟອມໂຮສຕິ້ງ Zinn Digital."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ລ້າງແຄສ."

msgid "Cache purge requested."
msgstr "ໄດ້ຮ້ອງຂໍການລ້າງແຄສແລ້ວ."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: ມີ object-cache drop-in ອື່ນຕິດຕັ້ງຢູ່, ສະນັ້ນແຄສອັອບເຈັກ Redis ຈຶ່ງບໍ່ໄດ້ຖືກຈັດການໂດຍປລັກອິນນີ້."

msgid "Full-page cache (LiteSpeed)"
msgstr "ແຄສໜ້າເຕັມ (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "ເປີດໃຊ້ການຄວບຄຸມ LSCache"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "ສົ່ງ header cache-control ແລະ tag ຂອງ LiteSpeed ໃນໜ້າທີ່ສາມາດແຄສໄດ້."

msgid "Public cache lifetime (seconds)"
msgstr "ອາຍຸແຄສສາທາລະນະ (ວິນາທີ)"

msgid "Object cache (Redis)"
msgstr "ແຄສອັອບເຈັກ (Redis)"

msgid "Enable Redis object cache"
msgstr "ເປີດໃຊ້ແຄສອັອບເຈັກ Redis"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "ຕິດຕັ້ງ object-cache drop-in ຂອງ Redis (ຕ້ອງການ extension phpredis)."

msgid "Redis host"
msgstr "ໂຮສ Redis"

msgid "Redis port"
msgstr "ພອດ Redis"

msgid "Redis database"
msgstr "ຖານຂໍ້ມູນ Redis"

msgid "Redis key prefix"
msgstr "ຄຳນຳໜ້າຄີ Redis"

msgid "Automatic purging"
msgstr "ການລ້າງແຄສອັດຕະໂນມັດ"

msgid "Smart auto-purge"
msgstr "ການລ້າງແຄສອັດຕະໂນມັດແບບສະຫຼາດ"

msgid "Purge affected pages automatically when content changes."
msgstr "ລ້າງໜ້າທີ່ໄດ້ຮັບຜົນກະທົບໂດຍອັດຕະໂນມັດເມື່ອເນື້ອຫາປ່ຽນແປງ."

msgid "Purge on updates"
msgstr "ລ້າງເມື່ອມີການອັບເດດ"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "ລ້າງທຸກຢ່າງຫຼັງຈາກການອັບເດດຄໍ, ປລັກອິນ, ຫຼື ທີມ."

msgid "Cache exclusions"
msgstr "ການຍົກເວັ້ນແຄສ"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "ຄ່າເລີ່ມຕົ້ນທີ່ເໝາະສົມຂອງ WordPress ແລະ WooCommerce ຈະຖືກນຳໃຊ້ສະເໝີ (ໜ້າກະຕ່າ, ຊຳລະເງິນ, my-account, ໜ້າທີ່ເຂົ້າສູ່ລະບົບແລ້ວ ແລະ ໜ້າ session ຈະບໍ່ຖືກແຄສ). ເພີ່ມກົດເພີ່ມເຕີມຢູ່ດ້ານລຸ່ມ, ໜຶ່ງແຖວຕໍ່ໜຶ່ງກົດ."

msgid "Exclude URL paths (prefix match)"
msgstr "ຍົກເວັ້ນເສັ້ນທາງ URL (ຈັບຄູ່ຄຳນຳໜ້າ)"

msgid "Exclude query keys"
msgstr "ຍົກເວັ້ນຄີ query"

msgid "Exclude cookie name prefixes"
msgstr "ຍົກເວັ້ນຄຳນຳໜ້າຊື່ຄຸກກີ້"

msgid "Maintenance"
msgstr "ການບຳລຸງຮັກສາ"

msgid "Purge everything now"
msgstr "ລ້າງທຸກຢ່າງດຽວນີ້"

msgid "detected"
msgstr "ກວດພົບ"

msgid "not detected"
msgstr "ບໍ່ພົບ"

msgid "phpredis extension missing"
msgstr "ບໍ່ມີ extension phpredis"

msgid "active"
msgstr "ເປີດໃຊ້ງານ"

msgid "inactive"
msgstr "ບໍ່ເປີດໃຊ້ງານ"

msgid "LiteSpeed cache:"
msgstr "ແຄສ LiteSpeed:"

msgid "Redis object cache:"
msgstr "ແຄສອັອບເຈັກ Redis:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "extension PHP ຂອງ Redis (phpredis) ບໍ່ມີໃນເຊີບເວີນີ້, ສະນັ້ນຈຶ່ງບໍ່ສາມາດເປີດໃຊ້ແຄສອັອບເຈັກໄດ້."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "ມີ object-cache drop-in ອື່ນຕິດຕັ້ງຢູ່ແລ້ວ. ກະລຸນາລົບອອກກ່ອນເປີດໃຊ້ແຄສອັອບເຈັກ Zinn."

msgid "Could not write the Redis connection configuration file."
msgstr "ບໍ່ສາມາດຂຽນໄຟລ໌ການຕັ້ງຄ່າການເຊື່ອມຕໍ່ Redis ໄດ້."

msgid "The bundled object-cache drop-in could not be read."
msgstr "ບໍ່ສາມາດອ່ານ object-cache drop-in ທີ່ມາພ້ອມກັນໄດ້."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ບໍ່ສາມາດຕິດຕັ້ງ object-cache drop-in ເຂົ້າໃນ wp-content ໄດ້."

msgid "Could not remove the object-cache drop-in."
msgstr "ບໍ່ສາມາດລົບ object-cache drop-in ໄດ້."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "ລະບົບໄຟລ໌ຂອງ WordPress ບໍ່ສາມາດຂຽນໄດ້, ສະນັ້ນຈຶ່ງບໍ່ສາມາດຈັດການ object-cache drop-in ໄດ້."

msgid "See the Zinn Digital release notes."
msgstr "ເບິ່ງບັນທຶກການອອກເວີຊັນຂອງ Zinn Digital."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ການອັບເດດທີ່ດາວໂຫຼດມາບໍ່ຜ່ານການກວດສອບຄວາມຖືກຕ້ອງ ຈຶ່ງບໍ່ໄດ້ຖືກຕິດຕັ້ງ."
