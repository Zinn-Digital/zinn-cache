#: includes/class-zinn-cache-admin-ui.php:995
msgid "Import"
msgstr "ນຳເຂົ້າ"

#: includes/class-zinn-cache-admin-ui.php:997
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "ໄຟລ໌ທີ່ສົ່ງອອກຈະບໍ່ມີລະຫັດຜ່ານ, ໂທເຄນ ຫຼື ລະຫັດ API ຢ່າງເດັດຂາດ — ທ່ານຈຳເປັນຕ້ອງໃສ່ຂໍ້ມູນເຫຼົ່ານັ້ນຄືນໃໝ່ໃນເວັບໄຊໃໝ່."

#: includes/class-zinn-cache-admin-ui.php:1096
msgid "Settings saved."
msgstr "ບັນທຶກການຕັ້ງຄ່າແລ້ວ."

#: includes/class-zinn-cache-admin-ui.php:1143
msgid "Every setting on this plugin is back to its default."
msgstr "ທຸກໆການຕັ້ງຄ່າໃນປລັກອິນນີ້ແມ່ນກັບຄືນສູ່ຄ່າເລີ່ມຕົ້ນຂອງມັນແລ້ວ."

#: includes/class-zinn-cache-admin-ui.php:1186
msgid "Done."
msgstr "ສຳເລັດແລ້ວ."

#: includes/class-zinn-cache-admin-ui.php:1190
msgid "That action is not available."
msgstr "ການດຳເນີນການນັ້ນບໍ່ສາມາດໃຊ້ງານໄດ້."

#: includes/class-zinn-cache-admin-ui.php:1257
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "ບໍ່ສາມາດອ່ານໄຟລ໌ນັ້ນໄດ້. ກະລຸນາເລືອກໄຟລ໌ການຕັ້ງຄ່າທີ່ສົ່ງອອກມາຈາກປລັກອິນ Zinn®."

#: includes/class-zinn-cache-admin-ui.php:1265
msgid "That file is too large to be a settings export."
msgstr "ໄຟລ໌ນັ້ນມີຂະໜາດໃຫຍ່ເກີນໄປທີ່ຈະເປັນການສົ່ງອອກການຕັ້ງຄ່າ."

#: includes/class-zinn-cache-admin-ui.php:1278
msgid "That file is not a Zinn® settings export."
msgstr "ໄຟລ໌ນັ້ນບໍ່ແມ່ນການສົ່ງອອກການຕັ້ງຄ່າ Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-cache-admin-ui.php:1286
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "ໄຟລ໌ນັ້ນຖືກສົ່ງອອກມາຈາກປລັກອິນອື່ນ (%s), ດັ່ງນັ້ນການນຳເຂົ້າໄຟລ໌ຢູ່ທີ່ນີ້ຈະບັນທຶກການຕັ້ງຄ່າທີ່ປລັກອິນນີ້ບໍ່ເຂົ້າໃຈ."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-cache-admin-ui.php:1316
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "ໄດ້ນຳເຂົ້າ %d ການຕັ້ງຄ່າແລ້ວ. ລະຫັດຜ່ານ ແລະ API keys ບໍ່ເຄີຍຖືກລວມຢູ່ໃນການສົ່ງອອກ, ດັ່ງນັ້ນກະລຸນາໃສ່ພວກມັນຄືນໃໝ່."

