msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "Kontrol ng server-side cache para sa LiteSpeed (LSCache) na full-page cache — may matalinong awtomatikong pag-purge kapag nagbago ang nilalaman, isang toggle para sa Redis object cache, at ligtas na mga eksklusyon sa cache para sa WordPress/WooCommerce. Bahagi ng deploy footprint ng hosting platform ng Zinn Digital."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "Hindi ka pinapayagang i-purge ang cache."

msgid "Cache purge requested."
msgstr "Hiniling ang pag-purge ng cache."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: may iba nang naka-install na object-cache drop-in, kaya hindi pinamamahalaan ng plugin na ito ang Redis object cache."

msgid "Full-page cache (LiteSpeed)"
msgstr "Full-page cache (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "Paganahin ang kontrol ng LSCache"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "Ipadala ang cache-control at tag headers ng LiteSpeed sa mga pahinang maaaring i-cache."

msgid "Public cache lifetime (seconds)"
msgstr "Habang-buhay ng pampublikong cache (mga segundo)"

msgid "Object cache (Redis)"
msgstr "Object cache (Redis)"

msgid "Enable Redis object cache"
msgstr "Paganahin ang Redis object cache"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "I-install ang Redis object-cache drop-in (nangangailangan ng phpredis extension)."

msgid "Redis host"
msgstr "Redis host"

msgid "Redis port"
msgstr "Redis port"

msgid "Redis database"
msgstr "Redis database"

msgid "Redis key prefix"
msgstr "Prefix ng Redis key"

msgid "Automatic purging"
msgstr "Awtomatikong pag-purge"

msgid "Smart auto-purge"
msgstr "Matalinong awtomatikong pag-purge"

msgid "Purge affected pages automatically when content changes."
msgstr "Awtomatikong i-purge ang mga apektadong pahina kapag nagbago ang nilalaman."

msgid "Purge on updates"
msgstr "Pag-purge kapag may update"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "I-purge ang lahat pagkatapos ng mga update sa core, plugin, o tema."

msgid "Cache exclusions"
msgstr "Mga eksklusyon sa cache"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "Palaging inilalapat ang makatwirang mga default para sa WordPress at WooCommerce (hindi kailanman ni-cache ang cart, checkout, my-account, mga naka-login at mga session na pahina). Magdagdag ng karagdagang mga panuntunan sa ibaba, isa bawat linya."

msgid "Exclude URL paths (prefix match)"
msgstr "Ibukod ang mga URL path (pagtutugma ng prefix)"

msgid "Exclude query keys"
msgstr "Ibukod ang mga query key"

msgid "Exclude cookie name prefixes"
msgstr "Ibukod ang mga prefix ng pangalan ng cookie"

msgid "Maintenance"
msgstr "Pagpapanatili"

msgid "Purge everything now"
msgstr "I-purge ang lahat ngayon"

msgid "detected"
msgstr "natukoy"

msgid "not detected"
msgstr "hindi natukoy"

msgid "phpredis extension missing"
msgstr "nawawala ang phpredis extension"

msgid "active"
msgstr "aktibo"

msgid "inactive"
msgstr "hindi aktibo"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed cache:"

msgid "Redis object cache:"
msgstr "Redis object cache:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Hindi available ang Redis PHP extension (phpredis) sa server na ito, kaya hindi mapapagana ang object cache."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "May iba nang naka-install na object-cache drop-in. Alisin ito bago paganahin ang Zinn object cache."

msgid "Could not write the Redis connection configuration file."
msgstr "Hindi maisulat ang configuration file ng koneksyon sa Redis."

msgid "The bundled object-cache drop-in could not be read."
msgstr "Hindi mabasa ang kalakip na object-cache drop-in."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Hindi ma-install ang object-cache drop-in sa wp-content."

msgid "Could not remove the object-cache drop-in."
msgstr "Hindi maalis ang object-cache drop-in."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "Hindi masusulatan ang WordPress filesystem, kaya hindi mapamahalaan ang object-cache drop-in."

msgid "See the Zinn Digital release notes."
msgstr "Tingnan ang mga release note ng Zinn Digital."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Nabigo ang na-download na update sa pagsusuri ng integridad nito, kaya hindi ito na-install."
