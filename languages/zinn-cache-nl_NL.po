msgstr "Hiermee worden alle instellingen van deze plugin teruggezet naar de standaardwaarden. Wilt u doorgaan?"

#: includes/class-zinn-cache-admin-ui.php:984
msgid "Diagnostics for support"
msgstr "Diagnostische gegevens voor ondersteuning"

#: includes/class-zinn-cache-admin-ui.php:993
