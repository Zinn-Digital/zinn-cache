msgstr "Dat bestand kon niet worden gelezen. Kies een instellingenbestand dat is geëxporteerd vanuit een Zinn®-plugin."

#: includes/class-zinn-cache-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "Dat bestand is te groot om een instellingenexport te zijn."

#: includes/class-zinn-cache-admin-ui.php:1195
