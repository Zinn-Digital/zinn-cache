#: includes/class-zinn-cache-admin-ui.php:1286
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Dat bestand is geëxporteerd vanuit een andere plug-in (%s), dus het hier importeren zou instellingen opslaan die deze plug-in niet begrijpt."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-cache-admin-ui.php:1316
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d instelling geïmporteerd. Wachtwoorden en API-sleutels worden nooit meegeëxporteerd, voer deze dus opnieuw in."
msgstr[1] "%d instellingen geïmporteerd. Wachtwoorden en API-sleutels worden nooit meegeexporteerd, dus voer deze opnieuw in."

#: includes/class-zinn-cache-connection.php:58
