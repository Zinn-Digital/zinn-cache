"X-Domain: zinn-cache\n"

msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "Kontrola predmemorije na strani poslužitelja za LiteSpeed (LSCache) predmemoriju cijele stranice — s pametnim automatskim čišćenjem pri promjeni sadržaja, prekidačem za Redis objektnu predmemoriju i sigurnim iznimkama za WordPress/WooCommerce. Dio deploy footprinta hosting platforme Zinn Digital."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — izvršni direktor, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "Nemate dopuštenje za čišćenje predmemorije."

msgid "Cache purge requested."
msgstr "Zatraženo je čišćenje predmemorije."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: instaliran je drugi object-cache drop-in, pa ovaj dodatak ne upravlja Redis objektnom predmemorijom."

msgid "Full-page cache (LiteSpeed)"
msgstr "Predmemorija cijele stranice (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "Omogući kontrolu LSCache"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "Šalji LiteSpeed cache-control i tag zaglavlja na stranicama koje se mogu predmemorirati."

msgid "Public cache lifetime (seconds)"
msgstr "Trajanje javne predmemorije (u sekundama)"

msgid "Object cache (Redis)"
msgstr "Objektna predmemorija (Redis)"

msgid "Enable Redis object cache"
msgstr "Omogući Redis objektnu predmemoriju"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Instaliraj Redis object-cache drop-in (zahtijeva phpredis ekstenziju)."

msgid "Redis host"
msgstr "Redis poslužitelj (host)"

msgid "Redis port"
msgstr "Redis priključak (port)"

msgid "Redis database"
msgstr "Redis baza podataka"

msgid "Redis key prefix"
msgstr "Redis prefiks ključa"

msgid "Automatic purging"
msgstr "Automatsko čišćenje"

msgid "Smart auto-purge"
msgstr "Pametno automatsko čišćenje"

msgid "Purge affected pages automatically when content changes."
msgstr "Automatski očisti pogođene stranice kada se sadržaj promijeni."

msgid "Purge on updates"
msgstr "Čišćenje pri ažuriranjima"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "Očisti sve nakon ažuriranja jezgre, dodataka ili tema."

msgid "Cache exclusions"
msgstr "Iznimke predmemorije"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "Razumne zadane postavke za WordPress i WooCommerce uvijek se primjenjuju (košarica, naplata, moj račun, prijavljene stranice i stranice sa sesijom nikada se ne predmemoriraju). Dodajte dodatna pravila u nastavku, jedno po retku."

msgid "Exclude URL paths (prefix match)"
msgstr "Isključi URL putanje (podudaranje po prefiksu)"

msgid "Exclude query keys"
msgstr "Isključi ključeve upita"

msgid "Exclude cookie name prefixes"
msgstr "Isključi prefikse naziva kolačića"

msgid "Maintenance"
msgstr "Održavanje"

msgid "Purge everything now"
msgstr "Očisti sve odmah"

msgid "detected"
msgstr "otkriveno"

msgid "not detected"
msgstr "nije otkriveno"

msgid "phpredis extension missing"
msgstr "nedostaje phpredis ekstenzija"

msgid "active"
msgstr "aktivno"

msgid "inactive"
msgstr "neaktivno"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed predmemorija:"

msgid "Redis object cache:"
msgstr "Redis objektna predmemorija:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis PHP ekstenzija (phpredis) nije dostupna na ovom poslužitelju, pa se objektna predmemorija ne može omogućiti."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "Drugi object-cache drop-in već je instaliran. Uklonite ga prije omogućavanja Zinn objektne predmemorije."

msgid "Could not write the Redis connection configuration file."
msgstr "Nije bilo moguće zapisati konfiguracijsku datoteku Redis veze."

msgid "The bundled object-cache drop-in could not be read."
msgstr "Priloženi object-cache drop-in nije bilo moguće pročitati."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Nije bilo moguće instalirati object-cache drop-in u wp-content."

msgid "Could not remove the object-cache drop-in."
msgstr "Nije bilo moguće ukloniti object-cache drop-in."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress datotečni sustav nije zapisiv, pa object-cache drop-in nije bilo moguće postaviti."

msgid "See the Zinn Digital release notes."
msgstr "Pogledajte bilješke o izdanju Zinn Digital."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Preuzeto ažuriranje nije prošlo provjeru integriteta te nije instalirano."
