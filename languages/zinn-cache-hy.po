msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "Սերվերի կողմից ամբողջական էջերի քեշի կառավարում LiteSpeed-ի (LSCache) համար — բովանդակության փոփոխման դեպքում խելացի ինքնաշխատ մաքրմամբ, Redis օբյեկտների քեշի փոխարկիչով և WordPress/WooCommerce-ի քեշի անվտանգ բացառություններով։ Zinn Digital հոսթինգ-հարթակի deploy footprint-ի մասն է։"

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — Գործադիր տնօրեն, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "Դուք չունեք քեշը մաքրելու թույլտվություն։"

msgid "Cache purge requested."
msgstr "Քեշի մաքրումը պահանջված է։"

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache. տեղադրված է օբյեկտների քեշի այլ drop-in, ուստի Redis օբյեկտների քեշը չի կառավարվում այս հավելվածի կողմից։"

msgid "Full-page cache (LiteSpeed)"
msgstr "Ամբողջական էջերի քեշ (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "Միացնել LSCache-ի կառավարումը"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "Ուղարկել LiteSpeed-ի քեշի կառավարման և պիտակների վերնագրերը քեշավորելի էջերում։"

msgid "Public cache lifetime (seconds)"
msgstr "Հանրային քեշի կենսատևություն (վայրկյան)"

msgid "Object cache (Redis)"
msgstr "Օբյեկտների քեշ (Redis)"

msgid "Enable Redis object cache"
msgstr "Միացնել Redis օբյեկտների քեշը"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Տեղադրել Redis օբյեկտների քեշի drop-in-ը (պահանջում է phpredis ընդլայնումը)։"

msgid "Redis host"
msgstr "Redis-ի հոսթ"

msgid "Redis port"
msgstr "Redis-ի պորտ"

msgid "Redis database"
msgstr "Redis-ի տվյալների բազա"

msgid "Redis key prefix"
msgstr "Redis-ի բանալիների նախածանց"

msgid "Automatic purging"
msgstr "Ինքնաշխատ մաքրում"

msgid "Smart auto-purge"
msgstr "Խելացի ինքնաշխատ մաքրում"

msgid "Purge affected pages automatically when content changes."
msgstr "Բովանդակության փոփոխման դեպքում ինքնաշխատ մաքրել ազդակիր էջերը։"

msgid "Purge on updates"
msgstr "Մաքրել թարմացումների ժամանակ"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "Մաքրել ամեն ինչ միջուկի, հավելվածների կամ թեմաների թարմացումներից հետո։"

msgid "Cache exclusions"
msgstr "Քեշի բացառություններ"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "WordPress-ի և WooCommerce-ի ողջամիտ լռելյայն կարգավորումները միշտ կիրառվում են (զամբյուղը, վճարման, իմ-հաշիվ, մուտք գործած և սեսիայի էջերը երբեք չեն քեշավորվում)։ Ավելացրեք լրացուցիչ կանոններ ստորև՝ մեկ տողում մեկ կանոն։"

msgid "Exclude URL paths (prefix match)"
msgstr "Բացառել URL ուղիներ (նախածանցի համընկնում)"

msgid "Exclude query keys"
msgstr "Բացառել հարցման բանալիներ"

msgid "Exclude cookie name prefixes"
msgstr "Բացառել cookie-ի անվան նախածանցներ"

msgid "Maintenance"
msgstr "Սպասարկում"

msgid "Purge everything now"
msgstr "Մաքրել ամեն ինչ հիմա"

msgid "detected"
msgstr "հայտնաբերված է"

msgid "not detected"
msgstr "հայտնաբերված չէ"

msgid "phpredis extension missing"
msgstr "phpredis ընդլայնումը բացակայում է"

msgid "active"
msgstr "ակտիվ"

msgid "inactive"
msgstr "ոչ ակտիվ"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed քեշ."

msgid "Redis object cache:"
msgstr "Redis օբյեկտների քեշ."

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis PHP ընդլայնումը (phpredis) հասանելի չէ այս սերվերում, ուստի օբյեկտների քեշը հնարավոր չէ միացնել։"

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "Օբյեկտների քեշի այլ drop-in արդեն տեղադրված է։ Հեռացրեք այն նախքան Zinn օբյեկտների քեշը միացնելը։"

msgid "Could not write the Redis connection configuration file."
msgstr "Հնարավոր չեղավ գրել Redis-ի կապակցման կազմաձևման ֆայլը։"

msgid "The bundled object-cache drop-in could not be read."
msgstr "Կցված օբյեկտների քեշի drop-in-ը հնարավոր չեղավ կարդալ։"

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Հնարավոր չեղավ տեղադրել օբյեկտների քեշի drop-in-ը wp-content-ում։"

msgid "Could not remove the object-cache drop-in."
msgstr "Հնարավոր չեղավ հեռացնել օբյեկտների քեշի drop-in-ը։"

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress-ի ֆայլային համակարգը գրառելի չէ, ուստի օբյեկտների քեշի drop-in-ը հնարավոր չեղավ կառավարել։"

msgid "See the Zinn Digital release notes."
msgstr "Տե՛ս Zinn Digital-ի թողարկման նշումները։"

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Ներբեռնված թարմացումը չանցավ ամբողջականության ստուգումը և չտեղադրվեց։"
