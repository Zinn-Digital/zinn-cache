msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) ફુલ-પેજ કેશ માટે સર્વર-સાઇડ કેશ નિયંત્રણ — સામગ્રી બદલાય ત્યારે સ્માર્ટ ઓટો-પર્જ, Redis ઓબ્જેક્ટ-કેશ ટૉગલ અને સુરક્ષિત WordPress/WooCommerce કેશ બાકાત સાથે. Zinn Digital હોસ્ટિંગ-પ્લેટફોર્મ ડિપ્લોય ફૂટપ્રિન્ટનો ભાગ."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "તમને કેશ પર્જ કરવાની પરવાનગી નથી."

msgid "Cache purge requested."
msgstr "કેશ પર્જ કરવાની વિનંતી કરવામાં આવી."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: અન્ય ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન ઇન્સ્ટોલ કરેલ છે, તેથી Redis ઓબ્જેક્ટ કેશ આ પ્લગઇન દ્વારા વ્યવસ્થાપિત થતું નથી."

msgid "Full-page cache (LiteSpeed)"
msgstr "ફુલ-પેજ કેશ (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache નિયંત્રણ સક્ષમ કરો"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "કેશ કરી શકાય તેવા પૃષ્ઠો પર LiteSpeed કેશ-કંટ્રોલ અને ટૅગ હેડર મોકલો."

msgid "Public cache lifetime (seconds)"
msgstr "સાર્વજનિક કેશ આયુષ્ય (સેકન્ડ)"

msgid "Object cache (Redis)"
msgstr "ઓબ્જેક્ટ કેશ (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis ઓબ્જેક્ટ કેશ સક્ષમ કરો"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન ઇન્સ્ટોલ કરો (phpredis એક્સ્ટેન્શન જરૂરી છે)."

msgid "Redis host"
msgstr "Redis હોસ્ટ"

msgid "Redis port"
msgstr "Redis પોર્ટ"

msgid "Redis database"
msgstr "Redis ડેટાબેઝ"

msgid "Redis key prefix"
msgstr "Redis કી ઉપસર્ગ"

msgid "Automatic purging"
msgstr "સ્વયંસંચાલિત પર્જિંગ"

msgid "Smart auto-purge"
msgstr "સ્માર્ટ ઓટો-પર્જ"

msgid "Purge affected pages automatically when content changes."
msgstr "સામગ્રી બદલાય ત્યારે અસરગ્રસ્ત પૃષ્ઠો આપમેળે પર્જ કરો."

msgid "Purge on updates"
msgstr "અપડેટ પર પર્જ કરો"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "કોર, પ્લગઇન અથવા થીમ અપડેટ પછી બધું પર્જ કરો."

msgid "Cache exclusions"
msgstr "કેશ બાકાત"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "સમજદારીભર્યા WordPress અને WooCommerce ડિફોલ્ટ હંમેશા લાગુ કરવામાં આવે છે (કાર્ટ, ચેકઆઉટ, my-account, લૉગ-ઇન અને સેશન પૃષ્ઠો ક્યારેય કેશ થતાં નથી). નીચે વધારાના નિયમો ઉમેરો, દરેક લાઇનમાં એક."

msgid "Exclude URL paths (prefix match)"
msgstr "URL પાથ બાકાત કરો (ઉપસર્ગ મેળ)"

msgid "Exclude query keys"
msgstr "ક્વેરી કી બાકાત કરો"

msgid "Exclude cookie name prefixes"
msgstr "કૂકી નામ ઉપસર્ગ બાકાત કરો"

msgid "Maintenance"
msgstr "જાળવણી"

msgid "Purge everything now"
msgstr "હમણાં બધું પર્જ કરો"

msgid "detected"
msgstr "શોધાયું"

msgid "not detected"
msgstr "શોધાયું નથી"

msgid "phpredis extension missing"
msgstr "phpredis એક્સ્ટેન્શન ગુમ છે"

msgid "active"
msgstr "સક્રિય"

msgid "inactive"
msgstr "નિષ્ક્રિય"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed કેશ:"

msgid "Redis object cache:"
msgstr "Redis ઓબ્જેક્ટ કેશ:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "આ સર્વર પર Redis PHP એક્સ્ટેન્શન (phpredis) ઉપલબ્ધ નથી, તેથી ઓબ્જેક્ટ કેશ સક્ષમ કરી શકાતું નથી."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "અન્ય ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન પહેલેથી ઇન્સ્ટોલ કરેલ છે. Zinn ઓબ્જેક્ટ કેશ સક્ષમ કરતાં પહેલાં તેને દૂર કરો."

msgid "Could not write the Redis connection configuration file."
msgstr "Redis કનેક્શન કન્ફિગરેશન ફાઇલ લખી શકાઈ નહીં."

msgid "The bundled object-cache drop-in could not be read."
msgstr "બંડલ કરેલ ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન વાંચી શકાયું નહીં."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન wp-content માં ઇન્સ્ટોલ કરી શકાયું નહીં."

msgid "Could not remove the object-cache drop-in."
msgstr "ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન દૂર કરી શકાયું નહીં."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress ફાઇલસિસ્ટમ લખવાયોગ્ય નથી, તેથી ઓબ્જેક્ટ-કેશ ડ્રોપ-ઇન વ્યવસ્થાપિત કરી શકાયું નહીં."

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital રિલીઝ નોંધ જુઓ."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ડાઉનલોડ કરેલ અપડેટ તેની અખંડિતતા તપાસમાં નિષ્ફળ ગયું અને ઇન્સ્ટોલ કરવામાં આવ્યું ન હતું."
