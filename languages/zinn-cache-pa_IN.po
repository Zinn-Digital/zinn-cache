msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) ਫੁੱਲ-ਪੇਜ ਕੈਸ਼ ਲਈ ਸਰਵਰ-ਸਾਈਡ ਕੈਸ਼ ਕੰਟਰੋਲ — ਸਮੱਗਰੀ ਬਦਲਣ 'ਤੇ ਸਮਾਰਟ ਆਟੋ-ਪਰਜ, ਇੱਕ Redis ਆਬਜੈਕਟ-ਕੈਸ਼ ਟੌਗਲ, ਅਤੇ ਸੁਰੱਖਿਅਤ WordPress/WooCommerce ਕੈਸ਼ ਬੇਦਖਲੀਆਂ ਸਮੇਤ। Zinn Digital ਹੋਸਟਿੰਗ-ਪਲੇਟਫਾਰਮ ਡਿਪਲੌਏ ਫੁੱਟਪ੍ਰਿੰਟ ਦਾ ਹਿੱਸਾ।"

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "ਤੁਹਾਨੂੰ ਕੈਸ਼ ਪਰਜ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ।"

msgid "Cache purge requested."
msgstr "ਕੈਸ਼ ਪਰਜ ਲਈ ਬੇਨਤੀ ਕੀਤੀ ਗਈ।"

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: ਇੱਕ ਹੋਰ ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ ਇੰਸਟਾਲ ਹੈ, ਇਸ ਲਈ Redis ਆਬਜੈਕਟ ਕੈਸ਼ ਇਸ ਪਲੱਗਇਨ ਦੁਆਰਾ ਪ੍ਰਬੰਧਿਤ ਨਹੀਂ ਹੈ।"

msgid "Full-page cache (LiteSpeed)"
msgstr "ਫੁੱਲ-ਪੇਜ ਕੈਸ਼ (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache ਕੰਟਰੋਲ ਯੋਗ ਕਰੋ"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "ਕੈਸ਼ ਕਰਨ ਯੋਗ ਪੇਜਾਂ 'ਤੇ LiteSpeed ਕੈਸ਼-ਕੰਟਰੋਲ ਅਤੇ ਟੈਗ ਹੈਡਰ ਭੇਜੋ।"

msgid "Public cache lifetime (seconds)"
msgstr "ਜਨਤਕ ਕੈਸ਼ ਦੀ ਮਿਆਦ (ਸਕਿੰਟ)"

msgid "Object cache (Redis)"
msgstr "ਆਬਜੈਕਟ ਕੈਸ਼ (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis ਆਬਜੈਕਟ ਕੈਸ਼ ਯੋਗ ਕਰੋ"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ ਇੰਸਟਾਲ ਕਰੋ (phpredis ਐਕਸਟੈਂਸ਼ਨ ਦੀ ਲੋੜ ਹੈ)।"

msgid "Redis host"
msgstr "Redis ਹੋਸਟ"

msgid "Redis port"
msgstr "Redis ਪੋਰਟ"

msgid "Redis database"
msgstr "Redis ਡਾਟਾਬੇਸ"

msgid "Redis key prefix"
msgstr "Redis ਕੁੰਜੀ ਅਗੇਤਰ"

msgid "Automatic purging"
msgstr "ਆਟੋਮੈਟਿਕ ਪਰਜਿੰਗ"

msgid "Smart auto-purge"
msgstr "ਸਮਾਰਟ ਆਟੋ-ਪਰਜ"

msgid "Purge affected pages automatically when content changes."
msgstr "ਸਮੱਗਰੀ ਬਦਲਣ 'ਤੇ ਪ੍ਰਭਾਵਿਤ ਪੇਜ ਆਪਣੇ-ਆਪ ਪਰਜ ਕਰੋ।"

msgid "Purge on updates"
msgstr "ਅੱਪਡੇਟਾਂ 'ਤੇ ਪਰਜ ਕਰੋ"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "ਕੋਰ, ਪਲੱਗਇਨ, ਜਾਂ ਥੀਮ ਅੱਪਡੇਟਾਂ ਤੋਂ ਬਾਅਦ ਸਭ ਕੁਝ ਪਰਜ ਕਰੋ।"

msgid "Cache exclusions"
msgstr "ਕੈਸ਼ ਬੇਦਖਲੀਆਂ"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "ਸਮਝਦਾਰ WordPress ਅਤੇ WooCommerce ਡਿਫਾਲਟ ਹਮੇਸ਼ਾ ਲਾਗੂ ਹੁੰਦੇ ਹਨ (ਕਾਰਟ, ਚੈੱਕਆਊਟ, ਮਾਈ-ਅਕਾਊਂਟ, ਲੌਗ-ਇਨ ਕੀਤੇ ਅਤੇ ਸੈਸ਼ਨ ਪੇਜ ਕਦੇ ਕੈਸ਼ ਨਹੀਂ ਹੁੰਦੇ)। ਹੇਠਾਂ ਵਾਧੂ ਨਿਯਮ ਸ਼ਾਮਲ ਕਰੋ, ਪ੍ਰਤੀ ਲਾਈਨ ਇੱਕ।"

msgid "Exclude URL paths (prefix match)"
msgstr "URL ਪਾਥ ਬੇਦਖਲ ਕਰੋ (ਅਗੇਤਰ ਮੇਲ)"

msgid "Exclude query keys"
msgstr "ਪ੍ਰਸ਼ਨ ਕੁੰਜੀਆਂ ਬੇਦਖਲ ਕਰੋ"

msgid "Exclude cookie name prefixes"
msgstr "ਕੁਕੀ ਨਾਮ ਅਗੇਤਰ ਬੇਦਖਲ ਕਰੋ"

msgid "Maintenance"
msgstr "ਰੱਖ-ਰਖਾਅ"

msgid "Purge everything now"
msgstr "ਹੁਣ ਸਭ ਕੁਝ ਪਰਜ ਕਰੋ"

msgid "detected"
msgstr "ਪਤਾ ਲੱਗਿਆ"

msgid "not detected"
msgstr "ਪਤਾ ਨਹੀਂ ਲੱਗਿਆ"

msgid "phpredis extension missing"
msgstr "phpredis ਐਕਸਟੈਂਸ਼ਨ ਗੁੰਮ ਹੈ"

msgid "active"
msgstr "ਸਰਗਰਮ"

msgid "inactive"
msgstr "ਨਿਸ਼ਕਿਰਿਆ"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed ਕੈਸ਼:"

msgid "Redis object cache:"
msgstr "Redis ਆਬਜੈਕਟ ਕੈਸ਼:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "ਇਸ ਸਰਵਰ 'ਤੇ Redis PHP ਐਕਸਟੈਂਸ਼ਨ (phpredis) ਉਪਲਬਧ ਨਹੀਂ ਹੈ, ਇਸ ਲਈ ਆਬਜੈਕਟ ਕੈਸ਼ ਯੋਗ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "ਇੱਕ ਹੋਰ ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ ਪਹਿਲਾਂ ਹੀ ਇੰਸਟਾਲ ਹੈ। Zinn ਆਬਜੈਕਟ ਕੈਸ਼ ਯੋਗ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਇਸਨੂੰ ਹਟਾਓ।"

msgid "Could not write the Redis connection configuration file."
msgstr "Redis ਕਨੈਕਸ਼ਨ ਕੌਂਫਿਗਰੇਸ਼ਨ ਫਾਈਲ ਲਿਖੀ ਨਹੀਂ ਜਾ ਸਕੀ।"

msgid "The bundled object-cache drop-in could not be read."
msgstr "ਬੰਡਲ ਕੀਤਾ ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ wp-content ਵਿੱਚ ਇੰਸਟਾਲ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ।"

msgid "Could not remove the object-cache drop-in."
msgstr "ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ ਹਟਾਇਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress ਫਾਈਲਸਿਸਟਮ ਲਿਖਣਯੋਗ ਨਹੀਂ ਹੈ, ਇਸ ਲਈ ਆਬਜੈਕਟ-ਕੈਸ਼ ਡ੍ਰੌਪ-ਇਨ ਪ੍ਰਬੰਧਿਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ।"

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital ਰੀਲੀਜ਼ ਨੋਟਸ ਦੇਖੋ।"

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ਡਾਊਨਲੋਡ ਕੀਤਾ ਗਿਆ ਅੱਪਡੇਟ ਆਪਣੀ ਇੰਟੈਗਰਿਟੀ ਜਾਂਚ ਵਿੱਚ ਅਸਫਲ ਰਿਹਾ ਅਤੇ ਇੰਸਟਾਲ ਨਹੀਂ ਕੀਤਾ ਗਿਆ।"
