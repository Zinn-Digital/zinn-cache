#. Plugin Name of the plugin
#: zinn-cache.php
#: includes/mcp/class-abilities.php:55
msgid "Zinn® Cache"
msgstr "Zinn® Cache"

#. Plugin URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-cache"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-cache"

#. Description of the plugin
#: zinn-cache.php
msgid "A page cache and a Redis object cache for any WordPress site. Uses the LiteSpeed server cache where there is one and its own disk cache everywhere else, purges only what a change affects, and proves its Redis connection works."
msgstr "Μια προσωρινή μνήμη σελίδας και μια προσωρινή μνήμη αντικειμένων Redis για οποιονδήποτε ιστότοπο WordPress. Χρησιμοποιεί την προσωρινή μνήμη διακομιστή LiteSpeed ​​όπου υπάρχει και τη δική της προσωρινή μνήμη δίσκου παντού αλλού, εκκαθαρίζει μόνο ό,τι επηρεάζει μια αλλαγή και αποδεικνύει ότι η σύνδεση Redis λειτουργεί."

#. Author of the plugin
#: zinn-cache.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:104
msgid "Cache"
msgstr "Κρυφή μνήμη"

#: includes/class-admin.php:110
#: includes/class-admin.php:179
msgid "Page cache"
msgstr "Προσωρινή μνήμη σελίδας"

#: includes/class-admin.php:114
#: includes/class-admin.php:264
msgid "Object cache"
msgstr "Προσωνήμνη αντικειμένων"

#: includes/class-admin.php:118
msgid "Purging"
msgstr "Εκκαθάριση"

#: includes/class-admin.php:122
msgid "Exclusions"
msgstr "Εξαιρέσεις"

#: includes/class-admin.php:126
#: includes/class-admin.php:152
#: includes/mcp-kit/class-server.php:216
msgid "AI agents (MCP)"
msgstr "Πρακτόροι AI (MCP)"

#: includes/class-admin.php:133
msgid "Purge everything now"
msgstr "Εκκαθάριση των πάντων τώρα"

#: includes/class-admin.php:134
msgid "Every cached page is discarded and will be rebuilt as visitors arrive. Continue?"
msgstr "Κάθε προσωρινά αποθηκευμένη σελίδα διαγράφεται και θα αναδημιουργηθεί καθώς φθάνουν οι επισκέπτες. Συνέχεια;"

#: includes/class-admin.php:153
#: includes/mcp-kit/class-server.php:225
msgid "Allow AI agents (MCP)"
msgstr "Να επιτρέπονται οι πράκτορες τεχνητής νοημοσύνης (MCP)"

#: includes/class-admin.php:154
#: includes/mcp-kit/class-server.php:227
msgid "Off: the tools below and their REST routes are not registered at all."
msgstr "Εκτός λειτουργίας: τα παρακάτω εργαλεία και οι διαδρομές REST τους δεν είναι καθόλου καταχωρημένα."

#: includes/class-admin.php:173
msgid "Full-page cache"
msgstr "Πλήρης προσω A-Z cache"

#: includes/class-admin.php:174
msgid "On a LiteSpeed server, pages are served by the web server before WordPress runs. On any other server, this plugin stores each page as a file and serves it before WordPress loads. This is where nearly all the speed comes from."
msgstr "Σε έναν διακομιστή LiteSpeed, οι σελίδες εξυπηρετούνται από τον διακομιστή ιστού πριν εκτελεστεί το WordPress. Σε οποιονδήποτε άλλο διακομιστή, αυτό το πρόσθετο αποθηκεύει κάθε σελίδα ως αρχείο και την εξυπηρετεί πριν φορτωθεί το WordPress. Από εδώ προέρχεται σχεδόν όλη η ταχύτητα."

#: includes/class-admin.php:180
msgid "Cache pages for visitors who are not signed in"
msgstr "Προσωρινή αποθήκευση σελίδων (cache) για επισκέπτες που δεν είναι συνδεδεμένοι"

#: includes/class-admin.php:186
msgid "How long a page stays cached"
msgstr "Πόσο χρόνο παραμένει αποθηκευμένη μια σελίδα στη μνήμη cache"

#: includes/class-admin.php:187
msgid "Seconds. A week suits most sites; a news site publishing hourly wants far less."
msgstr "Δευτερόλεπτα. Μια εβδομάδα ταιριάζει στα περισσότερα sites· ένας ιστότοπος ειδήσεων που δημοσιεύει ωριαία χρειάζεται πολύ λιγότερα."

#: includes/class-admin.php:196
msgid "How long a visitor’s browser keeps images and scripts"
msgstr "Πόσο χρόνο το πρόγραμμα περιήγησης ενός επισκέπτη διατηρεί εικόνες και σενάρια εντολών"

#: includes/class-admin.php:197
msgid "Seconds. Applies to images, CSS and JavaScript only — never to pages. Set to 0 to leave this to your host."
msgstr "Δευτερόλεπτα. Ισχύει μόνο για εικόνες, CSS και JavaScript — ποτέ για σελίδες. Ορίστε σε 0 για να το αφήσετε στον πάροχο φιλοξενίας σας."

#: includes/class-admin.php:205
msgid "Signed-in visitors"
msgstr "Συνδεδεμένοι επισκέπτες"

#: includes/class-admin.php:206
msgid "Never serve a cached page to a signed-in visitor"
msgstr "Μην σερβίρετε ποτέ αποθηκευμένη σε κσνή (caching) σελίδα σε έναν συνδεδεμένο επισκέπτη"

#: includes/class-admin.php:207
msgid "On is the safe answer and the default. Turn it off only if you know every cached page is identical for every signed-in user — a membership site is the usual reason not to."
msgstr "Η ενεργοποίηση είναι η ασφαλής επιλογή και η προεπιλογή. Απενεργοποιήστε την μόνο εάν γνωρίζετε ότι κάθε αποθηκευμένη στη μνήμη (cached) σελίδα είναι πανομοιότυπη για κάθε συνδεδεμένο χρήστη — ένας ιστότοπος μέλους είναι ο συνήθης λόγος για να μην το κάνετε."

#: includes/class-admin.php:213
msgid "Different lifetimes for different content"
msgstr "Διαφορετικές διάρκειες ζωής για διαφορετικό περιεχόμενο"

#: includes/class-admin.php:214
msgid "For example: a shop’s product pages for an hour, while everything else stays a week."
msgstr "Για παράδειγμα: οι σελίδες προϊόντων ενός καταστήματος για μία ώρα, ενώ όλα τα υπόλοιπα παραμένουν για μία εβδομάδα."

#: includes/class-admin.php:215
msgid "Add a rule"
msgstr "Προσθήκη κανόνα"

#: includes/class-admin.php:222
msgid "Content type"
msgstr "Τύπος περιεχομένου"

#: includes/class-admin.php:228
msgid "Seconds"
msgstr "Δευτερόλεπτα"

#: includes/class-admin.php:249
#: includes/class-admin.php:258
msgid "Object cache (Redis)"
msgstr "Προσωρινή μνήμη αντικειμένων (Redis)"

#: includes/class-admin.php:250
msgid "Your host runs a private Redis object cache for this site and keeps it configured. There is nothing to set up here; the status at the top of this screen shows whether it is working."
msgstr "Ο κεντρικός υπολογιστής σας διαχειρίζεται μια ιδιωτική κρυφία αντικειμένων Redis για αυτόν τον ιστότοπο και διατηρεί τις ρυθμίσεις της. Δεν χρειάζεται να ρυθμίσετε τίποτα εδώ· η κατάσταση στο επάνω μέρος αυτής της οθόνης δείχνει αν λειτουργεί."

#: includes/class-admin.php:259
msgid "Caches the results of database queries. It helps most on a busy shop or a site with a lot of signed-in traffic, where the page cache cannot."
msgstr "Κάνει caching στα αποτελέσματα των ερωτημάτων βάσης δεδομένων. Βοηθάει περισσότερο σε ένα φορτωμένο κατάστημα ή σε έναν ιστότοπο με μεγάλη κίνηση από συνδεδεμένους χρήστες, όπου η προσω Aν μνήμη (cache) σελίδων δεν μπορεί."

#: includes/class-admin.php:265
msgid "Install the Redis object-cache drop-in"
msgstr "Εγκατάσταση του drop-in object-cache Redis"

#: includes/class-admin.php:266
msgid "Needs the phpredis extension. If it is missing, the box above this screen says so."
msgstr "Απαιτείται η επέκταση phpredis. Εάν λείπει, το πλαίσιο πάνω από αυτή την οθόνη το αναφέρει."

#: includes/class-admin.php:272
msgid "Redis host"
msgstr "Κεντρικός υπολογιστής Redis"

#: includes/class-admin.php:279
msgid "Redis port"
msgstr "Θύρα Redis"

#: includes/class-admin.php:288
msgid "Redis database"
msgstr "Βάση δεδομένων Redis"

#: includes/class-admin.php:289
msgid "Give each site on a shared Redis its own number, or they will clear each other’s cache."
msgstr "Δώστε σε κάθε ιστότοπο σε ένα κοινόχρηστο Redis τον δικό του αριθμό, διαφορετικά θα διαγράψουν την προσωernή μνήμη ο ένας του άλλου."

#: includes/class-admin.php:298
msgid "Redis username"
msgstr "Όνομα χρήστη Redis"

#: includes/class-admin.php:299
msgid "Only for a Redis server with ACL users (Redis 6 or later). Leave blank to sign in with the password alone."
msgstr "Μόνο για διακομιστή Redis με χρήστες ACL (Redis 6 ή νεότερη έκδοση). Αφήστε το κενό για σύνδεση μόνο με τον κωδικό πρόσβασης."

#: includes/class-admin.php:307
msgid "Redis password"
msgstr "Κωδικός πρόσβασης Redis"

#: includes/class-admin.php:308
msgid "Leave blank if your Redis does not need one."
msgstr "Αφήστε το κενό εάν το Redis σας δεν χρειάζεται."

#: includes/class-admin.php:315
msgid "Key prefix"
msgstr "Πρόθεμα κλειδιού"

#: includes/class-admin.php:316
msgid "An alternative to a separate database number when you cannot have one."
msgstr "Μια εναλλακτική λύση αντί για έναν ξεχωριστό αριθμό βάσης δεδομένων όταν δεν μπορείτε να έχετε έναν."

#: includes/class-admin.php:333
msgid "Smart auto-purge"
msgstr "Έξυπνη αυτόματη εκκαθάριση"

#: includes/class-admin.php:334
msgid "Clear affected pages automatically when content changes"
msgstr "Αυτόματος καθαρισμός επηρεασμένων σελίδων όταν αλλάζει το περιεχόμενο"

#: includes/class-admin.php:340
msgid "After updates"
msgstr "Μετά από ενημερώσεις"

#: includes/class-admin.php:341
msgid "Clear everything after a core, plugin or theme update"
msgstr "Εκκαθάριση όλων των δεδομένων μετά από ενημέρωση πυρήνα, πρόσθετου ή θέματος"

#: includes/class-admin.php:347
msgid "After a comment"
msgstr "Μετά από ένα σχόλιο"

#: includes/class-admin.php:348
msgid "Clear a post’s page when a comment on it is approved"
msgstr "Εκκαθάριση της σελίδας μιας δημοσίευσης όταν εγκρίνεται ένα σχόλιο σε αυτήν"

#: includes/class-admin.php:349
msgid "Turn this off on a very busy comment section, where it can clear the same page hundreds of times an hour."
msgstr "Απενεργοποιήστε το αυτό σε μια ενότητα σχολίων με μεγάλη κίνηση, όπου μπορεί να καθαρίζει την ίδια σελίδα εκατοντάδες φορές την ώρα."

#: includes/class-admin.php:364
msgid "Never cache these"
msgstr "Να μη γίνεται ποτέ προσωρινή αποθήκευση αυτών"

#: includes/class-admin.php:365
msgid "Sensible WordPress and WooCommerce defaults are always applied — cart, checkout, my-account and any signed-in session are never cached, whatever is below."
msgstr "Οι λογικές προεπιλογές για τα WordPress και WooCommerce εφαρμόζονται πάντα — το καλάθι, το ταμείο, ο λογαριασμός μου και οποιαδήποτε συνδεδεμένη συνεδρία δεν αποθηκεύονται ποτέ στην κρυφή μνήμη (cache), ανεξάρτητα από το τι βρίσκεται παρακάτω."

#: includes/class-admin.php:371
msgid "Addresses"
msgstr "Διευθύνσεις"

#: includes/class-admin.php:372
msgid "One path per line, for example <code>/basket</code>. A trailing <code>*</code> matches everything under it."
msgstr "Μία διαδρομή ανά γραμμή, για παράδειγμα <code>/basket</code>. Ένας τελικός χαρακτήρας <code>*</code> ταιριάζει με τα πάντα κάτω από αυτόν."

#: includes/class-admin.php:380
msgid "Query parameters"
msgstr "Παράμετροι ερωτήματος"

#: includes/class-admin.php:381
msgid "A page carrying one of these is never cached — for example a one-time preview token."
msgstr "Μια σελίδα που φέρει ένα από αυτά δεν αποθηκεύεται ποτέ στην κρυφή μνήμη — για παράδειγμα, ένα διακριτικό προεπισκόπησης μίας χρήσης."

#: includes/class-admin.php:389
msgid "Cookies"
msgstr "Cookies"

#: includes/class-admin.php:390
msgid "A visitor carrying one of these is always served a fresh page."
msgstr "Σε έναν επισκέπτη που φέρει ένα από αυτά, σερβίρεται πάντα μια φρέσκια σελίδα."

#: includes/class-admin.php:419
msgid "Every cached page has been discarded. They will be rebuilt as visitors arrive."
msgstr "Όλες οι προσωρινά αποθηκευμένες σελίδες έχουν διαγραφεί. Θα αναδημιουργηθούν καθώς φθάνουν οι επισκέπτες."

#: includes/class-admin.php:445
msgid "The object cache is installed, but it is not storing anything."
msgstr "Η κρυφή μνήμη αντικειμένων είναι εγκατεστημένη, αλλά δεν αποθηκεύει τίποτα."

#: includes/class-admin.php:459
msgid "The page cache is on, but pages are not being stored yet."
msgstr "Η προσωρινή μνήμη σελίδων είναι ενεργοποιημένη, αλλά οι σελίδες δεν αποθηκεύονται ακόμα."

#: includes/class-admin.php:460
msgid "WordPress has not loaded the page-cache drop-in yet. It starts on the next page load; if it does not, check that WP_CACHE is true in wp-config.php."
msgstr "Το WordPress δεν έχει φορτώσει ακόμα το πρόσθετο page-cache. Θα ξεκινήσει στην επόμενη φόρτωση της σελίδας· εάν δεν το κάνει, ελέγξτε ότι η παράμετρος WP_CACHE είναι true στο αρχείο wp-config.php."

#: includes/class-admin.php:469
msgid "The object cache is on, but this server has no Redis support."
msgstr "Η προσωine μνήμη αντικειμένων (object cache) είναι ενεργή, αλλά αυτός ο διακομιστής δεν υποστηρίζει το Redis."

#: includes/class-admin.php:470
msgid "The phpredis extension is not installed, so the drop-in cannot be used and WordPress is falling back to its own in-memory cache. Ask your host to enable phpredis."
msgstr "Η επέκταση phpredis δεν είναι εγκατεστημένη, επομένως το drop-in δεν μπορεί να χρησιμοποιηθεί και το WordPress επιστρέφει στη δική του προσω Gνή μνήμη cache. Ζητήστε από τον πάροχο φιλοξενίας σας να ενεργοποιήσει το phpredis."

#: includes/class-admin.php:478
msgid "Nothing is being cached."
msgstr "Δεν γίνεται προσωρινή αποθήκευση."

#: includes/class-admin.php:479
msgid "Both caches are switched off, so this plugin is not making the site any faster."
msgstr "Και οι δύο κρυφές μνήμες είναι απενεργοποιημένες, επομένως αυτό το πρόσθετο δεν κάνει τον ιστότοπο πιο γρήγορο."

#: includes/class-admin.php:486
msgid "Caching is active on this site."
msgstr "Η προσωρινή μνήμη (caching) είναι ενεργή σε αυτόν τον ιστότοπο."

#: includes/class-admin.php:521
msgid "Redis refused the username or password. Check the Redis credentials in wp-config.php or on this screen."
msgstr "Το Redis απέρριψε το όνομα χρήστη ή τον κωδικό πρόσβασης. Ελέγξτε τα διαπιστευτήρια του Redis στο wp-config.php ή σε αυτήν την οθόνη."

#: includes/class-admin.php:523
msgid "Redis accepted the login but does not allow this site to store its keys. The Redis user needs permission for this site's key prefix."
msgstr "Η Redis αποδίωξε τη σύνδεση αλλά δεν επιτρέπει σε αυτόν τον ιστότοπο να αποθηκεύσει τα κλειδιά του. Ο χρήστης της Redis χρειάζεται άδεια για το πρόθεμα κλειδιών αυτού του ιστότοπου."

#: includes/class-admin.php:525
msgid "Redis refused the database number. Check the Redis database setting."
msgstr "Η Redis απέρριψε τον αριθμό της βάσης δεδομένων. Ελέγξτε τη ρύθμιση της βάσης δεδομένων Redis."

#: includes/class-admin.php:527
msgid "Redis is out of memory and is refusing new data."
msgstr "Το Redis εξάντλησε τη μνήμη του και αρνείται νέα δεδομένα."

#: includes/class-admin.php:529
msgid "The phpredis extension is not installed, so WordPress is using its own in-memory cache. Ask your host to enable phpredis."
msgstr "Η επέκταση phpredis δεν είναι εγκατεστημένη, επομένως το WordPress χρησιμοποιεί τη δική του μνήμη cache. Ζητήστε από τον πάροχο φιλοξενίας σας να ενεργοποιήσει το phpredis."

#: includes/class-admin.php:531
msgid "WP_REDIS_DISABLED is set in wp-config.php, so the object cache is switched off."
msgstr "Το WP_REDIS_DISABLED έχει οριστεί στο wp-config.php, επομένως η προσωνή μνήμη αντικειμένων είναι απενεργοποιημένη."

#: includes/class-admin.php:533
msgid "The Redis server could not be reached. Check the Redis host and port, and that Redis is running."
msgstr "Δεν ήταν δυνατή η σύνδεση με τον διακομιστή Redis. Ελέγξτε τον κεντρικό υπολογιστή και τη θύρα του Redis, καθώς και αν ο Redis εκτελείται."

#: includes/class-admin.php:535
msgid "Redis did not return the value that was just written to it. Check the Redis server's logs."
msgstr "Το Redis δεν επέστρεψε την τιμή που μόλις γράφτηκε σε αυτό. Ελέγξτε τα αρχεία καταγραφής (logs) του διακομιστή Redis."

#: includes/class-admin.php:550
msgid "Web server"
msgstr "Διακομιστής Ιστού"

#: includes/class-admin.php:552
msgid "LiteSpeed — pages are cached by the web server"
msgstr "LiteSpeed — οι σελίδες αποθηκεύονται στη μνήμη cache από τον διακομιστή ιστού"

#: includes/class-admin.php:553
msgid "not LiteSpeed — pages are cached on disk by this plugin"
msgstr "όχι LiteSpeed — οι σελίδες αποθηκεύονται στην κσνή μνήμη (cache) στον δίσκο από αυτό το πρόσθετο"

#: includes/class-admin.php:556
msgid "Pages stored on disk"
msgstr "Σελίδες αποθηκευμένες στον δίσκο"

#: includes/class-admin.php:560
msgid "Redis support"
msgstr "Υποστήριξη Redis"

#: includes/class-admin.php:562
msgid "phpredis is installed"
msgstr "το phpredis είναι εγκατεστημένο"

#: includes/class-admin.php:563
msgid "phpredis is not installed"
msgstr "Το phpredis δεν είναι εγκατεστημένο"

#: includes/class-admin.php:566
msgid "Page lifetime"
msgstr "Διάρκεια ζωής σελίδας"

#: includes/class-admin.php:641
msgid "You are not allowed to purge the cache."
msgstr "Δεν έχετε άδεια να εκκαθαρίσετε την προσωρινή μνήμη."

#: includes/class-admin.php:647
msgid "Cache purge requested."
msgstr "Ζητήθηκε εκκαθάριση της προσωρινής μνήμης."

#: includes/class-admin.php:675
msgid "Zinn® Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn® Cache: έχει εγκατασταθεί ένα άλλο πρόσθετο προσωρινής μνήμης αντικειμένων, επομένως η προσωρινή μνήμη αντικειμένων Redis δεν διαχειρίζεται από αυτό το πρόσθετο."

#: includes/class-admin.php:689
msgid "detected"
msgstr "εντοπίστηκε"

#: includes/class-admin.php:690
msgid "not detected"
msgstr "δεν εντοπίστηκε"

#: includes/class-admin.php:694
msgid "phpredis extension missing"
msgstr "λείπει η επέκταση phpredis"

#: includes/class-admin.php:696
msgid "installed, not storing anything"
msgstr "εγκατεστημένο, δεν αποθηκεύει τίποτα"

#: includes/class-admin.php:698
msgid "active, managed by your host"
msgstr "ενεργό, διαχειριζόμενο από τον πάροχό σας"

#: includes/class-admin.php:700
msgid "active"
msgstr "ενεργό"

#: includes/class-admin.php:702
msgid "inactive"
msgstr "ανενεργό"

#: includes/class-admin.php:707
msgid "LiteSpeed cache:"
msgstr "Προσωρινή μνήμη LiteSpeed:"

#: includes/class-admin.php:709
msgid "Redis object cache:"
msgstr "Προσωρινή μνήμη αντικειμένων Redis:"

#: includes/class-object-cache.php:256
msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Η επέκταση PHP του Redis (phpredis) δεν είναι διαθέσιμη σε αυτόν τον διακομιστή, επομένως η προσωρινή μνήμη αντικειμένων δεν μπορεί να ενεργοποιηθεί."

#: includes/class-object-cache.php:263
msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn® object cache."
msgstr "Ένα άλλο πρόσθετο object-cache είναι ήδη εγκατεστημένο. Αφαιρέστε το πριν ενεργοποιήσετε την κρυφάμηνη αντικειμένων Zinn®."

#: includes/class-object-cache.php:275
msgid "Could not write the Redis connection configuration file."
msgstr "Δεν ήταν δυνατή η εγγραφή του αρχείου ρυθμίσεων σύνδεσης Redis."

#: includes/class-object-cache.php:283
msgid "The bundled object-cache drop-in could not be read."
msgstr "Δεν ήταν δυνατή η ανάγνωση του συνοδευτικού drop-in προσωρινής μνήμης αντικειμένων."

#: includes/class-object-cache.php:290
msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Δεν ήταν δυνατή η εγκατάσταση του drop-in προσωρινής μνήμης αντικειμένων στο wp-content."

#: includes/class-object-cache.php:316
msgid "Could not remove the object-cache drop-in."
msgstr "Δεν ήταν δυνατή η αφαίρεση του drop-in προσωρινής μνήμης αντικειμένων."

#: includes/class-object-cache.php:411
msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "Το σύστημα αρχείων του WordPress δεν είναι εγγράψιμο, επομένως δεν ήταν δυνατή η διαχείριση του drop-in προσωρινής μνήμης αντικειμένων."

#: includes/class-page-cache.php:328
msgid "Another page-cache plugin has installed wp-content/advanced-cache.php. Remove that plugin first, or keep using its page cache."
msgstr "Ένα άλλο πρόσθετο προσω Cης μνήμης σελίδων (page-cache) έχει εγκαταστήσει το wp-content/advanced-cache.php. Καταργήστε πρώτα αυτό το πρόσθετο ή συνεχίστε να χρησιμοποιείτε την προσωρινή μνήμη σελίδων του."

#: includes/class-page-cache.php:331
msgid "The folder wp-content/cache/zinn-cache could not be written, so pages cannot be cached."
msgstr "Δεν ήταν δυνατή η εγγραφή στον φάκελο wp-content/cache/zinn-cache, επομένως δεν είναι δυνατή η προσωρινή αποθήκευση (caching) των σελίδων."

#: includes/class-page-cache.php:338
msgid "wp-content/advanced-cache.php could not be written, so pages cannot be cached."
msgstr "Δεν ήταν δυνατή η εγγραφή του wp-content/advanced-cache.php, επομένως δεν είναι δυνατή η αποθήκευση των σελίδων στην κρυφή μνήμη."

#: includes/class-updater.php:250
msgid "See the Zinn Digital® release notes."
msgstr "Δείτε τις σημειώσεις έκδοσης του Zinn Digital®."

#: includes/class-updater.php:299
msgid "The Zinn® update service did not issue a download link for this update. Check that this site can reach the Zinn® platform, then try again."
msgstr "Η υπηρεσία ενημέρωσης Zinn® δεν εξέδωσε σύνδεσμο λήψης για αυτήν την ενημέρωση. Βεβαιωθείτε ότι αυτός ο ιστότοπος μπορεί να συνδεθεί στην πλατφόρμα Zinn® και, στη συνέχεια, δοκιμάστε ξανά."

#. translators: %s: the download error reported by WordPress.
#: includes/class-updater.php:313
#, php-format
msgid "The update could not be downloaded from the Zinn® update service (%s). Try again in a few minutes."
msgstr "Δεν ήταν δυνατή η λήψη της ενημέρωσης από την υπηρεσία ενημερώσεων Zinn® (%s). Δοκιμάστε ξανά σε λίγα λεπτά."

#: includes/class-updater.php:327
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Η ληφθείσα ενημέρωση απέτυχε στον έλεγχο ακεραιότητας και δεν εγκαταστάθηκε."

#: includes/class-upsell.php:85
msgid "Go Pro"
msgstr "Μετάβαση σε Pro"

#: includes/class-upsell.php:112
msgid "A cache analytics screen: hit ratio, memory, keys and the slowest cache commands."
msgstr "Μια οθόνη αναλυτικών στοιχείων λανθάνουσας μνήμης: ποσοστό επιτυχίας, μνήμη, κλειδιά και οι πιο αργές εντολές λανθάνουσας μνήμης."

#: includes/class-upsell.php:113
msgid "A slow-query and uncached-call finder that names the plugin or theme responsible."
msgstr "Ένα εργαλείο εντοπισμού αργών ερωτημάτων και μη προσωρινά αποθηκευμένων κλήσεων που κατονομάζει το υπεύθυνο πρόσθετο ή θέμα."

#: includes/class-upsell.php:114
msgid "An in-memory APCu tier in front of Redis for the hottest keys, plus prefetching, compression and the igbinary serializer."
msgstr "Ένα επίπεδο APCu στη μνήμη μπροστά από το Redis για τα πιο δημοφιλή κλειδιά, συν προφόρτωση, συμπίεση και τον serializer igbinary."

#: includes/class-upsell.php:115
msgid "Tag-based purging for posts, terms and WooCommerce products, so only what changed is cleared, with the page and object caches purged together."
msgstr "Εκκαθάριση βάσει ετικετών για δημοσιεύσεις, όρους και προϊόντα WooCommerce, ώστε να διαγράφεται μόνο ό,τι έχει αλλάξει, με ταυτόχρονη εκκαθάριση της προσω Aιμνής μνήμης σελίδας και αντικειμένων."

#: includes/class-upsell.php:116
msgid "Automatic cache warm-up after a purge, WebP and AVIF images, unused-CSS removal and delayed JavaScript."
msgstr "Αυτόματη προθέρμανση της κaché μετά από εκκαθάριση, εικόνες WebP και AVIF, αφαίρεση περιττής CSS και καθυστερημένη JavaScript."

#: includes/class-upsell.php:117
msgid "Scheduled database clean-up with a preview, and per-page cache rules."
msgstr "Προγραμματισμένος καθαρισμός βάσης δεδομένων με προεπισκόπηση και κανόνες προσωρινής αποθήκευσης ανά σελίδα."

#: includes/class-upsell.php:118
msgid "Cache health alerts in your Zinn Digital® dashboard when the hit ratio drops or memory fills."
msgstr "Ειδοποιήσεις υγείας της cache στον πίνακά σας ελέγχου στο Zinn Digital® όταν η αναλογία επιτυχιών μειώνεται ή γεμίζει η μνήμη."

#: includes/class-upsell.php:132
msgid "Everything on the other tabs is free and stays free. Pro installs on top of this plugin and adds:"
msgstr "Τα πάντα στις άλλες καρτέλες είναι δωρεάν και παραμένουν δωρεάν. Το Pro εγκαθίσταται πάνω από αυτό το πρόσθετο και προσθέτει:"

#: includes/class-upsell.php:134
msgid "See what Pro costs"
msgstr "Δείτε πόσο κοστίζει το Pro"

#. translators: 1: yearly price for one site, 2: for five sites, 3: for unlimited sites (each already formatted, e.g. $49).
#: includes/class-upsell.php:138
#, php-format
msgid "Every plan starts with a 14-day free trial, no card needed: %1$s a year for one site, %2$s for five sites, %3$s for unlimited sites."
msgstr "Κάθε πρόγραμμα ξεκινά με μια 14ήμερη δωρεάν δοκιμή, χωρίς να απαιτείται κάρτα: %1$s το έτος για έναν ιστότοπο, %2$s για πέντε ιστότοπους, %3$s για απεριόριστους ιστότοπους."

#: includes/class-wp-config.php:66
msgid "wp-config.php was not found, so WP_CACHE could not be turned on. Add define( 'WP_CACHE', true ); to it."
msgstr "Το wp-config.php δεν βρέθηκε, οπότε δεν ήταν δυνατή η ενεργοποίηση του WP_CACHE. Προσθέστε σε αυτό το define( 'WP_CACHE', true );."

#: includes/class-wp-config.php:72
msgid "wp-config.php already defines WP_CACHE as false, so the page cache cannot start. Change it to true."
msgstr "Το αρχείο wp-config.php ορίζει ήδη το WP_CACHE ως false, επομένως η κρυφία μνήμη σελίδας (page cache) δεν μπορεί να ξεκινήσει. Αλλάξτε το σε true."

#: includes/class-wp-config.php:79
msgid "wp-config.php is not writable, so WP_CACHE could not be turned on. Add define( 'WP_CACHE', true ); to it."
msgstr "Το αρχείο wp-config.php δεν είναι εγγραφές, επομένως δεν ήταν δυνατή η ενεργοποίηση του WP_CACHE. Προσθέστε το define( 'WP_CACHE', true ); σε αυτό."

