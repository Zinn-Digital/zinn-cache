#. Plugin Name of the plugin
#: zinn-cache.php
#: includes/mcp/class-abilities.php:55
msgid "Zinn® Cache"
msgstr "Zinn® Cache"

#. Plugin URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-cache"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-cache"

#. Description of the plugin
#: zinn-cache.php
msgid "A page cache and a Redis object cache for any WordPress site. Uses the LiteSpeed server cache where there is one and its own disk cache everywhere else, purges only what a change affects, and proves its Redis connection works."
msgstr "Μια προσωρινή μνήμη σελίδων και μια προσωρινή μνήμη αντικειμένων Redis για κάθε ιστότοπο WordPress. Χρησιμοποιεί την προσωρινή μνήμη διακομιστή LiteSpeed όπου υπάρχει και τη δική της προσωρινή μνήμη δίσκου οπουδήποτε αλλού, εκκαθαρίζει μόνο ό,τι επηρεάζεται από μια αλλαγή και επιβεβαιώνει ότι η σύνδεση Redis λειτουργεί."

#. Author of the plugin
#: zinn-cache.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:103
msgid "Purge addresses"
msgstr "Εκκαθάριση διευθύνσεων"

#: includes/class-admin.php:104
msgid "One address per line: a path such as /about/ or a full address on this site. Each one is removed from every cache layer at once."
msgstr "Μία διεύθυνση ανά γραμμή: μια διαδρομή όπως /about/ ή μια πλήρης διεύθυνση σε αυτόν τον ιστότοπο. Κάθε μία καταργείται ταυτόχρονα από κάθε επίπεδο κρυφής μνήμης."

#: includes/class-admin.php:105
msgid "Addresses to purge"
msgstr "Διευθύνσεις προς εκκαθάριση"

#: includes/class-admin.php:106
msgid "Purge these addresses"
msgstr "Εκκαθάριση αυτών των διευθύνσεων"

#: includes/class-admin.php:107
msgid "Check what is caching"
msgstr "Ελέγξτε τι αποθηκεύεται στην προσωρινή μνήμη"

#: includes/class-admin.php:108
msgid "Requests the home page and the newest pages twice, as a visitor would, and reports which cache answered and how often it was a hit."
msgstr "Ζητά την αρχική σελίδα και τις νεότερες σελίδες δύο φορές, όπως θα έκανε ένας επισκέπτης, και αναφέρει ποια κρυφή μνήμη απάντησε και πόσο συχνά υπήρξε επιτυχία."

#: includes/class-admin.php:109
msgid "Check now"
msgstr "Έλεγχος τώρα"

#. translators: 1: pages checked, 2: pages that did not answer.
#: includes/class-admin.php:111
#, php-format
msgid "Pages checked: %1$d. Pages that did not answer: %2$d."
msgstr "Σελίδες που ελέγχθηκαν: %1$d. Σελίδες που δεν αποκρίθηκαν: %2$d."

#: includes/class-admin.php:112
msgid "served from the cache"
msgstr "Εξυπηρετήθηκε από την κρυφή μνήμη"

#: includes/class-admin.php:113
msgid "No cache layer named itself in the responses."
msgstr "Κανένα επίπεδο προσωρινής μνήμης δεν αναγνωρίστηκε στις αποκρίσεις."

#: includes/class-admin.php:114
msgid "Reload this screen to see the detection above updated."
msgstr "Επαναφορτώστε αυτήν την οθόνη για να δείτε ενημερωμένο τον παραπάνω εντοπισμό."

#: includes/class-admin.php:115
#: includes/class-status.php:188
#: includes/class-status.php:196
msgid "Paced refresh"
msgstr "Σταδιακή ανανέωση"

#: includes/class-admin.php:116
msgid "Refreshes every page a batch per minute instead of emptying the cache at once. It starts by itself after an update or a site-wide change."
msgstr "Ανανεώνει κάθε σελίδα κατά παρτίδες ανά λεπτό αντί να αδειάζει την προσωρινή μνήμη μονομιάς. Ξεκινά από μόνο του μετά από μια ενημέρωση ή μια αλλαγή σε ολόκληρο τον ιστότοπο."

#: includes/class-admin.php:117
msgid "Start a refresh now"
msgstr "Έναρξη ανανέωσης τώρα"

#: includes/class-admin.php:118
msgid "Stop the refresh"
msgstr "Διακοπή της ανανέωσης"

#: includes/class-admin.php:119
msgid "The refresh is running."
msgstr "Η ανανέωση βρίσκεται σε εξέλιξη."

#: includes/class-admin.php:120
msgid "No refresh is running."
msgstr "Δεν εκτελείται καμία ανανέωση."

#: includes/class-admin.php:121
msgid "Working…"
msgstr "Σε εξέλιξη…"

#: includes/class-admin.php:122
msgid "purged"
msgstr "Εκκαθαρίστηκε"

#: includes/class-admin.php:123
msgid "queued (sent within a minute)"
msgstr "σε ουρά (αποστέλλεται εντός ενός λεπτού)"

#: includes/class-admin.php:124
msgid "failed"
msgstr "Απέτυχε"

#: includes/class-admin.php:125
msgid "The request failed"
msgstr "Το αίτημα απέτυχε"

#: includes/class-admin.php:126
msgid "No cache layer needed purging."
msgstr "Δεν χρειάστηκε εκκαθάριση κανενός επιπέδου προσωρινής μνήμης."

#: includes/class-admin.php:159
msgid "Cache"
msgstr "Προσωρινή μνήμη"

#: includes/class-admin.php:165
msgid "Status"
msgstr "Κατάσταση"

#: includes/class-admin.php:169
#: includes/class-admin.php:553
msgid "Page cache"
msgstr "Προσωρινή μνήμη σελίδας"

#: includes/class-admin.php:173
#: includes/class-admin.php:638
msgid "Object cache"
msgstr "Μνήμη cache αντικειμένων"

#: includes/class-admin.php:177
msgid "Purging"
msgstr "Εκκαθάριση"

#: includes/class-admin.php:181
msgid "Exclusions"
msgstr "Εξαιρέσεις"

#: includes/class-admin.php:185
msgid "Server cache"
msgstr "Κρυφή μνήμη διακομιστή"

#: includes/class-admin.php:189
msgid "Lighter pages"
msgstr "Ελαφρύτερες σελίδες"

#: includes/class-admin.php:193
#: includes/class-admin.php:526
#: includes/mcp-kit/class-server.php:322
msgid "AI agents (MCP)"
msgstr "Πράκτορες τεχνητής νοημοσύνης (MCP)"

#: includes/class-admin.php:200
msgid "Empty all now"
msgstr "Άδειασμα όλων τώρα"

#: includes/class-admin.php:201
msgid "Every cached page is discarded at once, on every cache layer this plugin purges, and every visitor will reach WordPress until pages are rebuilt. Updates do not need this: they refresh pages gradually by themselves. Continue?"
msgstr "Κάθε αποθηκευμένη σελίδα απορρίπτεται αμέσως, σε κάθε επίπεδο προσωρινής μνήμης που εκκαθαρίζει αυτό το πρόσθετο, και κάθε επισκέπτης θα φτάνει στο WordPress μέχρι να ανακατασκευαστούν οι σελίδες. Οι ενημερώσεις δεν χρειάζονται αυτό το βήμα: ανανεώνουν τις σελίδες σταδιακά από μόνες τους. Θέλετε να συνεχίσετε;"

#: includes/class-admin.php:230
msgid "not checked yet"
msgstr "δεν έχει ελεγχθεί ακόμη"

#: includes/class-admin.php:230
msgid "the check could not reach the site"
msgstr "ο έλεγχος δεν μπόρεσε να φτάσει στον ιστότοπο"

#: includes/class-admin.php:235
msgid "A page cache in front of WordPress"
msgstr "Μια προσωρινή μνήμη σελίδων μπροστά από το WordPress"

#: includes/class-admin.php:236
msgid "Many hosts put nginx, Varnish or Apache’s own cache in front of WordPress. Those answer before PHP runs, so they are faster than any plugin; Zinn® Cache then does not add a second page cache behind them. It tells them which pages changed instead. On a LiteSpeed server nothing here is needed."
msgstr "Πολλοί πάροχοι φιλοξενίας τοποθετούν το nginx, το Varnish ή την ίδια την προσωρινή μνήμη του Apache μπροστά από το WordPress. Αυτά αποκρίνονται πριν από την εκτέλεση της PHP, επομένως είναι ταχύτερα από οποιοδήποτε πρόσθετο· το Zinn® Cache δεν προσθέτει τότε μια δεύτερη προσωρινή μνήμη σελίδας πίσω από αυτά. Αντίθετα, τους ενημερώνει για το ποιες σελίδες άλλαξαν. Σε έναν διακομιστή LiteSpeed δεν χρειάζεται τίποτα εδώ."

#: includes/class-admin.php:241
msgid "Server page cache"
msgstr "Προσωρινή μνήμη σελίδων διακομιστή"

#. translators: %s: what the last check saw.
#: includes/class-admin.php:243
#, php-format
msgid "Last check: %s. “Detect automatically” keeps Zinn® Cache’s own page cache out when a server cache is seen, but purges only reach a server cache you choose here, with how to reach it."
msgstr "Τελευταίος έλεγχος: %s. Η επιλογή «Αυτόματος εντοπισμός» κρατά εκτός τη δική της προσωρινή μνήμη σελίδας του Zinn® Cache όταν εντοπίζεται προσωρινή μνήμη διακομιστή, αλλά οι εκκαθαρίσεις φτάνουν μόνο σε μια προσωρινή μνήμη διακομιστή που επιλέγετε εδώ, μαζί με τον τρόπο πρόσβασης σε αυτήν."

#: includes/class-admin.php:245
#: includes/class-status.php:154
msgid "Detect automatically"
msgstr "Αυτόματος εντοπισμός"

#: includes/class-admin.php:246
msgid "None — use Zinn® Cache’s page cache"
msgstr "Κανένα — χρησιμοποιήστε την προσωρινή μνήμη σελίδας του Zinn® Cache"

#: includes/class-admin.php:247
msgid "nginx (proxy_cache or fastcgi_cache)"
msgstr "nginx (proxy_cache ή fastcgi_cache)"

#: includes/class-admin.php:249
msgid "Apache mod_cache (disk)"
msgstr "Apache mod_cache (δίσκος)"

#: includes/class-admin.php:256
msgid "Cache headers"
msgstr "Κεφαλίδες προσωρινής μνήμης"

#: includes/class-admin.php:257
msgid "Tell the server cache how long a page may be kept (s-maxage), and mark personal pages private"
msgstr "Ενημερώστε την προσωρινή μνήμη του διακομιστή για το πόσο καιρό μπορεί να διατηρηθεί μια σελίδα (s-maxage) και επισημάνετε τις προσωπικές σελίδες ως private"

#: includes/class-admin.php:258
msgid "Signed-in visitors, excluded addresses and form posts always get Cache-Control: private, no-store. This switch adds the shared-cache lifetime to pages that may be cached."
msgstr "Οι συνδεδεμένοι επισκέπτες, οι εξαιρούμενες διευθύνσεις και οι υποβολές φορμών λαμβάνουν πάντα Cache-Control: private, no-store. Αυτός ο διακόπτης προσθέτει τη διάρκεια ζωής της κοινόχρηστης προσωρινής μνήμης σε σελίδες που μπορούν να αποθηκευτούν στην προσωρινή μνήμη."

#: includes/class-admin.php:264
msgid "How to purge nginx"
msgstr "Πώς να εκκαθαρίσετε το nginx"

#: includes/class-admin.php:266
msgid "A purge request per page (the ngx_cache_purge module)"
msgstr "Ένα αίτημα εκκαθάρισης ανά σελίδα (η μονάδα ngx_cache_purge)"

#: includes/class-admin.php:267
msgid "Delete the cache files (WordPress can read the cache folder)"
msgstr "Διαγράψτε τα αρχεία προσωρινής μνήμης (το WordPress μπορεί να διαβάσει τον φάκελο προσωρινής μνήμης)"

#: includes/class-admin.php:268
msgid "Write the addresses to a folder for the host’s purger"
msgstr "Εγγράψτε τις διευθύνσεις σε έναν φάκελο για την εκκαθάριση του παρόχου φιλοξενίας"

#: includes/class-admin.php:276
msgid "Purge address"
msgstr "Εκκαθάριση διεύθυνσης"

#: includes/class-admin.php:277
msgid "Leave blank for {scheme}://{host}/purge{request_uri}. Tokens: {scheme}, {host}, {path}, {request_uri}, {url}."
msgstr "Αφήστε κενό για το {scheme}://{host}/purge{request_uri}. Διακριτικά: {scheme}, {host}, {path}, {request_uri}, {url}."

#: includes/class-admin.php:287
msgid "Request method"
msgstr "Μέθοδος αιτήματος"

#: includes/class-admin.php:301
msgid "Send purges to"
msgstr "Αποστολή εκκαθαρίσεων σε"

#: includes/class-admin.php:302
msgid "For example http://127.0.0.1. Needed when a CDN is in front of nginx: a purge sent to the public address would reach the CDN, not nginx. The site’s host name goes in the Host header."
msgstr "Για παράδειγμα http://127.0.0.1. Απαιτείται όταν ένα CDN βρίσκεται μπροστά από το nginx: μια εκκαθάριση που αποστέλλεται στη δημόσια διεύθυνση θα έφτανε στο CDN και όχι στο nginx. Το όνομα κεντρικού υπολογιστή του ιστότοπου τοποθετείται στην κεφαλίδα Host."

#: includes/class-admin.php:312
msgid "Cache folder"
msgstr "Φάκελος προσωρινής μνήμης"

#: includes/class-admin.php:313
msgid "The folder in proxy_cache_path or fastcgi_cache_path, for example /var/cache/nginx/site. Only nginx cache files in it are ever deleted."
msgstr "Ο φάκελος στο proxy_cache_path ή στο fastcgi_cache_path, για παράδειγμα /var/cache/nginx/site. Μόνο τα αρχεία προσωρινής μνήμης nginx σε αυτόν διαγράφονται ποτέ."

#: includes/class-admin.php:323
msgid "levels="
msgstr "επίπεδα="

#: includes/class-admin.php:324
msgid "The levels= value of the same line, usually 1:2."
msgstr "Η τιμή levels= της ίδιας γραμμής, συνήθως 1:2."

#: includes/class-admin.php:334
msgid "Cache key"
msgstr "Κλειδί κρυφής μνήμης"

#: includes/class-admin.php:335
msgid "Your proxy_cache_key or fastcgi_cache_key. Leave blank for $scheme$request_method$host$request_uri."
msgstr "Το proxy_cache_key ή fastcgi_cache_key σας. Αφήστε κενό για $scheme$request_method$host$request_uri."

#: includes/class-admin.php:346
msgid "Other key variables"
msgstr "Άλλες βασικές μεταβλητές"

#: includes/class-admin.php:347
msgid "For a variable of your own in the key, one per line as name=value1|value2 (an empty value allowed), for example encoding=gzip|. Every combination is purged."
msgstr "Για μια δική σας μεταβλητή στο κλειδί, μία ανά γραμμή ως name=value1|value2 (επιτρέπεται κενή τιμή), για παράδειγμα encoding=gzip|. Κάθε συνδυασμός εκκαθαρίζεται."

#: includes/class-admin.php:358
msgid "Spool folder"
msgstr "Φάκελος ουράς"

#: includes/class-admin.php:359
msgid "A folder outside the web root that your host’s purger reads. Each purge is one file with one address per line."
msgstr "Ένας φάκελος εκτός του ριζικού καταλόγου ιστού τον οποίο διαβάζει ο μηχανισμός εκκαθάρισης του παρόχου φιλοξενίας σας. Κάθε εκκαθάριση είναι ένα αρχείο με μία διεύθυνση ανά γραμμή."

#: includes/class-admin.php:369
msgid "Varnish address"
msgstr "Διεύθυνση Varnish"

#: includes/class-admin.php:376
msgid "Varnish port"
msgstr "Θύρα Varnish"

#: includes/class-admin.php:385
msgid "Purge with"
msgstr "Εκκαθάριση με"

#: includes/class-admin.php:386
msgid "Your VCL must accept it from this server (an ACL in vcl_recv)."
msgstr "Το VCL σας πρέπει να το αποδέχεται από αυτόν τον διακομιστή (ένα ACL στο vcl_recv)."

#: includes/class-admin.php:397
msgid "CacheRoot"
msgstr "Ρίζα προσωρινής μνήμης"

#: includes/class-admin.php:398
msgid "The CacheRoot folder of mod_cache_disk."
msgstr "Ο φάκελος CacheRoot του mod_cache_disk."

#: includes/class-admin.php:405
msgid "CacheDirLevels"
msgstr "Επίπεδα καταλόγου προσωρινής μνήμης"

#: includes/class-admin.php:414
msgid "CacheDirLength"
msgstr "Μήκος καταλόγου προσωρινής μνήμης"

#: includes/class-admin.php:422
#: includes/class-status.php:148
#: includes/server/class-cloudflare.php:48
msgid "Cloudflare"
msgstr "Cloudflare"

#: includes/class-admin.php:423
msgid "When Cloudflare caches your pages (a Cache Everything rule or APO), changed pages are purged from its edge by address."
msgstr "Όταν το Cloudflare αποθηκεύει προσωρινά τις σελίδες σας (ένας κανόνας Cache Everything ή APO), οι τροποποιημένες σελίδες εκκαθαρίζονται από το άκρο του βάσει διεύθυνσης."

#: includes/class-admin.php:428
msgid "Cloudflare purge"
msgstr "Εκκαθάριση Cloudflare"

#: includes/class-admin.php:429
msgid "Purge changed pages from Cloudflare"
msgstr "Εκκαθάριση των αλλαγμένων σελίδων από το Cloudflare"

#: includes/class-admin.php:435
msgid "Zone ID"
msgstr "Αναγνωριστικό ζώνης"

#: includes/class-admin.php:436
msgid "On the Overview page of your domain in Cloudflare."
msgstr "Στη σελίδα «Επισκόπηση» του τομέα σας στο Cloudflare."

#: includes/class-admin.php:445
msgid "API token"
msgstr "Διακριτικό API"

#: includes/class-admin.php:446
msgid "Set in wp-config.php (ZINN_CACHE_CLOUDFLARE_TOKEN); that one is used."
msgstr "Έχει οριστεί στο wp-config.php (ZINN_CACHE_CLOUDFLARE_TOKEN)· χρησιμοποιείται αυτό."

#: includes/class-admin.php:446
msgid "Create a token with only Zone → Cache Purge → Purge, for this zone. It is never shown again or exported."
msgstr "Δημιουργήστε ένα διακριτικό μόνο με το Zone → Cache Purge → Purge για αυτήν τη ζώνη. Δεν εμφανίζεται ποτέ ξανά ούτε εξάγεται."

#: includes/class-admin.php:453
msgid "Empty all"
msgstr "Εκκένωση όλων"

#: includes/class-admin.php:454
msgid "Let “Empty all now” empty the whole Cloudflare zone too"
msgstr "Επιτρέψτε στο «Άδειασμα όλων τώρα» να αδειάζει επίσης ολόκληρη τη ζώνη Cloudflare"

#: includes/class-admin.php:455
msgid "Off by default: it empties every host name on the zone and sends every visitor to your server at once."
msgstr "Απενεργοποιημένο από προεπιλογή: αδειάζει κάθε όνομα κεντρικού υπολογιστή στη ζώνη και στέλνει όλους τους επισκέπτες στον διακομιστή σας ταυτόχρονα."

#: includes/class-admin.php:472
msgid "WordPress Heartbeat"
msgstr "WordPress Καρδιακός παλμός"

#: includes/class-admin.php:473
msgid "The Heartbeat is the browser asking WordPress every 15–60 seconds whether anything changed (autosave, post locks). Each ask is a PHP request the page cache cannot serve."
msgstr "Το Heartbeat είναι το ερώτημα του προγράμματος περιήγησης προς το WordPress κάθε 15–60 δευτερόλεπτα για το αν έχει αλλάξει κάτι (αυτόματη αποθήκευση, κλειδώματα άρθρων). Κάθε ερώτημα είναι ένα αίτημα PHP το οποίο δεν μπορεί να εξυπηρετήσει η προσωρινή μνήμη σελίδας."

#: includes/class-admin.php:475
msgid "Leave it as WordPress sets it"
msgstr "Αφήστε το όπως το ορίζει το WordPress"

#: includes/class-admin.php:476
msgid "Once a minute everywhere"
msgstr "Μία φορά το λεπτό παντού"

#: includes/class-admin.php:477
msgid "Off on the public site, normal in the dashboard"
msgstr "Ανενεργό στον δημόσιο ιστότοπο, κανονικό στον πίνακα ελέγχου"

#: includes/class-admin.php:484
msgid "Web fonts"
msgstr "Γραμματοσειρές ιστού"

#: includes/class-admin.php:485
msgid "Show text at once while Google Fonts load (display=swap), and connect to the font server early"
msgstr "Εμφανίστε το κείμενο αμέσως ενώ φορτώνονται οι Google Fonts (display=swap) και συνδεθείτε νωρίς στον διακομιστή γραμματοσειρών"

#: includes/class-admin.php:492
msgid "Connect early to"
msgstr "Πρόωρη σύνδεση σε"

#: includes/class-admin.php:493
msgid "One https:// address per line: servers your pages load from (a CDN, a payment or analytics script)."
msgstr "Μία διεύθυνση https:// ανά γραμμή: διακομιστές από τους οποίους φορτώνουν οι σελίδες σας (ένα CDN, ένα σενάριο πληρωμών ή αναλυτικών στοιχείων)."

#: includes/class-admin.php:500
msgid "CDN address"
msgstr "Διεύθυνση CDN"

#: includes/class-admin.php:501
msgid "For a pull CDN such as BunnyCDN or KeyCDN, for example https://cdn.example.com. Images, CSS, JavaScript and fonts under /wp-content/ and /wp-includes/ are served from it. Pages are not. Leave blank when Cloudflare proxies your whole site: it is already the CDN."
msgstr "Για ένα pull CDN όπως το BunnyCDN ή το KeyCDN, για παράδειγμα https://cdn.example.com. Εικόνες, CSS, JavaScript και γραμματοσειρές στους καταλόγους /wp-content/ και /wp-includes/ σερβίρονται από αυτό. Οι σελίδες όχι. Αφήστε το κενό όταν το Cloudflare λειτουργεί ως μεσολαβητής (proxy) για ολόκληρο τον ιστότοπό σας: είναι ήδη το CDN."

#: includes/class-admin.php:508
msgid "Keep on this site"
msgstr "Διατήρηση σε αυτόν τον ιστότοπο"

#: includes/class-admin.php:509
msgid "Addresses containing any of these (one per line) are not moved to the CDN."
msgstr "Οι διευθύνσεις που περιέχουν οποιοδήποτε από αυτά (ένα ανά γραμμή) δεν μεταφέρονται στο CDN."

#: includes/class-admin.php:527
#: includes/mcp-kit/class-server.php:331
msgid "Allow AI agents (MCP)"
msgstr "Να επιτρέπονται οι πράκτορες AI (MCP)"

#: includes/class-admin.php:528
#: includes/mcp-kit/class-server.php:333
msgid "Off: the tools below and their REST routes are not registered at all."
msgstr "Ανενεργό: τα παρακάτω εργαλεία και οι διαδρομές REST τους δεν είναι καθόλου καταχωρισμένα."

#: includes/class-admin.php:547
msgid "Full-page cache"
msgstr "Προσωρινή μνήμη πλήρους σελίδας"

#: includes/class-admin.php:548
msgid "On a LiteSpeed server, pages are served by the web server before WordPress runs. On any other server, this plugin stores each page as a file and serves it before WordPress loads. This is where nearly all the speed comes from."
msgstr "Σε έναν διακομιστή LiteSpeed, οι σελίδες εξυπηρετούνται από τον διακομιστή ιστού πριν εκτελεστεί το WordPress. Σε οποιονδήποτε άλλο διακομιστή, αυτό το πρόσθετο αποθηκεύει κάθε σελίδα ως αρχείο και την εξυπηρετεί πριν φορτωθεί το WordPress. Από εδώ προέρχεται σχεδόν όλη η ταχύτητα."

#: includes/class-admin.php:554
msgid "Cache pages for visitors who are not signed in"
msgstr "Προσωρινή αποθήκευση σελίδων για επισκέπτες που δεν έχουν συνδεθεί"

#: includes/class-admin.php:560
msgid "How long a page stays cached"
msgstr "Πόσο καιρό παραμένει προσωρινά αποθηκευμένη μια σελίδα"

#: includes/class-admin.php:561
msgid "Seconds. A week suits most sites; a news site publishing hourly wants far less."
msgstr "Δευτερόλεπτα. Μία εβδομάδα είναι κατάλληλη για τους περισσότερους ιστότοπους· ένας ειδησεογραφικός ιστότοπος που δημοσιεύει περιεχόμενο κάθε ώρα χρειάζεται πολύ λιγότερο."

#: includes/class-admin.php:570
msgid "How long a visitor’s browser keeps images and scripts"
msgstr "Πόσο καιρό διατηρεί το πρόγραμμα περιήγησης ενός επισκέπτη εικόνες και σενάρια"

#: includes/class-admin.php:571
msgid "Seconds. Applies to images, CSS and JavaScript only — never to pages. Set to 0 to leave this to your host."
msgstr "Δευτερόλεπτα. Ισχύει μόνο για εικόνες, CSS και JavaScript — ποτέ για σελίδες. Ορίστε σε 0 για να το αφήσετε στον πάροχο φιλοξενίας σας."

#: includes/class-admin.php:579
msgid "Signed-in visitors"
msgstr "Συνδεδεμένοι επισκέπτες"

#: includes/class-admin.php:580
msgid "Never serve a cached page to a signed-in visitor"
msgstr "Να μην προβάλλεται ποτέ μια αποθηκευμένη σε προσωρινή μνήμη σελίδα σε συνδεδεμένο επισκέπτη"

#: includes/class-admin.php:581
msgid "On is the safe answer and the default. Turn it off only if you know every cached page is identical for every signed-in user — a membership site is the usual reason not to."
msgstr "Η επιλογή «Ενεργό» είναι η ασφαλής απάντηση και η προεπιλογή. Απενεργοποιήστε το μόνο εάν γνωρίζετε ότι κάθε προσωρινά αποθηκευμένη σελίδα είναι πανομοιότυπη για κάθε συνδεδεμένο χρήστη — ένας ιστότοπος μελών είναι ο συνήθης λόγος για να μην το κάνετε."

#: includes/class-admin.php:587
msgid "Different lifetimes for different content"
msgstr "Διαφορετική διάρκεια ζωής για διαφορετικό περιεχόμενο"

#: includes/class-admin.php:588
msgid "For example: a shop’s product pages for an hour, while everything else stays a week."
msgstr "Για παράδειγμα: οι σελίδες προϊόντων ενός καταστήματος για μία ώρα, ενώ όλα τα υπόλοιπα παραμένουν για μία εβδομάδα."

#: includes/class-admin.php:589
msgid "Add a rule"
msgstr "Προσθήκη κανόνα"

#: includes/class-admin.php:596
msgid "Content type"
msgstr "Τύπος περιεχομένου"

#: includes/class-admin.php:602
msgid "Seconds"
msgstr "Δευτερόλεπτα"

#: includes/class-admin.php:623
#: includes/class-admin.php:632
msgid "Object cache (Redis)"
msgstr "Προσωρινή μνήμη αντικειμένων (Redis)"

#: includes/class-admin.php:624
msgid "Your host runs a private Redis object cache for this site and keeps it configured. There is nothing to set up here; the status at the top of this screen shows whether it is working."
msgstr "Ο πάροχος φιλοξενίας σας εκτελεί μια ιδιωτική προσωρινή μνήμη αντικειμένων Redis για αυτόν τον ιστότοπο και τη διατηρεί ρυθμισμένη. Δεν υπάρχει τίποτα προς ρύθμιση εδώ· η κατάσταση στο επάνω μέρος αυτής της οθόνης δείχνει αν λειτουργεί."

#: includes/class-admin.php:633
msgid "Caches the results of database queries. It helps most on a busy shop or a site with a lot of signed-in traffic, where the page cache cannot."
msgstr "Αποθηκεύει προσωρινά τα αποτελέσματα των ερωτημάτων βάσης δεδομένων. Βοηθά περισσότερο σε ένα πολυσύχναστο κατάστημα ή σε έναν ιστότοπο με μεγάλη επισκεψιμότητα από συνδεδεμένους χρήστες, όπου η προσωρινή μνήμη σελίδας δεν μπορεί να βοηθήσει."

#: includes/class-admin.php:639
msgid "Install the Redis object-cache drop-in"
msgstr "Εγκαταστήστε το drop-in της προσωρινής μνήμης αντικειμένων Redis"

#: includes/class-admin.php:640
msgid "Needs the phpredis extension. If it is missing, the box above this screen says so."
msgstr "Απαιτείται η επέκταση phpredis. Εάν λείπει, το πλαίσιο πάνω από αυτήν την οθόνη σας ενημερώνει σχετικά."

#: includes/class-admin.php:646
msgid "Redis host"
msgstr "Κεντρικός υπολογιστής Redis"

#: includes/class-admin.php:653
msgid "Redis port"
msgstr "Θύρα Redis"

#: includes/class-admin.php:662
msgid "Redis database"
msgstr "Βάση δεδομένων Redis"

#: includes/class-admin.php:663
msgid "Give each site on a shared Redis its own number, or they will clear each other’s cache."
msgstr "Δώστε σε κάθε ιστότοπο σε ένα κοινόχρηστο Redis τον δικό του αριθμό, διαφορετικά θα διαγράφουν ο ένας την προσωρινή μνήμη του άλλου."

#: includes/class-admin.php:672
msgid "Redis username"
msgstr "Όνομα χρήστη Redis"

#: includes/class-admin.php:673
msgid "Only for a Redis server with ACL users (Redis 6 or later). Leave blank to sign in with the password alone."
msgstr "Μόνο για διακομιστή Redis με χρήστες ACL (Redis 6 ή νεότερη έκδοση). Αφήστε το κενό για να συνδεθείτε μόνο με τον κωδικό πρόσβασης."

#: includes/class-admin.php:681
msgid "Redis password"
msgstr "Συνθηματικό Redis"

#: includes/class-admin.php:682
msgid "Leave blank if your Redis does not need one."
msgstr "Αφήστε το κενό εάν το δικό σας Redis δεν χρειάζεται."

#: includes/class-admin.php:689
msgid "Serializer"
msgstr "Σειριοποιητής"

#: includes/class-admin.php:690
msgid "igbinary stores the same data in less memory and reads it faster, when the PHP igbinary extension is installed. Changing it is safe at any time: each stored value is read in the format it was written in."
msgstr "Το igbinary αποθηκεύει τα ίδια δεδομένα σε λιγότερη μνήμη και τα διαβάζει ταχύτερα, όταν είναι εγκατεστημένη η επέκταση PHP igbinary. Η αλλαγή του είναι ασφαλής ανά πάσα στιγμή: κάθε αποθηκευμένη τιμή διαβάζεται στη μορφή με την οποία γράφτηκε."

#: includes/class-admin.php:692
msgid "igbinary when available, otherwise PHP"
msgstr "igbinary όταν είναι διαθέσιμο, διαφορετικά PHP"

#: includes/class-admin.php:694
#: includes/class-status.php:183
msgid "PHP (standard)"
msgstr "PHP (τυπικό)"

#: includes/class-admin.php:702
msgid "Key prefix"
msgstr "Πρόθεμα κλειδιού"

#: includes/class-admin.php:703
msgid "An alternative to a separate database number when you cannot have one."
msgstr "Μια εναλλακτική λύση για ξεχωριστό αριθμό βάσης δεδομένων όταν δεν μπορείτε να έχετε έναν."

#: includes/class-admin.php:720
msgid "Smart auto-purge"
msgstr "Έξυπνη αυτόματη εκκαθάριση"

#: includes/class-admin.php:721
msgid "Clear affected pages automatically when content changes"
msgstr "Αυτόματη εκκαθάριση των επηρεαζόμενων σελίδων όταν αλλάζει το περιεχόμενο"

#: includes/class-admin.php:727
msgid "After updates"
msgstr "Μετά τις ενημερώσεις"

#: includes/class-admin.php:728
msgid "Refresh every page, a batch a minute, after a core, plugin or theme update"
msgstr "Ανανεώστε κάθε σελίδα, μία παρτίδα ανά λεπτό, μετά από ενημέρωση του πυρήνα, προσθέτου ή θέματος"

#: includes/class-admin.php:729
msgid "Updates, plugin activations, theme and menu changes never empty the cache at once any more: emptying it sends every visitor to WordPress in the same minute. The paced refresh rebuilds the site gradually instead."
msgstr "Οι ενημερώσεις, οι ενεργοποιήσεις προσθέτων, οι αλλαγές θεμάτων και μενού δεν αδειάζουν πλέον την κρυφή μνήμη μεμιάς: το άδειασμά της στέλνει κάθε επισκέπτη στο WordPress μέσα στο ίδιο λεπτό. Αντίθετα, η σταδιακή ανανέωση αναδομεί τον ιστότοπο σταδιακά."

#: includes/class-admin.php:735
msgid "Pages refreshed per minute"
msgstr "Σελίδες που ανανεώνονται ανά λεπτό"

#: includes/class-admin.php:736
msgid "The refresh always reaches the end of the site; this only sets its pace."
msgstr "Η ανανέωση φτάνει πάντα στο τέλος του ιστότοπου· αυτό απλώς ορίζει τον ρυθμό της."

#: includes/class-admin.php:744
msgid "Pause the refresh above this server load"
msgstr "Παύση της ανανέωσης πάνω από αυτό το φορτίο διακομιστή"

#: includes/class-admin.php:745
msgid "The one-minute load average. 0 means 1.5 × the number of CPU cores."
msgstr "Ο μέσος φόρτος ενός λεπτού. Το 0 σημαίνει 1,5 × τον αριθμό των πυρήνων CPU."

#: includes/class-admin.php:753
msgid "After a comment"
msgstr "Μετά από ένα σχόλιο"

#: includes/class-admin.php:754
msgid "Clear a post’s page when a comment on it is approved"
msgstr "Εκκαθάριση της σελίδας μιας δημοσίευσης όταν εγκρίνεται ένα σχόλιο σε αυτήν"

#: includes/class-admin.php:755
msgid "Turn this off on a very busy comment section, where it can clear the same page hundreds of times an hour."
msgstr "Απενεργοποιήστε το σε μια πολύ πολυσύχναστη ενότητα σχολίων, όπου μπορεί να εκκαθαρίζει την ίδια σελίδα εκατοντάδες φορές την ώρα."

#: includes/class-admin.php:770
msgid "Never cache these"
msgstr "Να μην αποθηκεύονται ποτέ στην προσωρινή μνήμη"

#: includes/class-admin.php:771
msgid "Sensible WordPress and WooCommerce defaults are always applied — cart, checkout, my-account and any signed-in session are never cached, whatever is below."
msgstr "Εφαρμόζονται πάντα οι κατάλληλες προεπιλογές του WordPress και του WooCommerce — τα cart, checkout, my-account και οποιαδήποτε συνδεδεμένη συνεδρία δεν αποθηκεύονται ποτέ στην προσωρινή μνήμη, ό,τι κι αν υπάρχει παρακάτω."

#: includes/class-admin.php:777
#: includes/class-status.php:222
msgid "Addresses"
msgstr "Διευθύνσεις"

#: includes/class-admin.php:778
msgid "One path per line, for example <code>/basket</code>. A trailing <code>*</code> matches everything under it."
msgstr "Μία διαδρομή ανά γραμμή, για παράδειγμα <code>/basket</code>. Ένα τελικό <code>*</code> αντιστοιχεί σε οτιδήποτε κάτω από αυτό."

#: includes/class-admin.php:786
msgid "Query parameters"
msgstr "Παράμετροι ερωτήματος"

#: includes/class-admin.php:787
msgid "A page carrying one of these is never cached — for example a one-time preview token."
msgstr "Μια σελίδα που περιέχει ένα από αυτά δεν αποθηκεύεται ποτέ στην προσωρινή μνήμη — για παράδειγμα, ένα διακριτικό προεπισκόπησης μίας χρήσης."

#: includes/class-admin.php:795
msgid "Cookies"
msgstr "Cookies"

#: includes/class-admin.php:796
msgid "A visitor carrying one of these is always served a fresh page."
msgstr "Σε έναν επισκέπτη που φέρει ένα από αυτά εμφανίζεται πάντα μια νέα σελίδα."

#: includes/class-admin.php:825
msgid "Every cached page has been discarded. They will be rebuilt as visitors arrive."
msgstr "Κάθε αποθηκευμένη σελίδα έχει απορριφθεί. Θα ανακατασκευαστούν καθώς φτάνουν οι επισκέπτες."

#: includes/class-admin.php:851
msgid "The object cache is installed, but it is not storing anything."
msgstr "Η προσωρινή μνήμη αντικειμένων είναι εγκατεστημένη, αλλά δεν αποθηκεύει τίποτα."

#: includes/class-admin.php:866
msgid "The page cache is on, but pages are not being stored yet."
msgstr "Η προσωρινή μνήμη σελίδων είναι ενεργοποιημένη, αλλά οι σελίδες δεν αποθηκεύονται ακόμα."

#: includes/class-admin.php:867
msgid "WordPress has not loaded the page-cache drop-in yet. It starts on the next page load; if it does not, check that WP_CACHE is true in wp-config.php."
msgstr "Το WordPress δεν έχει φορτώσει ακόμη το drop-in της προσωρινής μνήμης σελίδας. Θα ξεκινήσει στην επόμενη φόρτωση σελίδας· εάν δεν ξεκινήσει, ελέγξτε αν το WP_CACHE είναι true στο wp-config.php."

#: includes/class-admin.php:876
msgid "The object cache is on, but this server has no Redis support."
msgstr "Η προσωρινή μνήμη αντικειμένων είναι ενεργοποιημένη, αλλά αυτός ο διακομιστής δεν υποστηρίζει Redis."

#: includes/class-admin.php:877
msgid "The phpredis extension is not installed, so the drop-in cannot be used and WordPress is falling back to its own in-memory cache. Ask your host to enable phpredis."
msgstr "Η επέκταση phpredis δεν είναι εγκατεστημένη, επομένως το drop-in δεν μπορεί να χρησιμοποιηθεί και το WordPress επιστρέφει στη δική του προσωρινή μνήμη (in-memory cache). Ζητήστε από τον πάροχο φιλοξενίας σας να ενεργοποιήσει το phpredis."

#: includes/class-admin.php:885
msgid "Nothing is being cached."
msgstr "Δεν αποθηκεύεται τίποτα στην προσωρινή μνήμη."

#: includes/class-admin.php:886
msgid "Both caches are switched off, so this plugin is not making the site any faster."
msgstr "Και οι δύο προσωρινές μνήμες είναι απενεργοποιημένες, επομένως αυτό το πρόσθετο δεν κάνει τον ιστότοπο ταχύτερο."

#: includes/class-admin.php:893
msgid "Caching is active on this site."
msgstr "Η προσωρινή αποθήκευση είναι ενεργή σε αυτόν τον ιστότοπο."

#: includes/class-admin.php:928
msgid "Redis refused the username or password. Check the Redis credentials in wp-config.php or on this screen."
msgstr "Το Redis απέρριψε το όνομα χρήστη ή τον κωδικό πρόσβασης. Ελέγξτε τα διαπιστευτήρια του Redis στο wp-config.php ή σε αυτήν την οθόνη."

#: includes/class-admin.php:930
msgid "Redis accepted the login but does not allow this site to store its keys. The Redis user needs permission for this site's key prefix."
msgstr "Το Redis αποδέχτηκε τη σύνδεση αλλά δεν επιτρέπει σε αυτόν τον ιστότοπο να αποθηκεύει τα κλειδιά του. Ο χρήστης του Redis χρειάζεται άδεια για το πρόθεμα κλειδιών αυτού του ιστότοπου."

#: includes/class-admin.php:932
msgid "Redis refused the database number. Check the Redis database setting."
msgstr "Το Redis απέρριψε τον αριθμό βάσης δεδομένων. Ελέγξτε τη ρύθμιση βάσης δεδομένων Redis."

#: includes/class-admin.php:934
msgid "Redis is out of memory and is refusing new data."
msgstr "Η μνήμη του Redis έχει εξαντληθεί και απορρίπτει νέα δεδομένα."

#: includes/class-admin.php:936
msgid "The phpredis extension is not installed, so WordPress is using its own in-memory cache. Ask your host to enable phpredis."
msgstr "Η επέκταση phpredis δεν είναι εγκατεστημένη, επομένως το WordPress χρησιμοποιεί τη δική του προσωρινή μνήμη εντός μνήμης. Ζητήστε από τον πάροχο φιλοξενίας σας να ενεργοποιήσει το phpredis."

#: includes/class-admin.php:938
msgid "WP_REDIS_DISABLED is set in wp-config.php, so the object cache is switched off."
msgstr "Η σταθερά WP_REDIS_DISABLED έχει οριστεί στο wp-config.php, επομένως η μνήμη cache αντικειμένων είναι απενεργοποιημένη."

#: includes/class-admin.php:940
msgid "The Redis server could not be reached. Check the Redis host and port, and that Redis is running."
msgstr "Δεν ήταν δυνατή η πρόσβαση στον διακομιστή Redis. Ελέγξτε τον κεντρικό υπολογιστή και τη θύρα του Redis, καθώς και αν το Redis εκτελείται."

#: includes/class-admin.php:942
msgid "Redis did not return the value that was just written to it. Check the Redis server's logs."
msgstr "Το Redis δεν επέστρεψε την τιμή που μόλις εγγράφηκε σε αυτό. Ελέγξτε τα αρχεία καταγραφής του διακομιστή Redis."

#: includes/class-admin.php:957
#: includes/class-status.php:137
msgid "Pages are served by"
msgstr "Οι σελίδες εξυπηρετούνται από"

#: includes/class-admin.php:959
msgid "LiteSpeed — pages are cached by the web server"
msgstr "LiteSpeed — οι σελίδες αποθηκεύονται στην προσωρινή μνήμη από τον διακομιστή ιστού"

#: includes/class-admin.php:963
msgid "Pages stored on disk"
msgstr "Σελίδες αποθηκευμένες στον δίσκο"

#: includes/class-admin.php:967
msgid "Redis support"
msgstr "Υποστήριξη Redis"

#: includes/class-admin.php:969
msgid "phpredis is installed"
msgstr "Το phpredis είναι εγκατεστημένο"

#: includes/class-admin.php:970
msgid "phpredis is not installed"
msgstr "το phpredis δεν είναι εγκατεστημένο"

#: includes/class-admin.php:973
msgid "Page lifetime"
msgstr "Διάρκεια ζωής σελίδας"

#: includes/class-admin.php:1049
msgid "You are not allowed to purge the cache."
msgstr "Δεν σας επιτρέπεται η εκκαθάριση της προσωρινής μνήμης."

#: includes/class-admin.php:1055
msgid "Cache purge requested."
msgstr "Ζητήθηκε εκκαθάριση της προσωρινής μνήμης."

#: includes/class-admin.php:1083
msgid "Zinn® Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn® Cache: είναι εγκατεστημένο ένα άλλο drop-in object-cache, επομένως η προσωρινή μνήμη αντικειμένων Redis δεν διαχειρίζεται από αυτό το πρόσθετο."

#: includes/class-admin.php:1097
msgid "detected"
msgstr "Εντοπίστηκε"

#: includes/class-admin.php:1098
msgid "not detected"
msgstr "Δεν εντοπίστηκε"

#: includes/class-admin.php:1102
msgid "phpredis extension missing"
msgstr "Λείπει η επέκταση phpredis"

#: includes/class-admin.php:1104
msgid "installed, not storing anything"
msgstr "εγκατεστημένο, δεν αποθηκεύει τίποτα"

#: includes/class-admin.php:1106
msgid "active, managed by your host"
msgstr "ενεργό, διαχειρίζεται από τον πάροχο φιλοξενίας σας"

#: includes/class-admin.php:1108
msgid "active"
msgstr "Ενεργό"

#: includes/class-admin.php:1110
msgid "inactive"
msgstr "Ανενεργό"

#: includes/class-admin.php:1115
msgid "LiteSpeed cache:"
msgstr "Προσωρινή μνήμη LiteSpeed:"

#: includes/class-admin.php:1117
msgid "Redis object cache:"
msgstr "Προσωρινή μνήμη αντικειμένων Redis:"

#: includes/class-object-cache.php:256
msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Η επέκταση PHP του Redis (phpredis) δεν είναι διαθέσιμη σε αυτόν τον διακομιστή, επομένως η προσωρινή μνήμη αντικειμένων δεν μπορεί να ενεργοποιηθεί."

#: includes/class-object-cache.php:263
msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn® object cache."
msgstr "Ένα άλλο drop-in της προσωρινής μνήμης αντικειμένων (object-cache) είναι ήδη εγκατεστημένο. Αφαιρέστε το πριν ενεργοποιήσετε την προσωρινή μνήμη αντικειμένων Zinn®."

#: includes/class-object-cache.php:275
msgid "Could not write the Redis connection configuration file."
msgstr "Δεν ήταν δυνατή η εγγραφή του αρχείου ρυθμίσεων σύνδεσης Redis."

#: includes/class-object-cache.php:283
msgid "The bundled object-cache drop-in could not be read."
msgstr "Δεν ήταν δυνατή η ανάγνωση του ενσωματωμένου drop-in object-cache."

#: includes/class-object-cache.php:290
msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Δεν ήταν δυνατή η εγκατάσταση του drop-in object-cache στο wp-content."

#: includes/class-object-cache.php:316
msgid "Could not remove the object-cache drop-in."
msgstr "Δεν ήταν δυνατή η αφαίρεση του drop-in object-cache."

#: includes/class-object-cache.php:412
msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "Το σύστημα αρχείων του WordPress δεν είναι εγγράψιμο, επομένως δεν ήταν δυνατή η διαχείριση του object-cache drop-in."

#: includes/class-page-cache.php:362
msgid "Another page-cache plugin has installed wp-content/advanced-cache.php. Remove that plugin first, or keep using its page cache."
msgstr "Ένα άλλο πρόσθετο προσωρινής μνήμης σελίδων έχει εγκαταστήσει το wp-content/advanced-cache.php. Παρακαλούμε αφαιρέστε πρώτα αυτό το πρόσθετο ή συνεχίστε να χρησιμοποιείτε τη δική του προσωρινή μνήμη σελίδων."

#: includes/class-page-cache.php:365
msgid "The folder wp-content/cache/zinn-cache could not be written, so pages cannot be cached."
msgstr "Δεν ήταν δυνατή η εγγραφή στον φάκελο wp-content/cache/zinn-cache, επομένως οι σελίδες δεν μπορούν να αποθηκευτούν στην προσωρινή μνήμη."

#: includes/class-page-cache.php:372
msgid "wp-content/advanced-cache.php could not be written, so pages cannot be cached."
