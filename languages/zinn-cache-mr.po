msgstr ""
"Project-Id-Version: zinn-cache\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: mr\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: zinn-cache\n"

msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) पूर्ण-पृष्ठ कॅशेसाठी सर्व्हर-साइड कॅशे नियंत्रण — मजकूर बदलल्यावर स्मार्ट स्वयं-पर्ज, Redis ऑब्जेक्ट-कॅशे टॉगल आणि सुरक्षित WordPress/WooCommerce कॅशे वगळणुका यांसह. Zinn Digital होस्टिंग-प्लॅटफॉर्म डिप्लॉय फूटप्रिंटचा भाग."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "तुम्हाला कॅशे पर्ज करण्याची परवानगी नाही."

msgid "Cache purge requested."
msgstr "कॅशे पर्जची विनंती केली."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: आणखी एक ऑब्जेक्ट-कॅशे ड्रॉप-इन स्थापित आहे, त्यामुळे Redis ऑब्जेक्ट कॅशे या प्लगइनद्वारे व्यवस्थापित केला जात नाही."

msgid "Full-page cache (LiteSpeed)"
msgstr "पूर्ण-पृष्ठ कॅशे (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache नियंत्रण सक्षम करा"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "कॅशे करण्यायोग्य पृष्ठांवर LiteSpeed कॅशे-कंट्रोल आणि टॅग हेडर पाठवा."

msgid "Public cache lifetime (seconds)"
msgstr "सार्वजनिक कॅशे कालावधी (सेकंद)"

msgid "Object cache (Redis)"
msgstr "ऑब्जेक्ट कॅशे (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis ऑब्जेक्ट कॅशे सक्षम करा"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis ऑब्जेक्ट-कॅशे ड्रॉप-इन स्थापित करा (phpredis एक्स्टेंशन आवश्यक आहे)."

msgid "Redis host"
msgstr "Redis होस्ट"

msgid "Redis port"
msgstr "Redis पोर्ट"

msgid "Redis database"
msgstr "Redis डेटाबेस"

msgid "Redis key prefix"
msgstr "Redis की प्रिफिक्स"

msgid "Automatic purging"
msgstr "स्वयंचलित पर्जिंग"

msgid "Smart auto-purge"
msgstr "स्मार्ट स्वयं-पर्ज"

msgid "Purge affected pages automatically when content changes."
msgstr "मजकूर बदलल्यावर प्रभावित पृष्ठे आपोआप पर्ज करा."

msgid "Purge on updates"
msgstr "अपडेट्सवर पर्ज करा"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "कोअर, प्लगइन किंवा थीम अपडेट्सनंतर सर्व काही पर्ज करा."

msgid "Cache exclusions"
msgstr "कॅशे वगळणुका"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "विवेकपूर्ण WordPress आणि WooCommerce डीफॉल्ट नेहमी लागू केले जातात (कार्ट, चेकआउट, my-account, लॉग-इन आणि सेशन पृष्ठे कधीही कॅशे केली जात नाहीत). खाली अतिरिक्त नियम जोडा, प्रत्येक ओळीत एक."

msgid "Exclude URL paths (prefix match)"
msgstr "URL पथ वगळा (प्रिफिक्स जुळणी)"

msgid "Exclude query keys"
msgstr "क्वेरी की वगळा"

msgid "Exclude cookie name prefixes"
msgstr "कुकी नाव प्रिफिक्स वगळा"

msgid "Maintenance"
msgstr "देखभाल"

msgid "Purge everything now"
msgstr "आता सर्व काही पर्ज करा"

msgid "detected"
msgstr "आढळले"

msgid "not detected"
msgstr "आढळले नाही"

msgid "phpredis extension missing"
msgstr "phpredis एक्स्टेंशन उपलब्ध नाही"

msgid "active"
msgstr "सक्रिय"

msgid "inactive"
msgstr "निष्क्रिय"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed कॅशे:"

msgid "Redis object cache:"
msgstr "Redis ऑब्जेक्ट कॅशे:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "या सर्व्हरवर Redis PHP एक्स्टेंशन (phpredis) उपलब्ध नाही, त्यामुळे ऑब्जेक्ट कॅशे सक्षम करता येत नाही."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "आणखी एक ऑब्जेक्ट-कॅशे ड्रॉप-इन आधीच स्थापित आहे. Zinn ऑब्जेक्ट कॅशे सक्षम करण्यापूर्वी ते काढून टाका."

msgid "Could not write the Redis connection configuration file."
msgstr "Redis कनेक्शन कॉन्फिगरेशन फाइल लिहिता आली नाही."

msgid "The bundled object-cache drop-in could not be read."
msgstr "बंडल केलेले ऑब्जेक्ट-कॅशे ड्रॉप-इन वाचता आले नाही."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ऑब्जेक्ट-कॅशे ड्रॉप-इन wp-content मध्ये स्थापित करता आले नाही."

msgid "Could not remove the object-cache drop-in."
msgstr "ऑब्जेक्ट-कॅशे ड्रॉप-इन काढता आले नाही."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress फाइलसिस्टम लिहिण्यायोग्य नाही, त्यामुळे ऑब्जेक्ट-कॅशे ड्रॉप-इन व्यवस्थापित करता आले नाही."

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital रिलीज नोट्स पहा."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "डाउनलोड केलेले अपडेट त्याच्या अखंडता तपासणीत अयशस्वी झाले आणि ते स्थापित केले गेले नाही."
