msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "Serverska kontrola keša za LiteSpeed (LSCache) keš cele stranice — sa pametnim automatskim pražnjenjem pri promeni sadržaja, prekidačem za Redis keš objekata i bezbednim izuzecima keša za WordPress/WooCommerce. Deo je otiska za primenu na Zinn Digital hosting platformi."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — izvršni direktor, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "Nije vam dozvoljeno da ispraznite keš."

msgid "Cache purge requested."
msgstr "Zatraženo je pražnjenje keša."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: instaliran je drugi drop-in za keš objekata, pa ovim dodatkom nije upravljan Redis keš objekata."

msgid "Full-page cache (LiteSpeed)"
msgstr "Keš cele stranice (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "Omogući LSCache kontrolu"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "Šalji LiteSpeed cache-control i tag zaglavlja na stranicama koje se mogu keširati."

msgid "Public cache lifetime (seconds)"
msgstr "Trajanje javnog keša (sekunde)"

msgid "Object cache (Redis)"
msgstr "Keš objekata (Redis)"

msgid "Enable Redis object cache"
msgstr "Omogući Redis keš objekata"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Instaliraj drop-in za Redis keš objekata (zahteva phpredis ekstenziju)."

msgid "Redis host"
msgstr "Redis host"

msgid "Redis port"
msgstr "Redis port"

msgid "Redis database"
msgstr "Redis baza podataka"

msgid "Redis key prefix"
msgstr "Prefiks Redis ključa"

msgid "Automatic purging"
msgstr "Automatsko pražnjenje"

msgid "Smart auto-purge"
msgstr "Pametno automatsko pražnjenje"

msgid "Purge affected pages automatically when content changes."
msgstr "Automatski isprazni pogođene stranice kada se sadržaj promeni."

msgid "Purge on updates"
msgstr "Isprazni pri ažuriranjima"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "Isprazni sve nakon ažuriranja jezgra, dodataka ili tema."

msgid "Cache exclusions"
msgstr "Izuzeci keša"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "Razumne podrazumevane vrednosti za WordPress i WooCommerce se uvek primenjuju (korpa, naplata, moj-nalog, prijavljene i sesijske stranice se nikada ne keširaju). Dodajte dodatna pravila ispod, po jedno u redu."

msgid "Exclude URL paths (prefix match)"
msgstr "Izuzmi URL putanje (poklapanje prefiksa)"

msgid "Exclude query keys"
msgstr "Izuzmi ključeve upita"

msgid "Exclude cookie name prefixes"
msgstr "Izuzmi prefikse imena kolačića"

msgid "Maintenance"
msgstr "Održavanje"

msgid "Purge everything now"
msgstr "Isprazni sve odmah"

msgid "detected"
msgstr "otkriveno"

msgid "not detected"
msgstr "nije otkriveno"

msgid "phpredis extension missing"
msgstr "phpredis ekstenzija nedostaje"

msgid "active"
msgstr "aktivno"

msgid "inactive"
msgstr "neaktivno"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed keš:"

msgid "Redis object cache:"
msgstr "Redis keš objekata:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis PHP ekstenzija (phpredis) nije dostupna na ovom serveru, pa keš objekata ne može biti omogućen."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "Već je instaliran drugi drop-in za keš objekata. Uklonite ga pre nego što omogućite Zinn keš objekata."

msgid "Could not write the Redis connection configuration file."
msgstr "Nije moguće upisati konfiguracionu datoteku Redis veze."

msgid "The bundled object-cache drop-in could not be read."
msgstr "Priloženi drop-in za keš objekata nije mogao biti pročitan."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Nije moguće instalirati drop-in za keš objekata u wp-content."

msgid "Could not remove the object-cache drop-in."
msgstr "Nije moguće ukloniti drop-in za keš objekata."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress datotečni sistem nije upisiv, pa se drop-in za keš objekata nije mogao upravljati."

msgid "See the Zinn Digital release notes."
msgstr "Pogledajte napomene o izdanju Zinn Digital."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Преузето ажурирање није прошло проверу интегритета и није инсталирано."
