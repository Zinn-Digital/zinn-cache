msgid "VS Code: put the same entry under \"servers\" in .vscode/mcp.json, not under \"mcpServers\"."
msgstr "VS Code: letak entri yang sama di bawah \"servers\" dalam .vscode/mcp.json, bukan di bawah \"mcpServers\"."

