msgstr "Zinn Digital®"

#: includes/class-zinn-cache-admin-ui.php:294
msgid "Zinn Digital® — overview"
msgstr "Zinn Digital® — gambaran keseluruhan"

#: includes/class-zinn-cache-admin-ui.php:295
msgid "Overview"
msgstr "Gambaran Keseluruhan"

#: includes/class-zinn-cache-admin-ui.php:383
msgid "Copied"
msgstr "Disalin"

#: includes/class-zinn-cache-admin-ui.php:422
msgid "Every Zinn® plugin on this site, and whether it is working."
msgstr "Setiap pelantar Zinn® di tapak ini, dan sama ada ia berfungsi."

#: includes/class-zinn-cache-admin-ui.php:437
msgid "No connection is needed for this plugin."
msgstr "Tiada sambungan diperlukan untuk palam masuk ini."

#: includes/class-zinn-cache-admin-ui.php:442
msgid "Open settings"
msgstr "Buka tetapan"

#: includes/class-zinn-cache-admin-ui.php:770
#: includes/class-zinn-cache-admin-ui.php:1331
msgid "You do not have permission to change these settings."
msgstr "Anda tidak mempunyai kebenaran untuk mengubah tetapan ini."

#: includes/class-zinn-cache-admin-ui.php:799
msgid "Settings sections"
msgstr "Bahagian tetapan"

#: includes/class-zinn-cache-admin-ui.php:871
msgid "Support"
msgstr "Sokongan"

#: includes/class-zinn-cache-admin-ui.php:929
msgid "Save changes"
msgstr "Simpan perubahan"

#: includes/class-zinn-cache-admin-ui.php:958
msgid "Tools"
msgstr "Alatan"

#: includes/class-zinn-cache-admin-ui.php:973
msgid "Export settings"
msgstr "Eksport tetapan"

#: includes/class-zinn-cache-admin-ui.php:976
msgid "Reset to defaults"
msgstr "Tetapkan semula kepada lalai"

#: includes/class-zinn-cache-admin-ui.php:977
msgid "This puts every setting on this plugin back to its default. Continue?"
msgstr "Ini akan menetapkan semula setiap tetapan pada palam ini kepada lalai. Teruskan?"

#: includes/class-zinn-cache-admin-ui.php:984
msgid "Diagnostics for support"
msgstr "Diagnostik untuk sokongan"

#: includes/class-zinn-cache-admin-ui.php:993
msgid "Import a settings file"
msgstr "Import fail tetapan"

#: includes/class-zinn-cache-admin-ui.php:995
msgid "Import"
msgstr "Import"

#: includes/class-zinn-cache-admin-ui.php:997
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "Fail yang dieksport tidak mengandungi kata laluan, token atau kunci API — anda perlu memasukkannya semula pada tapak baharu itu."

#: includes/class-zinn-cache-admin-ui.php:1096
msgid "Settings saved."
msgstr "Tetapan disimpan."

#: includes/class-zinn-cache-admin-ui.php:1143
msgid "Every setting on this plugin is back to its default."
msgstr "Setiap tetapan pada palam ini telah dikembalikan kepada lalai."

#: includes/class-zinn-cache-admin-ui.php:1186
msgid "Done."
msgstr "Selesai."

#: includes/class-zinn-cache-admin-ui.php:1190
msgid "That action is not available."
msgstr "Tindakan tersebut tidak tersedia."

#: includes/class-zinn-cache-admin-ui.php:1257
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "Fail tersebut tidak dapat dibaca. Pilih fail tetapan yang dieksport daripada pelatah Zinn®."

#: includes/class-zinn-cache-admin-ui.php:1265
msgid "That file is too large to be a settings export."
msgstr "Fail itu terlalu besar untuk menjadi eksport tetapan."

#: includes/class-zinn-cache-admin-ui.php:1278
msgid "That file is not a Zinn® settings export."
msgstr "Fail tersebut bukanlah eksport tetapan Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-cache-admin-ui.php:1286
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Fail itu dieksport daripada plugin lain (%s), jadi mengimportnya di sini akan menyimpan tetapan yang tidak difahami oleh plugin ini."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-cache-admin-ui.php:1316
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d tetapan diimport. Kata laluan dan kunci API tidak disertakan dalam eksport, jadi sila masukkan semula butiran tersebut."

#: includes/class-zinn-cache-connection.php:58
msgid "Connected"
msgstr "Disambungkan"

#: includes/class-zinn-cache-connection.php:60
msgid "Connecting…"
msgstr "Sedang menyambung…"

#: includes/class-zinn-cache-connection.php:62
msgid "Connected, but something needs attention"
msgstr "Disambungkan, tetapi ada sesuatu yang memerlukan perhatian"

