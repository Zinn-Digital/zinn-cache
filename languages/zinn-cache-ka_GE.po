msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "სერვერის მხარეს კეშის მართვა LiteSpeed-ის (LSCache) სრული გვერდის კეშისთვის — შიგთავსის შეცვლისას ჭკვიანი ავტომატური გასუფთავებით, Redis-ის ობიექტ-კეშის გადამრთველითა და WordPress/WooCommerce-ის კეშის უსაფრთხო გამონაკლისებით. Zinn Digital-ის ჰოსტინგ-პლატფორმის განთავსების footprint-ის ნაწილი."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "თქვენ არ გაქვთ კეშის გასუფთავების უფლება."

msgid "Cache purge requested."
msgstr "მოთხოვნილია კეშის გასუფთავება."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: დაინსტალირებულია სხვა ობიექტ-კეშის drop-in, ამიტომ Redis-ის ობიექტ-კეშს ეს მოდული არ მართავს."

msgid "Full-page cache (LiteSpeed)"
msgstr "სრული გვერდის კეში (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache-ის მართვის ჩართვა"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "LiteSpeed-ის cache-control და tag სათაურების გაგზავნა კეშირებად გვერდებზე."

msgid "Public cache lifetime (seconds)"
msgstr "საჯარო კეშის სიცოცხლის ხანგრძლივობა (წამებში)"

msgid "Object cache (Redis)"
msgstr "ობიექტ-კეში (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis-ის ობიექტ-კეშის ჩართვა"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis-ის ობიექტ-კეშის drop-in-ის დაინსტალირება (საჭიროებს phpredis გაფართოებას)."

msgid "Redis host"
msgstr "Redis-ის ჰოსტი"

msgid "Redis port"
msgstr "Redis-ის პორტი"

msgid "Redis database"
msgstr "Redis-ის მონაცემთა ბაზა"

msgid "Redis key prefix"
msgstr "Redis-ის გასაღების პრეფიქსი"

msgid "Automatic purging"
msgstr "ავტომატური გასუფთავება"

msgid "Smart auto-purge"
msgstr "ჭკვიანი ავტომატური გასუფთავება"

msgid "Purge affected pages automatically when content changes."
msgstr "შიგთავსის შეცვლისას დაზარალებული გვერდების ავტომატური გასუფთავება."

msgid "Purge on updates"
msgstr "გასუფთავება განახლებებისას"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "ბირთვის, მოდულის ან თემის განახლების შემდეგ ყველაფრის გასუფთავება."

msgid "Cache exclusions"
msgstr "კეშის გამონაკლისები"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "WordPress-ისა და WooCommerce-ის გონივრული ნაგულისხმევი პარამეტრები ყოველთვის გამოიყენება (კალათა, გადახდა, ჩემი ანგარიში, ავტორიზებული და სესიის გვერდები არასოდეს კეშირდება). დაამატეთ დამატებითი წესები ქვემოთ, თითო თითო ხაზზე."

msgid "Exclude URL paths (prefix match)"
msgstr "URL-მისამართების გამორიცხვა (პრეფიქსით დამთხვევა)"

msgid "Exclude query keys"
msgstr "მოთხოვნის (query) გასაღებების გამორიცხვა"

msgid "Exclude cookie name prefixes"
msgstr "cookie-ს სახელის პრეფიქსების გამორიცხვა"

msgid "Maintenance"
msgstr "ტექნიკური მომსახურება"

msgid "Purge everything now"
msgstr "ყველაფრის გასუფთავება ახლა"

msgid "detected"
msgstr "აღმოჩენილია"

msgid "not detected"
msgstr "ვერ აღმოჩნდა"

msgid "phpredis extension missing"
msgstr "phpredis გაფართოება არ არის"

msgid "active"
msgstr "აქტიური"

msgid "inactive"
msgstr "არააქტიური"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed-ის კეში:"

msgid "Redis object cache:"
msgstr "Redis-ის ობიექტ-კეში:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis-ის PHP გაფართოება (phpredis) ამ სერვერზე ხელმისაწვდომი არ არის, ამიტომ ობიექტ-კეშის ჩართვა შეუძლებელია."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "სხვა ობიექტ-კეშის drop-in უკვე დაინსტალირებულია. წაშალეთ იგი Zinn-ის ობიექტ-კეშის ჩართვამდე."

msgid "Could not write the Redis connection configuration file."
msgstr "Redis-ის კავშირის კონფიგურაციის ფაილის ჩაწერა ვერ მოხერხდა."

msgid "The bundled object-cache drop-in could not be read."
msgstr "თანდართული ობიექტ-კეშის drop-in-ის წაკითხვა ვერ მოხერხდა."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ობიექტ-კეშის drop-in-ის wp-content-ში დაინსტალირება ვერ მოხერხდა."

msgid "Could not remove the object-cache drop-in."
msgstr "ობიექტ-კეშის drop-in-ის წაშლა ვერ მოხერხდა."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress-ის ფაილური სისტემა ჩაწერადი არ არის, ამიტომ ობიექტ-კეშის drop-in-ის მართვა ვერ მოხერხდა."

msgid "See the Zinn Digital release notes."
msgstr "იხილეთ Zinn Digital-ის გამოშვების შენიშვნები."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ჩამოტვირთულმა განახლებამ მთლიანობის შემოწმება ვერ გაიარა და არ დაინსტალირდა."
