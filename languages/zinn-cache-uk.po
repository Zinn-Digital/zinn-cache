#. Plugin Name of the plugin
#: zinn-cache.php
msgid "Zinn® Cache"
msgstr "Zinn® Cache"

#. Plugin URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-cache"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-cache"

#. Description of the plugin
#: zinn-cache.php
msgid "For sites hosted with Zinn Digital®. Controls the page cache your Zinn® server already provides — smart auto-purge on content change, remote purge from your Zinn® dashboard, a Redis object-cache toggle, safe WordPress/WooCommerce exclusions, and one-click admin login. This is a cache controller, not a cache engine. Hosting elsewhere? Install Zinn® Cache Engine instead."
msgstr "Для сайтів, розміщених на хостингу Zinn Digital®. Керує кешем сторінок, який уже надає ваш сервер Zinn®: розумне автоочищення при зміні контенту, віддалене очищення з вашої панелі керування Zinn®, перемикач об'єктного кешу Redis, безпечні виключення для WordPress/WooCommerce та вхід адміністратора в один клік. Це контролер кешу, а не двигун кешування. Розміщуєте хостинг в іншому місці? Натомість встановіть двигун кешування Zinn® Cache Engine."

#. Author of the plugin
#: zinn-cache.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:104
msgid "Cache"
msgstr "Кеш"

#: includes/class-admin.php:110
#: includes/class-admin.php:153
msgid "Page cache"
msgstr "Кеш сторінки"

#: includes/class-admin.php:114
#: includes/class-admin.php:226
msgid "Object cache"
msgstr "Об'єктний кеш"

#: includes/class-admin.php:118
msgid "Purging"
msgstr "Очищення"

#: includes/class-admin.php:122
msgid "Exclusions"
msgstr "Винятки"

#: includes/class-admin.php:129
msgid "Purge everything now"
msgstr "Очистити все зараз"

#. zinn-i18n: not translated — NeedsHumanTranslationError: uk translation contains 'відвідування', a token that repeats its own opening — the shape of `revrevendeur` for
#: includes/class-admin.php:130
msgid "Every cached page is discarded and will be rebuilt as visitors arrive. Continue?"
msgstr ""

#: includes/class-admin.php:147
msgid "Full-page cache"
msgstr "Повносторінковий кеш"

#: includes/class-admin.php:148
msgid "Served by LiteSpeed at the web server, before WordPress runs. This is where nearly all the speed comes from."
msgstr "Обробляється LiteSpeed на веб-сервері до запуску WordPress. Саме звідси береться майже вся швидкість."

#: includes/class-admin.php:154
msgid "Send LiteSpeed cache-control and tag headers on cacheable pages"
msgstr "Надсилати заголовки LiteSpeed cache-control та tag для кешованих сторінок"

#: includes/class-admin.php:160
msgid "How long a page stays cached"
msgstr "Як довго сторінка залишається в кеші"

#: includes/class-admin.php:161
msgid "Seconds. A week suits most sites; a news site publishing hourly wants far less."
msgstr "Секунди. Для більшості сайтів підходить тиждень; новинний сайт, що публікується щогодини, потребує значно менше."

#. zinn-i18n: not translated — NeedsHumanTranslationError: uk translation contains 'відвідувача', a token that repeats its own opening — the shape of `revrevendeur` for
#: includes/class-admin.php:170
msgid "How long a visitor’s browser keeps images and scripts"
msgstr ""

#: includes/class-admin.php:171
msgid "Seconds. Applies to images, CSS and JavaScript only — never to pages. Set to 0 to leave this to your host."
msgstr "Секунди. Застосовується лише до зображень, CSS та JavaScript — ніколи до сторінок. Установіть значення 0, щоб залишити це на розсуд вашого хоста."

#: includes/class-admin.php:179
msgid "Signed-in visitors"
msgstr "Користувачі, які увійшли в систему"

#. zinn-i18n: not translated — NeedsHumanTranslationError: uk translation contains 'відвідувачу', a token that repeats its own opening — the shape of `revrevendeur` for
#: includes/class-admin.php:180
msgid "Never serve a cached page to a signed-in visitor"
msgstr ""

#: includes/class-admin.php:181
msgid "On is the safe answer and the default. Turn it off only if you know every cached page is identical for every signed-in user — a membership site is the usual reason not to."
msgstr "Увімкнено — це безпечний варіант за замовчуванням. Вимикайте це лише тоді, коли ви впевнені, що кожна кешована сторінка є ідентичною для кожного авторизованого користувача (сайт із членством зазвичай є причиною для цього)."

#: includes/class-admin.php:187
msgid "Different lifetimes for different content"
msgstr "Різний час життя для різного контенту"

#: includes/class-admin.php:188
msgid "For example: a shop’s product pages for an hour, while everything else stays a week."
msgstr "Наприклад: сторінки товарів магазину протягом години, тоді як усе інше залишається на тиждень."

#: includes/class-admin.php:189
msgid "Add a rule"
msgstr "Додати правило"

#: includes/class-admin.php:196
msgid "Content type"
msgstr "Тип вмісту"

#: includes/class-admin.php:202
msgid "Seconds"
msgstr "Секунди"

#: includes/class-admin.php:220
msgid "Object cache (Redis)"
msgstr "Об'єктний кеш (Redis)"

#: includes/class-admin.php:221
msgid "Caches the results of database queries. It helps most on a busy shop or a site with a lot of signed-in traffic, where the page cache cannot."
msgstr "Кешує результати запитів до бази даних. Це найбільше допомагає в завантаженому магазині або на сайті з великим трафіком авторизованих користувачів, де кеш сторінок не працює."

#: includes/class-admin.php:227
msgid "Install the Redis object-cache drop-in"
msgstr "Установити модуль об'єктного кешу Redis"

#: includes/class-admin.php:228
msgid "Needs the phpredis extension. If it is missing, the box above this screen says so."
msgstr "Потрібно мати розширення phpredis. Якщо воно відсутнє, поле вище на цьому екрані повідомить про це."

#: includes/class-admin.php:234
msgid "Redis host"
msgstr "Хост Redis"

#: includes/class-admin.php:241
msgid "Redis port"
msgstr "Порт Redis"

#: includes/class-admin.php:250
msgid "Redis database"
msgstr "База даних Redis"

#: includes/class-admin.php:251
msgid "Give each site on a shared Redis its own number, or they will clear each other’s cache."
msgstr "Призначте кожному сайту на спільному Redis власний номер, інакше вони очищатимуть кеш один одного."

#: includes/class-admin.php:261
msgid "Redis password"
msgstr "Пароль Redis"

#: includes/class-admin.php:262
msgid "Leave blank if your Redis does not need one."
msgstr "Залиште порожнім, якщо для вашого Redis він не потрібен."

#: includes/class-admin.php:269
msgid "Key prefix"
msgstr "Префікс ключа"

#: includes/class-admin.php:270
msgid "An alternative to a separate database number when you cannot have one."
msgstr "Альтернатива окремому номеру бази даних, якщо ви не можете його отримати."

#: includes/class-admin.php:287
msgid "Smart auto-purge"
msgstr "Розумне автоматичне очищення"

#: includes/class-admin.php:288
msgid "Clear affected pages automatically when content changes"
msgstr "Автоматично очищувати уражені сторінки під час зміни контенту"

#: includes/class-admin.php:294
msgid "After updates"
msgstr "Після оновлень"

#: includes/class-admin.php:295
msgid "Clear everything after a core, plugin or theme update"
msgstr "Очистити все після оновлення ядрового компонента, плагіна чи теми"

#: includes/class-admin.php:301
msgid "After a comment"
msgstr "Після коментаря"

#: includes/class-admin.php:302
msgid "Clear a post’s page when a comment on it is approved"
msgstr "Очистити сторінку допису, коли схвалено коментар до нього"

#: includes/class-admin.php:303
msgid "Turn this off on a very busy comment section, where it can clear the same page hundreds of times an hour."
msgstr "Вимкніть це в дуже активному розділі коментарів, де він може очищати ту саму сторінку сотні разів на годину."

#: includes/class-admin.php:318
msgid "Never cache these"
msgstr "Ніколи не кешувати"

#: includes/class-admin.php:319
msgid "Sensible WordPress and WooCommerce defaults are always applied — cart, checkout, my-account and any signed-in session are never cached, whatever is below."
msgstr "Розумні налаштування за замовчуванням для WordPress та WooCommerce завжди застосовуються — кошик, оформлення замовлення, мій акаунт і будь-який сеанс увійшовшого користувача ніколи не кешуються, незалежно від того, що знаходиться нижче."

#: includes/class-admin.php:325
msgid "Addresses"
msgstr "Адреси"

#: includes/class-admin.php:326
msgid "One path per line, for example <code>/basket</code>. A trailing <code>*</code> matches everything under it."
msgstr "Одна путь на рядок, наприклад <code>/basket</code>. Кінцева зірочка <code>*</code> відповідає всьому, що міститься під нею."

#: includes/class-admin.php:334
msgid "Query parameters"
msgstr "Параметри запиту"

#: includes/class-admin.php:335
msgid "A page carrying one of these is never cached — for example a one-time preview token."
msgstr "Сторінка з таким елементом ніколи не кешується — наприклад, одноразовий токен попереднього перегляду."

#: includes/class-admin.php:343
msgid "Cookies"
msgstr "Файли cookie"

#. zinn-i18n: not translated — NeedsHumanTranslationError: uk translation contains 'Відвідувачу', a token that repeats its own opening — the shape of `revrevendeur` for
#: includes/class-admin.php:344
msgid "A visitor carrying one of these is always served a fresh page."
msgstr ""

#. zinn-i18n: not translated — NeedsHumanTranslationError: uk translation contains 'відвідувачі', a token that repeats its own opening — the shape of `revrevendeur` for
#: includes/class-admin.php:373
msgid "Every cached page has been discarded. They will be rebuilt as visitors arrive."
msgstr ""

#: includes/class-admin.php:396
msgid "The page cache is on, but this server is not LiteSpeed."
msgstr "Кеш сторінки ввімкнено, але цей сервер не є LiteSpeed."

#: includes/class-admin.php:397
msgid "The cache headers are being sent and nothing is reading them, so pages are not actually being cached. Ask your host whether LiteSpeed is available, or move to Zinn® hosting where it is standard."
msgstr "Заголовки кешу надсилаються, але їх ніхто не зчитує, тому сторінки насправді не кешуються. Запитайте свого хостера, чи доступний LiteSpeed, або переходьте на хостинг Zinn®, де це є стандартом."

#: includes/class-admin.php:405
msgid "The object cache is on, but this server has no Redis support."
msgstr "Кеш об'єктів увімкнено, але цей сервер не підтримує Redis."

#: includes/class-admin.php:406
msgid "The phpredis extension is not installed, so the drop-in cannot be used and WordPress is falling back to its own in-memory cache. Ask your host to enable phpredis."
msgstr "Розширення phpredis не встановлено, тому цей компонент не може використовуватися, і WordPress переходить на власний кеш у пам'яті. Зверніться до свого хостинг-провайдера, щоб увімкнути phpredis."

#: includes/class-admin.php:414
msgid "Nothing is being cached."
msgstr "Нічого не кешується."

#: includes/class-admin.php:415
msgid "Both caches are switched off, so this plugin is not making the site any faster."
msgstr "Обидва кеші вимкнені, тому цей плагін не прискорює сайт."

#: includes/class-admin.php:422
msgid "Caching is active on this site."
msgstr "Кешування активне на цьому сайті."

#: includes/class-admin.php:438
msgid "Web server"
msgstr "Вебсервер"

#: includes/class-admin.php:440
msgid "LiteSpeed — page caching available"
msgstr "LiteSpeed — доступне кешування сторінок"

#: includes/class-admin.php:441
msgid "not LiteSpeed — page caching unavailable"
msgstr "не LiteSpeed — кешування сторінок недоступне"

#: includes/class-admin.php:444
msgid "Redis support"
msgstr "Підтримка Redis"

#: includes/class-admin.php:446
msgid "phpredis is installed"
msgstr "phpredis встановлено"

#: includes/class-admin.php:447
msgid "phpredis is not installed"
msgstr "phpredis не встановлено"

#: includes/class-admin.php:450
msgid "Page lifetime"
msgstr "Час життя сторінки"

#: includes/class-admin.php:525
msgid "You are not allowed to purge the cache."
msgstr "Вам не дозволено очищати кеш."

#: includes/class-admin.php:531
msgid "Cache purge requested."
msgstr "Запит на очищення кешу надіслано."

#: includes/class-admin.php:559
msgid "Zinn® Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Кеш Zinn®: встановлено інший об'єктний кеш, тому об'єктним кешем Redis не керує цей плагін."

#: includes/class-admin.php:573
msgid "detected"
msgstr "виявлено"

#: includes/class-admin.php:574
msgid "not detected"
msgstr "не виявлено"

#: includes/class-admin.php:577
msgid "phpredis extension missing"
msgstr "розширення phpredis відсутнє"

#: includes/class-admin.php:579
msgid "active"
msgstr "активний"

#: includes/class-admin.php:581
msgid "inactive"
msgstr "неактивний"

#: includes/class-admin.php:586
msgid "LiteSpeed cache:"
msgstr "Кеш LiteSpeed:"

#: includes/class-admin.php:588
msgid "Redis object cache:"
msgstr "Об'єктний кеш Redis:"

#: includes/class-object-cache.php:118
msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Розширення Redis для PHP (phpredis) недоступне на цьому сервері, тому об'єктний кеш неможливо увімкнути."

#: includes/class-object-cache.php:125
msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn® object cache."
msgstr "Інший drop-in об'єктного кешу вже встановлено. Видаліть його перед тим, як увімкнути об'єктний кеш Zinn®."

#: includes/class-object-cache.php:137
msgid "Could not write the Redis connection configuration file."
msgstr "Не вдалося записати файл конфігурації підключення до Redis."

#: includes/class-object-cache.php:145
msgid "The bundled object-cache drop-in could not be read."
msgstr "Не вдалося прочитати вбудований drop-in об'єктного кешу."

#: includes/class-object-cache.php:152
msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Не вдалося встановити drop-in об'єктного кешу до wp-content."

#: includes/class-object-cache.php:173
msgid "Could not remove the object-cache drop-in."
msgstr "Не вдалося видалити drop-in об'єктного кешу."

#: includes/class-object-cache.php:262
msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "Файлова система WordPress недоступна для запису, тому drop-in об'єктного кешу неможливо налаштувати."

#: includes/class-sso.php:414
msgid "This one-click login link is not valid any more. Links expire after a couple of minutes and can only be used once — open your site from the Zinn® dashboard again to get a fresh one."
msgstr "Цей посилання для входу в один клік більше не дійсне. Посилання дійсні лише протягом кількох хвилин і можуть бути використані лише один раз — відкрийте свій сайт із панелі керування Zinn® знову, щоб отримати нове."

#: includes/class-updater.php:230
msgid "See the Zinn Digital® release notes."
msgstr "Перегляньте примітки до випуску Zinn Digital®."

#: includes/class-updater.php:285
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Завантажене оновлення не пройшло перевірку цілісності та не було встановлено."

#: includes/class-zinn-cache-admin-fields.php:575
msgid "Stored. Type a new value to replace it."
msgstr "Збережено. Введіть нове значення, щоб замінити його."

#: includes/class-zinn-cache-admin-fields.php:635
msgid "Filter this list…"
msgstr "Відфільтрувати цей список…"

#: includes/class-zinn-cache-admin-fields.php:636
msgid "Filter this list"
msgstr "Відфільтрувати цей список"

#: includes/class-zinn-cache-admin-fields.php:652
msgid "Nothing matches that filter."
msgstr "Нічого не відповідає цьому фільтру."

#: includes/class-zinn-cache-admin-fields.php:683
msgid "Add a row"
msgstr "Додати рядок"

#: includes/class-zinn-cache-admin-fields.php:720
msgid "Remove this row"
msgstr "Видалити цей рядок"

#: includes/class-zinn-cache-admin-fields.php:720
msgid "Remove"
msgstr "Видалити"

#: includes/class-zinn-cache-admin-ui.php:264
#: includes/class-zinn-cache-admin-ui.php:265
#: includes/class-zinn-cache-admin-ui.php:335
msgid "Zinn Digital®"
msgstr "Zinn Digital®"

#: includes/class-zinn-cache-admin-ui.php:278
msgid "Zinn Digital® — overview"
msgstr "Zinn Digital® — огляд"

#: includes/class-zinn-cache-admin-ui.php:279
msgid "Overview"
msgstr "Огляд"

#: includes/class-zinn-cache-admin-ui.php:336
msgid "Every Zinn® plugin on this site, and whether it is working."
msgstr "Кожен плагін Zinn® на цьому сайті та чи працює він."

#: includes/class-zinn-cache-admin-ui.php:352
msgid "No connection is needed for this plugin."
msgstr "Для цього плагіна не потрібне підключення."

#: includes/class-zinn-cache-admin-ui.php:357
msgid "Open settings"
msgstr "Відкрити налаштування"

#: includes/class-zinn-cache-admin-ui.php:685
#: includes/class-zinn-cache-admin-ui.php:1248
msgid "You do not have permission to change these settings."
msgstr "У вас немає прав на зміну цих налаштувань."

#: includes/class-zinn-cache-admin-ui.php:715
msgid "Settings sections"
msgstr "Розділи налаштувань"

#: includes/class-zinn-cache-admin-ui.php:788
msgid "Support"
msgstr "Підтримка"

#: includes/class-zinn-cache-admin-ui.php:846
msgid "Save changes"
msgstr "Зберегти зміни"

#: includes/class-zinn-cache-admin-ui.php:875
msgid "Tools"
msgstr "Інструменти"

#: includes/class-zinn-cache-admin-ui.php:890
msgid "Export settings"
msgstr "Експортувати налаштування"

#: includes/class-zinn-cache-admin-ui.php:893
msgid "Reset to defaults"
msgstr "Скинути до стандартних"

#: includes/class-zinn-cache-admin-ui.php:894
msgid "This puts every setting on this plugin back to its default. Continue?"
msgstr "Це відновтить усі налаштування цього плагіна до стандартних. Продовжити?"

#: includes/class-zinn-cache-admin-ui.php:901
msgid "Diagnostics for support"
msgstr "Діагностика для підтримки"

#: includes/class-zinn-cache-admin-ui.php:910
msgid "Import a settings file"
msgstr "Імпортувати файл налаштувань"

#: includes/class-zinn-cache-admin-ui.php:912
msgid "Import"
msgstr "Імпорт"

#: includes/class-zinn-cache-admin-ui.php:914
msgid "Exported files never contain passwords, tokens or API keys — you will need to enter those again on the new site."
msgstr "Експортовані файли ніколи не містять паролів, токенів чи ключів API — вам потрібно буде ввести їх знову на новому сайті."

#: includes/class-zinn-cache-admin-ui.php:1013
msgid "Settings saved."
msgstr "Налаштування збережено."

#: includes/class-zinn-cache-admin-ui.php:1060
msgid "Every setting on this plugin is back to its default."
msgstr "Усі налаштування цього плагіна відновлено за замовчуванням."

#: includes/class-zinn-cache-admin-ui.php:1103
msgid "Done."
msgstr "Готово."

#: includes/class-zinn-cache-admin-ui.php:1107
msgid "That action is not available."
msgstr "Ця дія недоступна."

#: includes/class-zinn-cache-admin-ui.php:1174
msgid "That file could not be read. Choose a settings file exported from a Zinn® plugin."
msgstr "Не вдалося прочитати цей файл. Виберіть файл налаштувань, експортирований із плагіна Zinn®."

#: includes/class-zinn-cache-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "Цей файл завеликий для експорту налаштувань."

#: includes/class-zinn-cache-admin-ui.php:1195
msgid "That file is not a Zinn® settings export."
msgstr "Цей файл не є експортом налаштувань Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-cache-admin-ui.php:1203
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Цей файл було експортовано з іншого плагіна (%s), тому його імпорт сюди збереже налаштування, які цей плагін не підтримує."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-cache-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "Імпортовано %d параметр. Паролі та ключі API ніколи не включаються до експорту, тому введіть їх знову."
msgstr[1] "%d налаштувань імпортовано. Паролі та ключі API ніколи не включаються в експорт, тому введіть їх знову."
msgstr[2] "%d налаштувань імпортовано. Паролі та ключі API ніколи не включаються в експорт, тому введіть їх знову."

