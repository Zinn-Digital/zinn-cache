msgstr "Bu dosya farklı bir eklentiden (%s) dışarı aktarıldığından, buraya içe aktarmak bu eklentinin anlamadığı ayarları kaydetmesine neden olur."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-cache-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d ayar içe aktarıldı. Parolalar ve API anahtarları hiçbir zaman dışa aktarıma dahil edilmez; bu yüzden bunları tekrar girin."
msgstr[1] "%d ayar içe aktarıldı. Parolalar ve API anahtarları asla dışa aktarıma dahil edilmez, bu nedenle bunları yeniden girin."

#: includes/class-zinn-cache-connection.php:58
msgid "Connected"
msgstr "Bağlı"

#: includes/class-zinn-cache-connection.php:60
msgid "Connecting…"
msgstr "Bağlanıyor…"

#: includes/class-zinn-cache-connection.php:62
msgid "Connected, but something needs attention"
msgstr "Bağlı, ancak bazı şeylerin ilgilenilmesi gerekiyor"

#: includes/class-zinn-cache-connection.php:64
msgid "Not connected"
msgstr "Bağlı değil"

#: includes/class-zinn-cache-connection.php:66
