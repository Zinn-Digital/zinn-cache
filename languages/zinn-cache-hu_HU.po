msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "Szerveroldali gyorsítótár-vezérlés a LiteSpeed (LSCache) teljesoldalas gyorsítótárához — intelligens automatikus ürítéssel a tartalom módosításakor, Redis objektum-gyorsítótár kapcsolóval és biztonságos WordPress/WooCommerce gyorsítótár-kizárásokkal. A Zinn Digital tárhelyplatform telepítési lábnyomának része."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — vezérigazgató, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "Nincs jogosultsága a gyorsítótár ürítéséhez."

msgid "Cache purge requested."
msgstr "Gyorsítótár ürítése kérve."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: egy másik objektum-gyorsítótár drop-in van telepítve, ezért a Redis objektum-gyorsítótárat nem ez a bővítmény kezeli."

msgid "Full-page cache (LiteSpeed)"
msgstr "Teljesoldalas gyorsítótár (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache-vezérlés engedélyezése"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "LiteSpeed gyorsítótár-vezérlő és tag fejlécek küldése a gyorsítótárazható oldalakon."

msgid "Public cache lifetime (seconds)"
msgstr "Nyilvános gyorsítótár élettartama (másodperc)"

msgid "Object cache (Redis)"
msgstr "Objektum-gyorsítótár (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis objektum-gyorsítótár engedélyezése"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "A Redis objektum-gyorsítótár drop-in telepítése (a phpredis kiterjesztést igényli)."

msgid "Redis host"
msgstr "Redis gazdagép"

msgid "Redis port"
msgstr "Redis port"

msgid "Redis database"
msgstr "Redis adatbázis"

msgid "Redis key prefix"
msgstr "Redis kulcselőtag"

msgid "Automatic purging"
msgstr "Automatikus ürítés"

msgid "Smart auto-purge"
msgstr "Intelligens automatikus ürítés"

msgid "Purge affected pages automatically when content changes."
msgstr "Az érintett oldalak automatikus ürítése a tartalom módosításakor."

msgid "Purge on updates"
msgstr "Ürítés frissítéskor"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "Minden ürítése a rendszermag, a bővítmények vagy a sablonok frissítése után."

msgid "Cache exclusions"
msgstr "Gyorsítótár-kizárások"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "Az ésszerű WordPress- és WooCommerce-alapértelmezések mindig érvényben vannak (a kosár, a pénztár, a fiókom, a bejelentkezett és a munkamenetes oldalak soha nem kerülnek gyorsítótárba). Adjon meg további szabályokat alább, soronként egyet."

msgid "Exclude URL paths (prefix match)"
msgstr "URL-útvonalak kizárása (előtag-egyezés)"

msgid "Exclude query keys"
msgstr "Lekérdezési kulcsok kizárása"

msgid "Exclude cookie name prefixes"
msgstr "Süti-név előtagok kizárása"

msgid "Maintenance"
msgstr "Karbantartás"

msgid "Purge everything now"
msgstr "Minden ürítése most"

msgid "detected"
msgstr "észlelve"

msgid "not detected"
msgstr "nincs észlelve"

msgid "phpredis extension missing"
msgstr "phpredis kiterjesztés hiányzik"

msgid "active"
msgstr "aktív"

msgid "inactive"
msgstr "inaktív"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed gyorsítótár:"

msgid "Redis object cache:"
msgstr "Redis objektum-gyorsítótár:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "A Redis PHP-kiterjesztés (phpredis) nem érhető el ezen a szerveren, ezért az objektum-gyorsítótár nem engedélyezhető."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "Már telepítve van egy másik objektum-gyorsítótár drop-in. Távolítsa el, mielőtt engedélyezné a Zinn objektum-gyorsítótárat."

msgid "Could not write the Redis connection configuration file."
msgstr "Nem sikerült írni a Redis-kapcsolat konfigurációs fájlját."

msgid "The bundled object-cache drop-in could not be read."
msgstr "A mellékelt objektum-gyorsítótár drop-in nem volt olvasható."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Nem sikerült telepíteni az objektum-gyorsítótár drop-int a wp-content mappába."

msgid "Could not remove the object-cache drop-in."
msgstr "Nem sikerült eltávolítani az objektum-gyorsítótár drop-int."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "A WordPress fájlrendszer nem írható, ezért az objektum-gyorsítótár drop-in nem volt kezelhető."

msgid "See the Zinn Digital release notes."
msgstr "Lásd a Zinn Digital kiadási megjegyzéseit."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "A letöltött frissítés nem ment át az integritásellenőrzésen, ezért nem lett telepítve."
