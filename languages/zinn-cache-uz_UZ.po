#. Plugin Name of the plugin
#: zinn-cache.php
#: includes/class-admin.php:79
#: includes/class-admin.php:80
#: includes/class-admin.php:189
msgid "Zinn® Cache"
msgstr "Zinn® Cache"

#. Plugin URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-cache"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-cache"

#. Description of the plugin
#: zinn-cache.php
msgid "For sites hosted with Zinn Digital®. Controls the page cache your Zinn® server already provides — smart auto-purge on content change, remote purge from your Zinn® dashboard, a Redis object-cache toggle, safe WordPress/WooCommerce exclusions, and one-click admin login. This is a cache controller, not a cache engine. Hosting elsewhere? Install Zinn® Cache Engine instead."
msgstr "Zinn Digital® da xosting qilingan saytlar uchun. Zinn® serveringiz allaqachon taqdim etadigan sahifa keshini boshqaradi — kontent o'zgarganda aqlli avtomatik tozalash, Zinn® boshqaruv panelidan masofadan turib tozalash, Redis ob'ekt keshini yoqish/o'chirish tugmasi, xavfsiz WordPress/WooCommerce istisnolari va bir marta bosish bilan administrator sifatida kirish. Bu kesh mexanizmi emas, balki kesh boshqaruvchisidir. Boshqa joyda xostingdan foydalanyapsizmi? Buning o'rniga Zinn® Cache Engine ni o'rnating."

#. Author of the plugin
#: zinn-cache.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:137
msgid "You are not allowed to purge the cache."
msgstr "Sizga keshni tozalashga ruxsat berilmagan."

#: includes/class-admin.php:143
msgid "Cache purge requested."
msgstr "Keshni tozalash soʻraldi."

#: includes/class-admin.php:171
msgid "Zinn® Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn® Kesh: boshqa obyekt-kesh plagin o'rnatilgan, shuning uchun Redis obyekt keshi ushbu plagin tomonidan boshqarilmaydi."

#: includes/class-admin.php:196
msgid "Full-page cache (LiteSpeed)"
msgstr "Toʻliq sahifa keshi (LiteSpeed)"

#: includes/class-admin.php:199
msgid "Enable LSCache control"
msgstr "LSCache boshqaruvini yoqish"

#: includes/class-admin.php:200
msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "Keshlanadigan sahifalarda LiteSpeed cache-control va tag sarlavhalarini yuborish."

#: includes/class-admin.php:204
msgid "Public cache lifetime (seconds)"
msgstr "Ommaviy kesh amal qilish muddati (soniyalarda)"

#: includes/class-admin.php:212
msgid "Object cache (Redis)"
msgstr "Obyekt keshi (Redis)"

#: includes/class-admin.php:215
msgid "Enable Redis object cache"
msgstr "Redis obyekt keshini yoqish"

#: includes/class-admin.php:216
msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis obyekt-kesh drop-in oʻrnatish (phpredis kengaytmasi talab qilinadi)."

#: includes/class-admin.php:219
msgid "Redis host"
msgstr "Redis host"

#: includes/class-admin.php:223
msgid "Redis port"
msgstr "Redis port"

#: includes/class-admin.php:227
msgid "Redis database"
msgstr "Redis maʼlumotlar bazasi"

#: includes/class-admin.php:231
msgid "Redis key prefix"
msgstr "Redis kalit prefiksi"

#: includes/class-admin.php:236
msgid "Automatic purging"
msgstr "Avtomatik tozalash"

#: includes/class-admin.php:239
msgid "Smart auto-purge"
msgstr "Aqlli avtomatik tozalash"

#: includes/class-admin.php:240
msgid "Purge affected pages automatically when content changes."
msgstr "Kontent oʻzgarganda taʼsirlangan sahifalarni avtomatik tozalash."

#: includes/class-admin.php:243
msgid "Purge on updates"
msgstr "Yangilanishlarda tozalash"

#: includes/class-admin.php:244
msgid "Purge everything after core, plugin, or theme updates."
msgstr "Yadro, plagin yoki mavzu yangilanishlaridan soʻng hamma narsani tozalash."

#: includes/class-admin.php:248
msgid "Cache exclusions"
msgstr "Kesh istisnolari"

#: includes/class-admin.php:249
msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "Oqilona WordPress va WooCommerce standart sozlamalari doimo qoʻllaniladi (savat, buyurtma rasmiylashtirish, hisobim, tizimga kirgan va sessiya sahifalari hech qachon keshlanmaydi). Quyida qoʻshimcha qoidalarni har bir qatorga bittadan qoʻshing."

#: includes/class-admin.php:252
msgid "Exclude URL paths (prefix match)"
msgstr "URL yoʻllarini istisno qilish (prefiks boʻyicha moslik)"

#: includes/class-admin.php:256
msgid "Exclude query keys"
msgstr "Soʻrov kalitlarini istisno qilish"

#: includes/class-admin.php:260
msgid "Exclude cookie name prefixes"
msgstr "Cookie nomi prefikslarini istisno qilish"

#: includes/class-admin.php:269
msgid "Maintenance"
msgstr "Texnik xizmat"

#: includes/class-admin.php:273
msgid "Purge everything now"
msgstr "Hozir hamma narsani tozalash"

#: includes/class-admin.php:294
msgid "detected"
msgstr "aniqlandi"

#: includes/class-admin.php:295
msgid "not detected"
msgstr "aniqlanmadi"

#: includes/class-admin.php:298
msgid "phpredis extension missing"
msgstr "phpredis kengaytmasi yoʻq"

#: includes/class-admin.php:300
msgid "active"
msgstr "faol"

#: includes/class-admin.php:302
msgid "inactive"
msgstr "faol emas"

#: includes/class-admin.php:307
msgid "LiteSpeed cache:"
msgstr "LiteSpeed keshi:"

#: includes/class-admin.php:309
msgid "Redis object cache:"
msgstr "Redis obyekt keshi:"

#: includes/class-object-cache.php:118
msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis PHP kengaytmasi (phpredis) bu serverda mavjud emas, shuning uchun obyekt keshini yoqib boʻlmaydi."

#: includes/class-object-cache.php:125
msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn® object cache."
msgstr "Boshqa object-cache drop-in moduli allaqachon o‘rnatilgan. Zinn® object cache'ni yoqishdan oldin uni olib tashlang."

#: includes/class-object-cache.php:137
msgid "Could not write the Redis connection configuration file."
msgstr "Redis ulanish konfiguratsiya faylini yozib boʻlmadi."

#: includes/class-object-cache.php:145
msgid "The bundled object-cache drop-in could not be read."
msgstr "Birlashtirilgan obyekt-kesh drop-in oʻqib boʻlmadi."

#: includes/class-object-cache.php:152
msgid "Could not install the object-cache drop-in into wp-content."
msgstr "Obyekt-kesh drop-in wp-content ichiga oʻrnatib boʻlmadi."

#: includes/class-object-cache.php:173
msgid "Could not remove the object-cache drop-in."
msgstr "Obyekt-kesh drop-in olib tashlab boʻlmadi."

#: includes/class-object-cache.php:262
msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress fayl tizimiga yozib boʻlmaydi, shuning uchun obyekt-kesh drop-in boshqarib boʻlmadi."

#: includes/class-sso.php:414
msgid "This one-click login link is not valid any more. Links expire after a couple of minutes and can only be used once — open your site from the Zinn® dashboard again to get a fresh one."
msgstr "Ushbu bir marta bosish orqali kirish havolasi endi yaroqli emas. Havolalar bir necha daqiqadan so'ng o'z kuchini yo'qotadi va faqat bir marta ishlatilishi mumkin — yangisini olish uchun saytingizni Zinn® boshqaruv panelidan qayta oching."

#: includes/class-updater.php:230
msgid "See the Zinn Digital® release notes."
msgstr "Zinn Digital® chiqarilish eslatmalarini ko'ring."

#: includes/class-updater.php:285
msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Yuklab olingan yangilanish yaxlitlik tekshiruvidan o'ta olmadi va o'rnatilmadi."

