#, php-format
msgid "Sharing diagnostic data with %s helps to provide functionality that's more relevant to your website, avoid WordPress or PHP version incompatibilities that can break your website, and recognize which languages & regions the plugin should be translated and tailored to."
msgstr "%s ನೊಂದಿಗೆ ರೋಗನಿರ್ಣಯದ ಡೇಟಾವನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದು ನಿಮ್ಮ ವೆಬ್‌ಸೈಟ್‌ಗೆ ಹೆಚ್ಚು ಪ್ರಸ್ತುತವಾದ ಕಾರ್ಯವನ್ನು ಒದಗಿಸಲು, ನಿಮ್ಮ ವೆಬ್‌ಸೈಟ್‌ ಅನ್ನು ಹಾಳುಮಾಡಬಹುದಾದ WordPress ಅಥವಾ PHP ಆವೃತ್ತಿಯ ಅಸಾಮರಸ್ಯಗಳನ್ನು ತಪ್ಪಿಸಲು ಮತ್ತು ಪ್ಲಗಿನ್ ಅನ್ನು ಯಾವ ಭಾಷೆಗಳು ಮತ್ತು ಪ್ರದೇಶಗಳಿಗೆ ಅನುವಾದಿಸಬೇಕು ಹಾಗೂ ಹೊಂದಿಸಬೇಕು ಎಂಬುದನ್ನು ಗುರುತಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."

#: includes/freemius-strings.php:1674
#: includes/freemius-strings.php:5136
msgid "Sharing your name and email allows us to keep you in the loop about new features and important updates, warn you about security issues before they become public knowledge, and send you special offers."
msgstr "ನಿಮ್ಮ ಹೆಸರು ಮತ್ತು ಇಮೇಲ್ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದರಿಂದ ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಪ್ರಮುಖ ಅಪ್‌ಡೇಟ್‌ಗಳ ಕುರಿತು ನಿಮಗೆ ಮಾಹಿತಿ ನೀಡಲು, ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳು ಸಾರ್ವಜನಿಕರಿಗೆ ತಿಳಿಯುವ ಮೊದಲೇ ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡಲು ಮತ್ತು ವಿಶೇಷ ಕೊಡುಗೆಗಳನ್ನು ಕಳುಹಿಸಲು ನಮಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆ."

