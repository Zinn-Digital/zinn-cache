msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) ಪೂರ್ಣ-ಪುಟ ಕ್ಯಾಶ್‌ಗಾಗಿ ಸರ್ವರ್-ಕಡೆಯ ಕ್ಯಾಶ್ ನಿಯಂತ್ರಣ — ವಿಷಯ ಬದಲಾದಾಗ ಸ್ಮಾರ್ಟ್ ಸ್ವಯಂ-ಶುದ್ಧೀಕರಣ, Redis ವಸ್ತು-ಕ್ಯಾಶ್ ಟಾಗಲ್, ಮತ್ತು ಸುರಕ್ಷಿತ WordPress/WooCommerce ಕ್ಯಾಶ್ ಹೊರತುಪಡಿಸುವಿಕೆಗಳೊಂದಿಗೆ. Zinn Digital ಹೋಸ್ಟಿಂಗ್-ಪ್ಲಾಟ್‌ಫಾರ್ಮ್ ಡಿಪ್ಲಾಯ್ ಫುಟ್‌ಪ್ರಿಂಟ್‌ನ ಭಾಗ."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "ಕ್ಯಾಶ್ ಶುದ್ಧೀಕರಿಸಲು ನಿಮಗೆ ಅನುಮತಿ ಇಲ್ಲ."

msgid "Cache purge requested."
msgstr "ಕ್ಯಾಶ್ ಶುದ್ಧೀಕರಣಕ್ಕೆ ವಿನಂತಿ ಮಾಡಲಾಗಿದೆ."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: ಇನ್ನೊಂದು ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಸ್ಥಾಪಿಸಲಾಗಿದೆ, ಆದ್ದರಿಂದ Redis ವಸ್ತು ಕ್ಯಾಶ್ ಅನ್ನು ಈ ಪ್ಲಗಿನ್ ನಿರ್ವಹಿಸುವುದಿಲ್ಲ."

msgid "Full-page cache (LiteSpeed)"
msgstr "ಪೂರ್ಣ-ಪುಟ ಕ್ಯಾಶ್ (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache ನಿಯಂತ್ರಣವನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "ಕ್ಯಾಶ್ ಮಾಡಬಹುದಾದ ಪುಟಗಳಲ್ಲಿ LiteSpeed ಕ್ಯಾಶ್-ನಿಯಂತ್ರಣ ಮತ್ತು ಟ್ಯಾಗ್ ಹೆಡರ್‌ಗಳನ್ನು ಕಳುಹಿಸಿ."

msgid "Public cache lifetime (seconds)"
msgstr "ಸಾರ್ವಜನಿಕ ಕ್ಯಾಶ್ ಜೀವಿತಾವಧಿ (ಸೆಕೆಂಡುಗಳು)"

msgid "Object cache (Redis)"
msgstr "ವಸ್ತು ಕ್ಯಾಶ್ (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis ವಸ್ತು ಕ್ಯಾಶ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಅನ್ನು ಸ್ಥಾಪಿಸಿ (phpredis ವಿಸ್ತರಣೆ ಅಗತ್ಯವಿದೆ)."

msgid "Redis host"
msgstr "Redis ಹೋಸ್ಟ್"

msgid "Redis port"
msgstr "Redis ಪೋರ್ಟ್"

msgid "Redis database"
msgstr "Redis ಡೇಟಾಬೇಸ್"

msgid "Redis key prefix"
msgstr "Redis ಕೀ ಪ್ರಿಫಿಕ್ಸ್"

msgid "Automatic purging"
msgstr "ಸ್ವಯಂಚಾಲಿತ ಶುದ್ಧೀಕರಣ"

msgid "Smart auto-purge"
msgstr "ಸ್ಮಾರ್ಟ್ ಸ್ವಯಂ-ಶುದ್ಧೀಕರಣ"

msgid "Purge affected pages automatically when content changes."
msgstr "ವಿಷಯ ಬದಲಾದಾಗ ಪ್ರಭಾವಿತ ಪುಟಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಶುದ್ಧೀಕರಿಸಿ."

msgid "Purge on updates"
msgstr "ಅಪ್‌ಡೇಟ್‌ಗಳ ಮೇಲೆ ಶುದ್ಧೀಕರಿಸಿ"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "ಕೋರ್, ಪ್ಲಗಿನ್, ಅಥವಾ ಥೀಮ್ ಅಪ್‌ಡೇಟ್‌ಗಳ ನಂತರ ಎಲ್ಲವನ್ನೂ ಶುದ್ಧೀಕರಿಸಿ."

msgid "Cache exclusions"
msgstr "ಕ್ಯಾಶ್ ಹೊರತುಪಡಿಸುವಿಕೆಗಳು"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "ಸಮಂಜಸವಾದ WordPress ಮತ್ತು WooCommerce ಡೀಫಾಲ್ಟ್‌ಗಳನ್ನು ಯಾವಾಗಲೂ ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ (ಕಾರ್ಟ್, ಚೆಕ್‌ಔಟ್, ಮೈ-ಅಕೌಂಟ್, ಲಾಗ್-ಇನ್ ಮಾಡಿದ ಮತ್ತು ಸೆಷನ್ ಪುಟಗಳನ್ನು ಎಂದಿಗೂ ಕ್ಯಾಶ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ). ಕೆಳಗೆ ಹೆಚ್ಚುವರಿ ನಿಯಮಗಳನ್ನು ಸೇರಿಸಿ, ಪ್ರತಿ ಸಾಲಿಗೆ ಒಂದು."

msgid "Exclude URL paths (prefix match)"
msgstr "URL ಪಥಗಳನ್ನು ಹೊರತುಪಡಿಸಿ (ಪ್ರಿಫಿಕ್ಸ್ ಹೊಂದಾಣಿಕೆ)"

msgid "Exclude query keys"
msgstr "ಕ್ವೆರಿ ಕೀಗಳನ್ನು ಹೊರತುಪಡಿಸಿ"

msgid "Exclude cookie name prefixes"
msgstr "ಕುಕೀ ಹೆಸರು ಪ್ರಿಫಿಕ್ಸ್‌ಗಳನ್ನು ಹೊರತುಪಡಿಸಿ"

msgid "Maintenance"
msgstr "ನಿರ್ವಹಣೆ"

msgid "Purge everything now"
msgstr "ಈಗ ಎಲ್ಲವನ್ನೂ ಶುದ್ಧೀಕರಿಸಿ"

msgid "detected"
msgstr "ಪತ್ತೆಯಾಗಿದೆ"

msgid "not detected"
msgstr "ಪತ್ತೆಯಾಗಿಲ್ಲ"

msgid "phpredis extension missing"
msgstr "phpredis ವಿಸ್ತರಣೆ ಕಾಣೆಯಾಗಿದೆ"

msgid "active"
msgstr "ಸಕ್ರಿಯ"

msgid "inactive"
msgstr "ನಿಷ್ಕ್ರಿಯ"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed ಕ್ಯಾಶ್:"

msgid "Redis object cache:"
msgstr "Redis ವಸ್ತು ಕ್ಯಾಶ್:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "ಈ ಸರ್ವರ್‌ನಲ್ಲಿ Redis PHP ವಿಸ್ತರಣೆ (phpredis) ಲಭ್ಯವಿಲ್ಲ, ಆದ್ದರಿಂದ ವಸ್ತು ಕ್ಯಾಶ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "ಇನ್ನೊಂದು ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಈಗಾಗಲೇ ಸ್ಥಾಪಿಸಲಾಗಿದೆ. Zinn ವಸ್ತು ಕ್ಯಾಶ್ ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುವ ಮೊದಲು ಅದನ್ನು ತೆಗೆದುಹಾಕಿ."

msgid "Could not write the Redis connection configuration file."
msgstr "Redis ಸಂಪರ್ಕ ಕಾನ್ಫಿಗರೇಶನ್ ಫೈಲ್ ಅನ್ನು ಬರೆಯಲಾಗಲಿಲ್ಲ."

msgid "The bundled object-cache drop-in could not be read."
msgstr "ಒಟ್ಟುಗೂಡಿಸಿದ ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಅನ್ನು ಓದಲಾಗಲಿಲ್ಲ."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಅನ್ನು wp-content ಗೆ ಸ್ಥಾಪಿಸಲಾಗಲಿಲ್ಲ."

msgid "Could not remove the object-cache drop-in."
msgstr "ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಅನ್ನು ತೆಗೆದುಹಾಕಲಾಗಲಿಲ್ಲ."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress ಫೈಲ್‌ಸಿಸ್ಟಮ್ ಬರೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ, ಆದ್ದರಿಂದ ವಸ್ತು-ಕ್ಯಾಶ್ ಡ್ರಾಪ್-ಇನ್ ಅನ್ನು ನಿರ್ವಹಿಸಲಾಗಲಿಲ್ಲ."

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital ಬಿಡುಗಡೆ ಟಿಪ್ಪಣಿಗಳನ್ನು ನೋಡಿ."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ನವೀಕರಣವು ಅದರ ಸಮಗ್ರತೆ ಪರಿಶೀಲನೆಯಲ್ಲಿ ವಿಫಲವಾಯಿತು ಮತ್ತು ಅದನ್ನು ಸ್ಥಾಪಿಸಲಾಗಿಲ್ಲ."
