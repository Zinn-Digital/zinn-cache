msgid "Cache exclusions"
msgstr "ಕ್ಯಾಶ್ ಹೊರತುಪಡಿಸುವಿಕೆಗಳು"

#: includes/class-admin.php:249
msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "ಸಮಂಜಸವಾದ WordPress ಮತ್ತು WooCommerce ಡೀಫಾಲ್ಟ್‌ಗಳನ್ನು ಯಾವಾಗಲೂ ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ (ಕಾರ್ಟ್, ಚೆಕ್‌ಔಟ್, ಮೈ-ಅಕೌಂಟ್, ಲಾಗ್-ಇನ್ ಮಾಡಿದ ಮತ್ತು ಸೆಷನ್ ಪುಟಗಳನ್ನು ಎಂದಿಗೂ ಕ್ಯಾಶ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ). ಕೆಳಗೆ ಹೆಚ್ಚುವರಿ ನಿಯಮಗಳನ್ನು ಸೇರಿಸಿ, ಪ್ರತಿ ಸಾಲಿಗೆ ಒಂದು."

#: includes/class-admin.php:252
msgid "Exclude URL paths (prefix match)"
msgstr "URL ಪಥಗಳನ್ನು ಹೊರತುಪಡಿಸಿ (ಪ್ರಿಫಿಕ್ಸ್ ಹೊಂದಾಣಿಕೆ)"

