msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "LiteSpeed (LSCache) ഫുൾ-പേജ് കാഷിനുള്ള സെർവർ-സൈഡ് കാഷ് നിയന്ത്രണം — ഉള്ളടക്കം മാറുമ്പോൾ സ്മാർട്ട് ഓട്ടോ-പർജ്, Redis ഒബ്ജക്റ്റ്-കാഷ് ടോഗിൾ, സുരക്ഷിതമായ WordPress/WooCommerce കാഷ് ഒഴിവാക്കലുകൾ എന്നിവയോടെ. Zinn Digital ഹോസ്റ്റിംഗ്-പ്ലാറ്റ്ഫോം ഡിപ്ലോയ് ഫുട്ട്‌പ്രിന്റിന്റെ ഭാഗം."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "കാഷ് പർജ് ചെയ്യാൻ നിങ്ങൾക്ക് അനുമതിയില്ല."

msgid "Cache purge requested."
msgstr "കാഷ് പർജ് അഭ്യർത്ഥിച്ചു."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: മറ്റൊരു ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ ഇൻസ്റ്റാൾ ചെയ്തിട്ടുണ്ട്, അതിനാൽ Redis ഒബ്ജക്റ്റ് കാഷ് ഈ പ്ലഗിൻ കൈകാര്യം ചെയ്യുന്നില്ല."

msgid "Full-page cache (LiteSpeed)"
msgstr "ഫുൾ-പേജ് കാഷ് (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "LSCache നിയന്ത്രണം പ്രവർത്തനക്ഷമമാക്കുക"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "കാഷ് ചെയ്യാവുന്ന പേജുകളിൽ LiteSpeed കാഷ്-കൺട്രോൾ, ടാഗ് ഹെഡറുകൾ അയയ്ക്കുക."

msgid "Public cache lifetime (seconds)"
msgstr "പബ്ലിക് കാഷ് ആയുസ്സ് (സെക്കൻഡുകൾ)"

msgid "Object cache (Redis)"
msgstr "ഒബ്ജക്റ്റ് കാഷ് (Redis)"

msgid "Enable Redis object cache"
msgstr "Redis ഒബ്ജക്റ്റ് കാഷ് പ്രവർത്തനക്ഷമമാക്കുക"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Redis ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ ഇൻസ്റ്റാൾ ചെയ്യുക (phpredis എക്സ്റ്റൻഷൻ ആവശ്യമാണ്)."

msgid "Redis host"
msgstr "Redis ഹോസ്റ്റ്"

msgid "Redis port"
msgstr "Redis പോർട്ട്"

msgid "Redis database"
msgstr "Redis ഡാറ്റാബേസ്"

msgid "Redis key prefix"
msgstr "Redis കീ പ്രിഫിക്സ്"

msgid "Automatic purging"
msgstr "സ്വയമേവയുള്ള പർജിംഗ്"

msgid "Smart auto-purge"
msgstr "സ്മാർട്ട് ഓട്ടോ-പർജ്"

msgid "Purge affected pages automatically when content changes."
msgstr "ഉള്ളടക്കം മാറുമ്പോൾ ബാധിക്കപ്പെട്ട പേജുകൾ സ്വയമേവ പർജ് ചെയ്യുക."

msgid "Purge on updates"
msgstr "അപ്ഡേറ്റുകളിൽ പർജ് ചെയ്യുക"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "കോർ, പ്ലഗിൻ, അല്ലെങ്കിൽ തീം അപ്ഡേറ്റുകൾക്ക് ശേഷം എല്ലാം പർജ് ചെയ്യുക."

msgid "Cache exclusions"
msgstr "കാഷ് ഒഴിവാക്കലുകൾ"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "ന്യായമായ WordPress, WooCommerce ഡിഫോൾട്ടുകൾ എപ്പോഴും പ്രയോഗിക്കപ്പെടുന്നു (കാർട്ട്, ചെക്ക്ഔട്ട്, my-account, ലോഗിൻ ചെയ്ത, സെഷൻ പേജുകൾ ഒരിക്കലും കാഷ് ചെയ്യപ്പെടില്ല). ചുവടെ അധിക നിയമങ്ങൾ ചേർക്കുക, ഓരോ വരിയിൽ ഒന്ന്."

msgid "Exclude URL paths (prefix match)"
msgstr "URL പാതകൾ ഒഴിവാക്കുക (പ്രിഫിക്സ് പൊരുത്തം)"

msgid "Exclude query keys"
msgstr "ക്വറി കീകൾ ഒഴിവാക്കുക"

msgid "Exclude cookie name prefixes"
msgstr "കുക്കി പേര് പ്രിഫിക്സുകൾ ഒഴിവാക്കുക"

msgid "Maintenance"
msgstr "പരിപാലനം"

msgid "Purge everything now"
msgstr "ഇപ്പോൾ എല്ലാം പർജ് ചെയ്യുക"

msgid "detected"
msgstr "കണ്ടെത്തി"

msgid "not detected"
msgstr "കണ്ടെത്തിയില്ല"

msgid "phpredis extension missing"
msgstr "phpredis എക്സ്റ്റൻഷൻ കാണുന്നില്ല"

msgid "active"
msgstr "സജീവം"

msgid "inactive"
msgstr "നിഷ്ക്രിയം"

msgid "LiteSpeed cache:"
msgstr "LiteSpeed കാഷ്:"

msgid "Redis object cache:"
msgstr "Redis ഒബ്ജക്റ്റ് കാഷ്:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Redis PHP എക്സ്റ്റൻഷൻ (phpredis) ഈ സെർവറിൽ ലഭ്യമല്ല, അതിനാൽ ഒബ്ജക്റ്റ് കാഷ് പ്രവർത്തനക്ഷമമാക്കാൻ കഴിയില്ല."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "മറ്റൊരു ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ ഇതിനകം ഇൻസ്റ്റാൾ ചെയ്തിട്ടുണ്ട്. Zinn ഒബ്ജക്റ്റ് കാഷ് പ്രവർത്തനക്ഷമമാക്കുന്നതിന് മുമ്പ് അത് നീക്കം ചെയ്യുക."

msgid "Could not write the Redis connection configuration file."
msgstr "Redis കണക്ഷൻ കോൺഫിഗറേഷൻ ഫയൽ എഴുതാൻ കഴിഞ്ഞില്ല."

msgid "The bundled object-cache drop-in could not be read."
msgstr "ബണ്ടിൽ ചെയ്ത ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ വായിക്കാൻ കഴിഞ്ഞില്ല."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ wp-content-ലേക്ക് ഇൻസ്റ്റാൾ ചെയ്യാൻ കഴിഞ്ഞില്ല."

msgid "Could not remove the object-cache drop-in."
msgstr "ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ നീക്കം ചെയ്യാൻ കഴിഞ്ഞില്ല."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress ഫയൽസിസ്റ്റം എഴുതാൻ കഴിയുന്നതല്ല, അതിനാൽ ഒബ്ജക്റ്റ്-കാഷ് ഡ്രോപ്പ്-ഇൻ കൈകാര്യം ചെയ്യാൻ കഴിഞ്ഞില്ല."

msgid "See the Zinn Digital release notes."
msgstr "Zinn Digital റിലീസ് കുറിപ്പുകൾ കാണുക."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "ഡൗൺലോഡ് ചെയ്ത അപ്‌ഡേറ്റ് സമഗ്രതാ പരിശോധനയിൽ പരാജയപ്പെട്ടതിനാൽ ഇൻസ്റ്റാൾ ചെയ്തിട്ടില്ല."
