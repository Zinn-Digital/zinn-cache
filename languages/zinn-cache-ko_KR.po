#. Plugin Name of the plugin
#: zinn-cache.php
#: includes/mcp/class-abilities.php:55
msgid "Zinn® Cache"
msgstr "Zinn® Cache"

#. Plugin URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-cache"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-cache"

#. Description of the plugin
#: zinn-cache.php
msgid "A page cache and a Redis object cache for any WordPress site. Uses the LiteSpeed server cache where there is one and its own disk cache everywhere else, purges only what a change affects, and proves its Redis connection works."
msgstr "모든 WordPress 사이트를 위한 페이지 캐시 및 Redis 객체 캐시. LiteSpeed 서버 캐시가 있는 경우 이를 사용하고 그 외에는 자체 디스크 캐시를 사용하며, 변경 사항의 영향을 받는 항목만 삭제하고 Redis 연결이 작동함을 증명합니다."

#. Author of the plugin
#: zinn-cache.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-cache.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-admin.php:104
msgid "Cache"
msgstr "캐시"

#: includes/class-admin.php:110
#: includes/class-admin.php:179
msgid "Page cache"
msgstr "페이지 캐시"

#: includes/class-admin.php:114
#: includes/class-admin.php:264
msgid "Object cache"
msgstr "객체 캐시"

#: includes/class-admin.php:118
msgid "Purging"
msgstr "제거 중"

#: includes/class-admin.php:122
msgid "Exclusions"
msgstr "제외 항목"

#: includes/class-admin.php:126
#: includes/class-admin.php:152
#: includes/mcp-kit/class-server.php:237
msgid "AI agents (MCP)"
msgstr "AI 에이전트 (MCP)"

#: includes/class-admin.php:133
msgid "Purge everything now"
msgstr "지금 모두 비우기"

#: includes/class-admin.php:134
msgid "Every cached page is discarded and will be rebuilt as visitors arrive. Continue?"
msgstr "캐시된 모든 페이지가 삭제되며 방문자가 접속할 때 다시 생성됩니다. 계속하시겠습니까?"

#: includes/class-admin.php:153
#: includes/mcp-kit/class-server.php:246
msgid "Allow AI agents (MCP)"
msgstr "AI 에이전트 허용 (MCP)"

#: includes/class-admin.php:154
#: includes/mcp-kit/class-server.php:248
msgid "Off: the tools below and their REST routes are not registered at all."
msgstr "비활성화됨: 아래 도구 및 해당 REST 경로는 전혀 등록되지 않았습니다."

#: includes/class-admin.php:173
msgid "Full-page cache"
msgstr "전체 페이지 캐시"

#: includes/class-admin.php:174
msgid "On a LiteSpeed server, pages are served by the web server before WordPress runs. On any other server, this plugin stores each page as a file and serves it before WordPress loads. This is where nearly all the speed comes from."
msgstr "LiteSpeed 서버에서는 WordPress가 실행되기 전에 웹 서버에서 페이지를 제공합니다. 다른 모든 서버에서는 이 플러그인이 각 페이지를 파일로 저장하고 WordPress가 로드되기 전에 제공합니다. 속도 향상의 거의 모든 부분이 여기에서 비롯됩니다."

#: includes/class-admin.php:180
msgid "Cache pages for visitors who are not signed in"
msgstr "로그인하지 않은 방문자를 위해 페이지 캐시"

#: includes/class-admin.php:186
msgid "How long a page stays cached"
msgstr "페이지가 캐시에 유지되는 시간"

#: includes/class-admin.php:187
msgid "Seconds. A week suits most sites; a news site publishing hourly wants far less."
msgstr "초 단위. 대부분의 사이트에는 1주일이 적합하지만, 매시간 게시하는 뉴스 사이트의 경우 훨씬 더 적은 시간이 필요합니다."

#: includes/class-admin.php:196
msgid "How long a visitor’s browser keeps images and scripts"
msgstr "방문자의 브라우저가 이미지와 스크립트를 보관하는 기간"

#: includes/class-admin.php:197
msgid "Seconds. Applies to images, CSS and JavaScript only — never to pages. Set to 0 to leave this to your host."
msgstr "초 단위. 이미지, CSS, JavaScript에만 적용되며 페이지에는 적용되지 않습니다. 호스트에 맡기려면 0으로 설정하세요."

#: includes/class-admin.php:205
msgid "Signed-in visitors"
msgstr "로그인한 방문자"

#: includes/class-admin.php:206
msgid "Never serve a cached page to a signed-in visitor"
msgstr "로그인한 방문자에게 캐시된 페이지를 제공하지 마세요"

#: includes/class-admin.php:207
msgid "On is the safe answer and the default. Turn it off only if you know every cached page is identical for every signed-in user — a membership site is the usual reason not to."
msgstr "켜짐이 안전한 선택이자 기본값입니다. 캐시된 모든 페이지가 로그인한 모든 사용자에게 동일하다는 것을 알고 있는 경우에만 끄십시오. 멤버십 사이트는 대개 이를 끄지 않아야 하는 이유입니다."

#: includes/class-admin.php:213
msgid "Different lifetimes for different content"
msgstr "콘텐츠에 따른 서로 다른 수명"

#: includes/class-admin.php:214
msgid "For example: a shop’s product pages for an hour, while everything else stays a week."
msgstr "예: 상점의 제품 페이지는 1시간 동안 유지되고, 그 밖의 모든 항목은 1주일 동안 유지됩니다."

#: includes/class-admin.php:215
msgid "Add a rule"
msgstr "규칙 추가"

#: includes/class-admin.php:222
msgid "Content type"
msgstr "콘텐츠 유형"

#: includes/class-admin.php:228
msgid "Seconds"
msgstr "초"

#: includes/class-admin.php:249
#: includes/class-admin.php:258
msgid "Object cache (Redis)"
msgstr "객체 캐시 (Redis)"

#: includes/class-admin.php:250
msgid "Your host runs a private Redis object cache for this site and keeps it configured. There is nothing to set up here; the status at the top of this screen shows whether it is working."
msgstr "호스트가 이 사이트를 위해 프라이빗 Redis 객체 캐시를 실행하고 구성을 유지 관리합니다. 여기에서 설정할 항목은 없습니다. 이 화면 상단의 상태를 통해 작동 여부를 확인할 수 있습니다."

#: includes/class-admin.php:259
msgid "Caches the results of database queries. It helps most on a busy shop or a site with a lot of signed-in traffic, where the page cache cannot."
msgstr "데이터베이스 쿼리 결과를 캐시합니다. 페이지 캐시가 작동하지 않는 방문자가 많은 쇼핑몰이나 로그인 트래픽이 많은 사이트에서 가장 큰 도움이 됩니다."

#: includes/class-admin.php:265
msgid "Install the Redis object-cache drop-in"
msgstr "Redis 객체 캐시 drop-in 설치"

#: includes/class-admin.php:266
msgid "Needs the phpredis extension. If it is missing, the box above this screen says so."
msgstr "phpredis 확장 기능이 필요합니다. 누락된 경우 이 화면 위의 상자에 표시됩니다."

#: includes/class-admin.php:272
msgid "Redis host"
msgstr "Redis 호스트"

#: includes/class-admin.php:279
msgid "Redis port"
msgstr "Redis 포트"

#: includes/class-admin.php:288
msgid "Redis database"
msgstr "Redis 데이터베이스"

#: includes/class-admin.php:289
msgid "Give each site on a shared Redis its own number, or they will clear each other’s cache."
msgstr "공유 Redis의 각 사이트에 고유 번호를 지정하세요. 그렇지 않으면 서로의 캐시를 삭제하게 됩니다."

#: includes/class-admin.php:298
msgid "Redis username"
msgstr "Redis 사용자명"

#: includes/class-admin.php:299
msgid "Only for a Redis server with ACL users (Redis 6 or later). Leave blank to sign in with the password alone."
msgstr "ACL 사용자가 있는 Redis 서버 전용(Redis 6 이상). 비밀번호만으로 로그인하려면 비워 두세요."

#: includes/class-admin.php:307
msgid "Redis password"
msgstr "Redis 비밀번호"

#: includes/class-admin.php:308
msgid "Leave blank if your Redis does not need one."
msgstr "사용하시는 Redis에 필요하지 않은 경우 비워 두십시오."

#: includes/class-admin.php:315
msgid "Key prefix"
msgstr "키 접두사"

#: includes/class-admin.php:316
msgid "An alternative to a separate database number when you cannot have one."
msgstr "별도의 데이터베이스 번호를 가질 수 없을 때 사용할 수 있는 대안입니다."

#: includes/class-admin.php:333
msgid "Smart auto-purge"
msgstr "스마트 자동 제거"

#: includes/class-admin.php:334
msgid "Clear affected pages automatically when content changes"
msgstr "콘텐츠가 변경될 때 영향을 받는 페이지를 자동으로 지우기"

#: includes/class-admin.php:340
msgid "After updates"
msgstr "업데이트 후"

#: includes/class-admin.php:341
msgid "Clear everything after a core, plugin or theme update"
msgstr "코어, 플러그인 또는 테마 업데이트 후 모두 지우기"

#: includes/class-admin.php:347
msgid "After a comment"
msgstr "댓글 후"

#: includes/class-admin.php:348
msgid "Clear a post’s page when a comment on it is approved"
msgstr "글에 달린 댓글이 승인되면 해당 글 페이지 지우기"

#: includes/class-admin.php:349
msgid "Turn this off on a very busy comment section, where it can clear the same page hundreds of times an hour."
msgstr "동일한 페이지를 한 시간에 수백 번 지울 수 있으므로 댓글이 매우 많은 섹션에서는 이 기능을 끄십시오."

#: includes/class-admin.php:364
msgid "Never cache these"
msgstr "항상 캐시하지 않음"

#: includes/class-admin.php:365
msgid "Sensible WordPress and WooCommerce defaults are always applied — cart, checkout, my-account and any signed-in session are never cached, whatever is below."
msgstr "적절한 WordPress 및 WooCommerce 기본값이 항상 적용됩니다 — 아래 내용에 관계없이 cart, checkout, my-account 및 로그인된 세션은 절대로 캐시되지 않습니다."

#: includes/class-admin.php:371
msgid "Addresses"
msgstr "주소 목록"

#: includes/class-admin.php:372
msgid "One path per line, for example <code>/basket</code>. A trailing <code>*</code> matches everything under it."
msgstr "한 줄에 하나의 경로(예: <code>/basket</code>). 끝에 있는 <code>*</code>는 그 아래의 모든 항목과 일치합니다."

#: includes/class-admin.php:380
msgid "Query parameters"
msgstr "쿼리 매개변수"

#: includes/class-admin.php:381
msgid "A page carrying one of these is never cached — for example a one-time preview token."
msgstr "이 중 하나를 포함하는 페이지는 절대 캐시되지 않습니다(예: 일회용 미리보기 토큰)."

#: includes/class-admin.php:389
msgid "Cookies"
msgstr "쿠키"

#: includes/class-admin.php:390
msgid "A visitor carrying one of these is always served a fresh page."
msgstr "이 중 하나를 보유한 방문자에게는 항상 새로운 페이지가 제공됩니다."

#: includes/class-admin.php:419
msgid "Every cached page has been discarded. They will be rebuilt as visitors arrive."
msgstr "캐시된 모든 페이지가 삭제되었습니다. 방문자가 접속하면 다시 생성됩니다."

#: includes/class-admin.php:445
msgid "The object cache is installed, but it is not storing anything."
msgstr "객체 캐시가 설치되었지만 아무것도 저장하지 않고 있습니다."

#: includes/class-admin.php:459
msgid "The page cache is on, but pages are not being stored yet."
msgstr "페이지 캐시가 켜져 있지만, 아직 페이지가 저장되지 않고 있습니다."

#: includes/class-admin.php:460
msgid "WordPress has not loaded the page-cache drop-in yet. It starts on the next page load; if it does not, check that WP_CACHE is true in wp-config.php."
msgstr "WordPress가 아직 페이지 캐시 드롭인을 로드하지 않았습니다. 다음 페이지를 로드할 때 시작됩니다. 시작되지 않는 경우 wp-config.php에서 WP_CACHE가 true로 설정되어 있는지 확인하세요."

#: includes/class-admin.php:469
msgid "The object cache is on, but this server has no Redis support."
msgstr "객체 캐시가 켜져 있지만, 이 서버는 Redis를 지원하지 않습니다."

#: includes/class-admin.php:470
msgid "The phpredis extension is not installed, so the drop-in cannot be used and WordPress is falling back to its own in-memory cache. Ask your host to enable phpredis."
msgstr "phpredis 확장 기능이 설치되지 않아 drop-in을 사용할 수 없으며, WordPress가 자체 인메모리 캐시로 대체하고 있습니다. 호스팅 업체에 phpredis 활성화를 요청하세요."

#: includes/class-admin.php:478
msgid "Nothing is being cached."
msgstr "캐시되는 항목이 없습니다."

#: includes/class-admin.php:479
msgid "Both caches are switched off, so this plugin is not making the site any faster."
msgstr "두 캐시가 모두 꺼져 있으므로 이 플러그인은 사이트를 더 빠르게 만들지 않습니다."

#: includes/class-admin.php:486
msgid "Caching is active on this site."
msgstr "이 사이트에서 캐싱이 활성화되어 있습니다."

#: includes/class-admin.php:521
msgid "Redis refused the username or password. Check the Redis credentials in wp-config.php or on this screen."
msgstr "Redis에서 사용자명 또는 비밀번호를 거부했습니다. wp-config.php 또는 이 화면에서 Redis 자격 증명을 확인하세요."

#: includes/class-admin.php:523
msgid "Redis accepted the login but does not allow this site to store its keys. The Redis user needs permission for this site's key prefix."
msgstr "Redis에서 로그인을 수락했지만 이 사이트가 키를 저장하도록 허용하지 않습니다. Redis 사용자에게 이 사이트의 키 접두사에 대한 권한이 필요합니다."

#: includes/class-admin.php:525
msgid "Redis refused the database number. Check the Redis database setting."
msgstr "Redis에서 데이터베이스 번호를 거부했습니다. Redis 데이터베이스 설정을 확인하세요."

#: includes/class-admin.php:527
msgid "Redis is out of memory and is refusing new data."
msgstr "Redis의 메모리가 부족하여 새 데이터를 거부하고 있습니다."

#: includes/class-admin.php:529
msgid "The phpredis extension is not installed, so WordPress is using its own in-memory cache. Ask your host to enable phpredis."
msgstr "phpredis 확장 프로그램이 설치되어 있지 않아 WordPress에서 자체 인메모리 캐시를 사용하고 있습니다. 호스팅 제공업체에 phpredis 활성화를 요청하세요."

#: includes/class-admin.php:531
msgid "WP_REDIS_DISABLED is set in wp-config.php, so the object cache is switched off."
msgstr "wp-config.php에 WP_REDIS_DISABLED가 설정되어 있어 객체 캐시가 꺼져 있습니다."

#: includes/class-admin.php:533
msgid "The Redis server could not be reached. Check the Redis host and port, and that Redis is running."
msgstr "Redis 서버에 연결할 수 없습니다. Redis 호스트와 포트를 확인하고, Redis가 실행 중인지 확인하세요."

#: includes/class-admin.php:535
msgid "Redis did not return the value that was just written to it. Check the Redis server's logs."
msgstr "Redis가 방금 기록된 값을 반환하지 않았습니다. Redis 서버의 로그를 확인하세요."

#: includes/class-admin.php:550
msgid "Web server"
msgstr "웹 서버"

#: includes/class-admin.php:552
msgid "LiteSpeed — pages are cached by the web server"
msgstr "LiteSpeed — 페이지가 웹 서버에 의해 캐시됩니다"

#: includes/class-admin.php:553
msgid "not LiteSpeed — pages are cached on disk by this plugin"
msgstr "LiteSpeed가 아님 — 이 플러그인에 의해 페이지가 디스크에 캐시됩니다"

#: includes/class-admin.php:556
msgid "Pages stored on disk"
msgstr "디스크에 저장된 페이지"

#: includes/class-admin.php:560
msgid "Redis support"
msgstr "Redis 지원"

#: includes/class-admin.php:562
msgid "phpredis is installed"
msgstr "phpredis가 설치되어 있습니다"

#: includes/class-admin.php:563
msgid "phpredis is not installed"
msgstr "phpredis가 설치되어 있지 않습니다"

#: includes/class-admin.php:566
msgid "Page lifetime"
msgstr "페이지 수명"

#: includes/class-admin.php:641
msgid "You are not allowed to purge the cache."
msgstr "캐시를 비울 권한이 없습니다."

#: includes/class-admin.php:647
msgid "Cache purge requested."
msgstr "캐시 삭제가 요청되었습니다."

#: includes/class-admin.php:675
msgid "Zinn® Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn® Cache: 다른 object-cache 드롭인이 설치되어 있으므로 Redis 객체 캐시가 이 플러그인에 의해 관리되지 않습니다."

#: includes/class-admin.php:689
msgid "detected"
msgstr "감지됨"

#: includes/class-admin.php:690
msgid "not detected"
msgstr "감지되지 않음"

#: includes/class-admin.php:694
msgid "phpredis extension missing"
msgstr "phpredis 확장이 누락되었습니다"

#: includes/class-admin.php:696
msgid "installed, not storing anything"
msgstr "설치됨, 아무것도 저장하지 않음"

#: includes/class-admin.php:698
msgid "active, managed by your host"
msgstr "활성, 호스트에서 관리됨"

#: includes/class-admin.php:700
msgid "active"
msgstr "활성"

#: includes/class-admin.php:702
msgid "inactive"
msgstr "비활성"

#: includes/class-admin.php:707
msgid "LiteSpeed cache:"
msgstr "LiteSpeed 캐시:"

#: includes/class-admin.php:709
msgid "Redis object cache:"
msgstr "Redis 객체 캐시:"

#: includes/class-object-cache.php:256
msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "이 서버에서 Redis PHP 확장(phpredis)을 사용할 수 없으므로 객체 캐시를 활성화할 수 없습니다."

#: includes/class-object-cache.php:263
msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn® object cache."
msgstr "다른 object-cache 드롭인이 이미 설치되어 있습니다. Zinn® 객체 캐시를 활성화하기 전에 제거하십시오."

#: includes/class-object-cache.php:275
msgid "Could not write the Redis connection configuration file."
msgstr "Redis 연결 구성 파일을 쓸 수 없습니다."

#: includes/class-object-cache.php:283
msgid "The bundled object-cache drop-in could not be read."
msgstr "번들된 object-cache 드롭인을 읽을 수 없습니다."

#: includes/class-object-cache.php:290
msgid "Could not install the object-cache drop-in into wp-content."
msgstr "wp-content에 object-cache 드롭인을 설치할 수 없습니다."

#: includes/class-object-cache.php:316
msgid "Could not remove the object-cache drop-in."
msgstr "object-cache 드롭인을 제거할 수 없습니다."

#: includes/class-object-cache.php:411
msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "WordPress 파일 시스템에 쓸 수 없으므로 object-cache 드롭인을 관리할 수 없습니다."

