#: includes/class-zinn-cache-promo.php:299
#, php-format
msgid "%s — guides and services"
msgstr "%s — дастурҳо ва хидматҳо"

#: includes/class-zinn-cache-promo.php:256
msgid "User guides"
msgstr "Дастурҳои корбарӣ"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-cache-promo.php:306
#, php-format
msgid "Read the %s user guide"
msgstr "Дастури корбарии %s-ро хонед"

#: includes/class-zinn-cache-promo.php:314
msgid "Hide this"
msgstr "Инро пинҳон кардан"

#: includes/class-zinn-cache-promo.php:374
msgid "Zinn® hosting for WordPress"
msgstr "Мизбонии Zinn® барои WordPress"

#: includes/class-zinn-cache-promo.php:375
msgid "LiteSpeed, daily backups, free migration and a control panel built for people who run more than one site."
msgstr "LiteSpeed, нусхаҳои эҳтиётии ҳаррӯза, муҳоҷирати ройгон ва панели идоракуние, ки барои шахсони зиёда аз як сайт дошта сохта шудааст."

#: includes/class-zinn-cache-promo.php:381
msgid "The Zinn® marketplace"
msgstr "Бозори Zinn®"

#: includes/class-zinn-cache-promo.php:382
msgid "Buy and sell established sites, domains and link placements, with the money held safely until both sides are happy."
msgstr "Сайти тайёр, домен ва ҷойгиркунии пайвандҳоро харидед ва фурӯшед, то даме ки ҳду тараф розӣ нашаванд, маблағ бо амният нигоҳ дошта мешавад."

#: includes/class-zinn-cache-promo.php:429
msgid "Zinn Hub® — hire people who do this for a living"
msgstr "Zinn Hub® — мутахассисони касбиро ба кор киро кунед"

#: includes/class-zinn-cache-promo.php:430
msgid "Our global freelance marketplace: browse over 10,000 ready-made services from writers, designers, developers and SEOs, or post a project and let them bid."
msgstr "Бозори глобалии фрилансери мо: аз зиёда аз 10,000 хизматрасонии омода аз нависандагон, тарроҳон, таҳиягарон ва мутахассисони SEO гузаред ё лоиҳаеро нашр кунед ва бигузор онҳо пешниҳоди нарх кунанд."

#: includes/class-zinn-cache-style-presets.php:109
msgid "Style preset"
msgstr "Намунаи услуб"

#: includes/class-zinn-cache-style-presets.php:110
msgid "A starting point. Anything below overrides it."
msgstr "Нуқтаи оғоз. Ҳама чизе, ки дар поён аст, онро бекор мекунад."

#: includes/class-zinn-cache-style-presets.php:117
msgid "Use my own colours and sizes"
msgstr "Рангҳо ва андозаҳои шахсии худро истифода баред"

#: includes/class-zinn-cache-style-presets.php:118
msgid "Leave this off and the preset is used exactly as it is."
msgstr "Инро хомӯш гузоред ва пешфарз дақиқан ҳамон тавре ки ҳаст, истифода мешавад."
