msgid "Zinn Cache"
msgstr "Zinn Cache"

msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

msgid "Server-side cache control for the LiteSpeed (LSCache) full-page cache — with smart auto-purge on content change, a Redis object-cache toggle, and safe WordPress/WooCommerce cache exclusions. Part of the Zinn Digital hosting-platform deploy footprint."
msgstr "Ìdarí ìpamọ́-ẹ̀gbẹ́-sáfà fún ìpamọ́ ojú-ìwé-kíkún ti LiteSpeed (LSCache) — pẹ̀lú ìsọ-di-mímọ́ aládàáṣe olóye nígbà tí àkóónú bá yí padà, ìtàn ìpamọ́-nǹkan Redis, àti àwọn ìyọkúrò ìpamọ́ ààbò fún WordPress/WooCommerce. Ẹ̀yà kan nínú ìtẹ̀síwájú ìṣàmúlò ti pẹpẹ-ìgbàlejò Zinn Digital."

msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

msgid "You are not allowed to purge the cache."
msgstr "A kò gbà ọ́ láàyè láti sọ ìpamọ́ di mímọ́."

msgid "Cache purge requested."
msgstr "A ti béèrè fún sísọ ìpamọ́ di mímọ́."

msgid "Zinn Cache: another object-cache drop-in is installed, so the Redis object cache is not managed by this plugin."
msgstr "Zinn Cache: drop-in ìpamọ́-nǹkan mìíràn ti wà tẹ́lẹ̀, nítorí náà ọ̀gbọ́n-ẹ̀rọ yìí kò ṣàkóso ìpamọ́-nǹkan Redis."

msgid "Full-page cache (LiteSpeed)"
msgstr "Ìpamọ́ ojú-ìwé-kíkún (LiteSpeed)"

msgid "Enable LSCache control"
msgstr "Mú ìdarí LSCache ṣíṣẹ́"

msgid "Send LiteSpeed cache-control and tag headers on cacheable pages."
msgstr "Fi àwọn àkọlé cache-control àti tag LiteSpeed ránṣẹ́ sórí àwọn ojú-ìwé tí a lè pamọ́."

msgid "Public cache lifetime (seconds)"
msgstr "Àkókò-ayé ìpamọ́ àwùjọ (ìṣẹ́jú-àáyá)"

msgid "Object cache (Redis)"
msgstr "Ìpamọ́-nǹkan (Redis)"

msgid "Enable Redis object cache"
msgstr "Mú ìpamọ́-nǹkan Redis ṣíṣẹ́"

msgid "Install the Redis object-cache drop-in (requires the phpredis extension)."
msgstr "Fi drop-in ìpamọ́-nǹkan Redis sí ẹ̀rọ (ó nílò ẹ̀yà-àfikún phpredis)."

msgid "Redis host"
msgstr "Olùgbàlejò Redis"

msgid "Redis port"
msgstr "Èbúté Redis"

msgid "Redis database"
msgstr "Àkójọ-ìsọfúnni Redis"

msgid "Redis key prefix"
msgstr "Àdàkọ-ìṣáájú kọ́kọ́rọ́ Redis"

msgid "Automatic purging"
msgstr "Sísọ-di-mímọ́ aládàáṣe"

msgid "Smart auto-purge"
msgstr "Ìsọ-di-mímọ́ aládàáṣe olóye"

msgid "Purge affected pages automatically when content changes."
msgstr "Sọ àwọn ojú-ìwé tí ó kàn di mímọ́ láìfọ̀wọ́kàn nígbà tí àkóónú bá yí padà."

msgid "Purge on updates"
msgstr "Sọ di mímọ́ nígbà ìmúdójúìwọ̀n"

msgid "Purge everything after core, plugin, or theme updates."
msgstr "Sọ ohun gbogbo di mímọ́ lẹ́yìn ìmúdójúìwọ̀n mọ́jú-ẹ̀rọ, ọ̀gbọ́n-ẹ̀rọ, tàbí àwòṣe."

msgid "Cache exclusions"
msgstr "Àwọn ìyọkúrò ìpamọ́"

msgid "Sensible WordPress and WooCommerce defaults are always applied (cart, checkout, my-account, logged-in and session pages are never cached). Add extra rules below, one per line."
msgstr "A máa ń lo àwọn ìtòsí WordPress àti WooCommerce tí ó bọ́gbọ́nmu nígbà gbogbo (a kì í pa kẹ̀kẹ́-ẹrù, ìsanwó, àkántì-mi, àti àwọn ojú-ìwé olùwọlé-inú àti ìpàdé mọ́ láéláé). Fi àwọn òfin àfikún sí ìsàlẹ̀, ọ̀kan sí ìlà kọ̀ọ̀kan."

msgid "Exclude URL paths (prefix match)"
msgstr "Yọ àwọn ọ̀nà URL kúrò (ìbámu àdàkọ-ìṣáájú)"

msgid "Exclude query keys"
msgstr "Yọ àwọn kọ́kọ́rọ́ ìbéèrè kúrò"

msgid "Exclude cookie name prefixes"
msgstr "Yọ àwọn àdàkọ-ìṣáájú orúkọ kúkì kúrò"

msgid "Maintenance"
msgstr "Ìtọ́jú"

msgid "Purge everything now"
msgstr "Sọ ohun gbogbo di mímọ́ báyìí"

msgid "detected"
msgstr "a rí i"

msgid "not detected"
msgstr "a kò rí i"

msgid "phpredis extension missing"
msgstr "ẹ̀yà-àfikún phpredis kò sí"

msgid "active"
msgstr "ń ṣiṣẹ́"

msgid "inactive"
msgstr "kò ń ṣiṣẹ́"

msgid "LiteSpeed cache:"
msgstr "Ìpamọ́ LiteSpeed:"

msgid "Redis object cache:"
msgstr "Ìpamọ́-nǹkan Redis:"

msgid "The Redis PHP extension (phpredis) is not available on this server, so the object cache cannot be enabled."
msgstr "Ẹ̀yà-àfikún PHP Redis (phpredis) kò sí lórí ẹ̀rọ-ìsìn yìí, nítorí náà a kò lè mú ìpamọ́-nǹkan ṣíṣẹ́."

msgid "Another object-cache drop-in is already installed. Remove it before enabling the Zinn object cache."
msgstr "Drop-in ìpamọ́-nǹkan mìíràn ti wà tẹ́lẹ̀. Yọ ọ́ kúrò kí o tó mú ìpamọ́-nǹkan Zinn ṣíṣẹ́."

msgid "Could not write the Redis connection configuration file."
msgstr "A kò lè kọ fáìlì ìṣètò ìsopọ̀ Redis."

msgid "The bundled object-cache drop-in could not be read."
msgstr "A kò lè ka drop-in ìpamọ́-nǹkan tí a dì pọ̀."

msgid "Could not install the object-cache drop-in into wp-content."
msgstr "A kò lè fi drop-in ìpamọ́-nǹkan sí inú wp-content."

msgid "Could not remove the object-cache drop-in."
msgstr "A kò lè yọ drop-in ìpamọ́-nǹkan kúrò."

msgid "The WordPress filesystem is not writable, so the object-cache drop-in could not be managed."
msgstr "A kò lè kọ sínú ètò-fáìlì WordPress, nítorí náà a kò lè ṣàkóso drop-in ìpamọ́-nǹkan."

msgid "See the Zinn Digital release notes."
msgstr "Wo àwọn àkọsílẹ̀ ìtújáde Zinn Digital."

msgid "The downloaded update failed its integrity check and was not installed."
msgstr "Ìmúdójúìwọ̀n tí a gbà sílẹ̀ kùnà àyẹ̀wò ìdúróṣinṣin rẹ̀, a kò sì fi sórí ẹ̀rọ."
