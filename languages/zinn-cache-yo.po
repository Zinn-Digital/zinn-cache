msgstr "wp-config.php ti ṣalaye WP_CACHE tẹlẹ gẹgẹ bi eke, nitorina kaṣe oju-iwe ko le bẹrẹ. Yipada si otitọ."

#: includes/class-wp-config.php:79
msgid "wp-config.php is not writable, so WP_CACHE could not be turned on. Add define( 'WP_CACHE', true ); to it."
msgstr "A kò lè kọ si wp-config.php, nitorina a kò le tan WP_CACHE. Fi define( 'WP_CACHE', true ); kun un."

